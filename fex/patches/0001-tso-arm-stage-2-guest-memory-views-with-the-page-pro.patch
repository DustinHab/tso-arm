+// SPDX-License-Identifier: MIT
+// tso-arm: guest memory as shared memory, mapped again in an ordered view and in one plain view per thread, with a
+// page protocol that leaves accesses to memory only one thread uses unordered.
+// Layout and switches: FEXCore/include/FEXCore/Core/TSOViews.h
+#pragma once
+#include <FEXCore/Core/TSOViews.h>
+
+#include <cstdint>
+#include <map>
+#include <mutex>
+#include <string>
+#include <sys/types.h>
+#include <utility>
+#include <vector>
+
+namespace FEXCore::Core {
+struct InternalThreadState;
+}
+namespace FEXCore::Context {
+class Context;
+}
+
+namespace FEX::HLE {
+// If Insn (read from the signal context's pc) is a boundary trap, sends the thread back to the dispatcher at the
+// trapped instruction start and returns true (SyscallsSMCTracking.cpp)
+bool TSOTryBoundaryExit(FEXCore::Core::InternalThreadState* Thread, void* ucontext, uint32_t Insn);
+
+class TSOViewMemory {
+public:
+  // nullptr if views are off or could not be set up
+  static TSOViewMemory* Get();
+
+  // Guest memory management for a 64-bit guest. 'Slot' is the calling thread's view slot (0: no thread yet).
+  // Non-fixed mappings are placed in the window; private memory is backed by shared memory and mapped into every
+  // view. Return the address / 0 or -errno.
+  int64_t Mmap(uint64_t Addr, uint64_t Length, int Prot, int Flags, int Fd, off_t Offset, int Slot);
+  int64_t Munmap(uint64_t Addr, uint64_t Length);
+  int64_t Mprotect(uint64_t Addr, uint64_t Length, int Prot);
+  int64_t Mremap(uint64_t Old, uint64_t OldSize, uint64_t NewSize, int Flags, uint64_t New, int Slot);
+  // MADV_DONTNEED and MADV_FREE on memory that is private for the guest: shared memory keeps its contents under
+  // MADV_DONTNEED, so the pages are removed instead (they read as zero afterwards, as private memory would)
+  int64_t Madvise(uint64_t Addr, uint64_t Length, int Advice);
+
+  // A new thread's plain view; 0 if no slot is free. The pages of the mapping that holds StackPointer move to it.
+  uint64_t AttachThread(uint64_t StackPointer);
+  void DetachThread(uint64_t Base);
+  // Gives the private pages of the mapping that holds StackPointer to the thread with the plain view at Base
+  void HandOffStack(uint64_t Base, uint64_t StackPointer);
+
+  enum class Fault { NotOurs, Retry, Escalate };
+  // A fault at a view address: applies the page transition. Retry: the access is allowed now. Escalate: a plain
+  // access to memory another thread writes; the instruction has to be translated ordered.
+  Fault HandleFault(uint64_t FaultAddress, bool Write, int Slot);
+
+  uint64_t Transitions() const {
+    return Stats.Transitions;
+  }
+  // Counters to stderr if TSO_VIEWS_STATS is set, and the profile written; called on exit_group, which leaves
+  // without atexit handlers
+  static void ExitStats();
+
+  // Profile of the program: the escalated code ranges and whether it fell back, kept between runs
+  // (TSO_VIEWS_PROFILE: a file, or "none"; default ~/.cache/tso-arm/<program>-<hash of path, size, mtime>).
+  // Loading it only saves work: an escalation too many costs ordering, a missing one is learned again.
+  void LoadProfile(FEXCore::Context::Context* CTX);
+  void NoteEscalation(uint64_t Start, uint64_t End);
+  // Logs a failed memory call (TSO_VIEWS_LOG) and passes the result through
+  static int64_t Result(const char* What, int64_t R);
+  // Performs the faulting load or store Insn at the signal context's pc, ordered, and steps over it
+  // (TSOAccess.cpp). False if the instruction is not one it knows.
+  static bool EmulateAccess(void* ucontext, uint32_t Insn);
+  // Counts an access completed in the handler (true) or an instruction repeated as a single-instruction block
+  static void NoteAccess(bool Emulated);
+  // Counts a thread sent back to the dispatcher from a trapped instruction start
+  static void NoteBoundaryExit();
+
+private:
+  enum class Kind : uint8_t { Private, SharedAnon, SharedFile };
+  struct Range {
+    uint64_t End;
+    int Prot;
+    Kind K;
+  };
+
+  bool Init();
+  uint64_t ChooseAddress(uint64_t Hint, uint64_t Length) const;
+  bool IsFree(uint64_t Addr, uint64_t Length) const;
+  const Range* Find(uint64_t Addr, uint64_t* Start = nullptr) const;
+  void Insert(uint64_t Addr, uint64_t End, int Prot, Kind K);
+  void Erase(uint64_t Addr, uint64_t End);
+
+  // Page states
+  void SetState(uint64_t Addr, uint64_t End, uint8_t State);
+  // Protection of a page in the plain or ordered view of a slot
+  int ViewProt(uint8_t State, uint16_t Mask, int Slot, bool Ordered, int GuestProt) const;
+  // Recomputes the protection of [Addr, End) in every view from the page states (runs of equal protection)
+  void Apply(uint64_t Addr, uint64_t End);
+  // One page changed from (OldState, OldMask) to the current state: take rights away in every view at once, give
+  // new ones to the faulting slot only (the others get them by their own fault)
+  void ApplyPage(uint64_t Page, uint8_t OldState, uint16_t OldMask, int GuestProt, int FaultSlot);
+  void AliasNone(uint64_t Addr, uint64_t Length, uint64_t Base);
+  void AliasAll(uint64_t Addr, uint64_t Length);
+  void ReserveEverywhere(uint64_t Addr, uint64_t Length);
+  static void Reserve(uint64_t Base, uint64_t Length);
+  static uint64_t ViewBase(int Slot, bool Ordered);
+
+  std::recursive_mutex Mutex;
+  std::map<uint64_t, Range> Ranges; // guest mappings by start address, split where the protection differs
+  bool SlotUsed[FEXCore::TSOViews::Slots] {};
+  bool SlotUsable[FEXCore::TSOViews::Slots] {};
+  bool AnyAttached {};
+  // Migratory ownership: false if the page changed hands quickly three times in a row (it is really shared)
+  bool MayMigrate(uint64_t Page);
+  uint32_t* LastChange {}; // per page: microseconds from the start to its last change of hands
+  uint8_t* Quick {};       // per page: quick changes of hands in a row
+  bool MigrateOn {false};  // TSO_VIEWS_MIGRATE=1: on
+  uint32_t QuickUs {1000}; // TSO_VIEWS_QUICK: a change of hands within this many microseconds counts as quick
+  uint8_t QuickAllowed {2}; // TSO_VIEWS_STRIKES: quick changes of hands in a row that still migrate
+
+  // Moves the pages of a chunk that are in state From to To (with its read mask), all views at once
+  void CollapseChunk(uint64_t Chunk, uint8_t From, uint8_t To, uint16_t ToMask);
+  // Process-wide fallback to full ordering (FEXCore::TSOViews::FallbackActive), under Mutex
+  void EnterFallback(uint64_t Elapsed, bool DropCode = true);
+  void SaveProfile();
+  std::string ProfilePath;
+  std::vector<std::pair<uint64_t, uint64_t>> Escalations; // recorded and loaded, for the profile
+  bool ProfileLoaded {};
+  bool ProfileChanged {};
+  uint64_t FaultsSeen {};
+  uint64_t StartNs {};
+  uint64_t WindowFaults {};
+  uint64_t WindowStartNs {};
+  uint64_t WarmupNs {300'000'000ULL}; // TSO_VIEWS_WARMUP (ms): no fallback before
+  uint64_t WindowSize {1000};         // TSO_VIEWS_WINDOW: faults per rate measurement
+  uint64_t Budget {};
+  std::atomic<bool> FallbackRequest {false};
+
+public:
+  // True once after the fallback started: the caller then throws away all translated code
+  bool TakeFallbackRequest();
+
+private:
+  static constexpr uint64_t ChunkShift = 21; // 2 MB
+  static constexpr uint8_t CollapseAfter = 4; // private pages shared in a chunk before the rest follows
+
+  uint8_t* Owner {};    // page states, one byte per guest page
+  uint8_t* ChunkShares {}; // per chunk: private pages shared since the last collapse (nullptr: no chunks)
+  uint16_t* ROMask {};  // per page: slots whose plain view maps the shared read-only page
+  struct {
+    uint64_t Transitions {};
+  } Stats;
+};
+} // namespace FEX::HLE
