new file mode 100644
index 0000000..277cd3f
--- /dev/null
+++ b/Source/Tools/LinuxEmulation/LinuxSyscalls/TSOAccess.cpp
@@ -0,0 +1,422 @@
+// SPDX-License-Identifier: MIT
+// tso-arm: completes a load or store of translated code that faulted on a view, ordered, in the fault handler.
+//
+// A plain access that meets memory another thread writes cannot simply be repeated: the guest instruction may have
+// changed registers or flags before the access (the carry flag is even kept inverted inside a block), so starting
+// it again from the guest state is not exact. Instead the handler performs this one host access itself, with full
+// barriers on both sides, on the identity mapping of guest memory, and the thread continues after it. The guest
+// instruction is translated ordered from its next execution on.
+#include "LinuxSyscalls/TSOViews.h"
+#include "ArchHelpers/MContext.h"
+
+#include <FEXCore/Core/TSOViews.h>
+
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+
+namespace FEX::HLE {
+namespace {
+  struct Machine {
+    uint64_t* X;     // x0..x30
+    uint64_t* SP;
+    __uint128_t* V;  // v0..v31
+  };
+
+  uint64_t GetX(const Machine& M, uint32_t N, bool SPForm) {
+    if (N == 31) {
+      return SPForm ? *M.SP : 0;
+    }
+    return M.X[N];
+  }
+
+  void SetX(const Machine& M, uint32_t N, uint64_t Value, bool SPForm) {
+    if (N == 31) {
+      if (SPForm) {
+        *M.SP = Value;
+      }
+      return;
+    }
+    M.X[N] = Value;
+  }
+
+  // Guest address behind a view address (the views are aligned to the window size)
+  uint8_t* Guest(uint64_t ViewAddress) {
+    return reinterpret_cast<uint8_t*>(ViewAddress & (FEXCore::TSOViews::Window - 1));
+  }
+
+  void Fence() {
+    __atomic_thread_fence(__ATOMIC_SEQ_CST);
+  }
+
+  // Memory to bytes and back; aligned accesses of up to 8 bytes stay single accesses
+  void ReadMem(uint64_t Address, void* Out, unsigned Size) {
+    const uint8_t* P = Guest(Address);
+    switch (Size) {
+    case 1: *static_cast<uint8_t*>(Out) = *reinterpret_cast<const volatile uint8_t*>(P); break;
+    case 2: {
+      uint16_t V;
+      memcpy(&V, P, 2);
+      memcpy(Out, &V, 2);
+      break;
+    }
+    case 4: {
+      uint32_t V;
+      memcpy(&V, P, 4);
+      memcpy(Out, &V, 4);
+      break;
+    }
+    case 8: {
+      uint64_t V;
+      memcpy(&V, P, 8);
+      memcpy(Out, &V, 8);
+      break;
+    }
+    default: memcpy(Out, P, Size); break;
+    }
+  }
+
+  void WriteMem(uint64_t Address, const void* In, unsigned Size) {
+    uint8_t* P = Guest(Address);
+    switch (Size) {
+    case 1: *reinterpret_cast<volatile uint8_t*>(P) = *static_cast<const uint8_t*>(In); break;
+    case 2: {
+      uint16_t V;
+      memcpy(&V, In, 2);
+      memcpy(P, &V, 2);
+      break;
+    }
+    case 4: {
+      uint32_t V;
+      memcpy(&V, In, 4);
+      memcpy(P, &V, 4);
+      break;
+    }
+    case 8: {
+      uint64_t V;
+      memcpy(&V, In, 8);
+      memcpy(P, &V, 8);
+      break;
+    }
+    default: memcpy(P, In, Size); break;
+    }
+  }
+
+  uint64_t SignExtend(uint64_t V, unsigned Bits) {
+    const uint64_t M = 1ULL << (Bits - 1);
+    V &= (Bits == 64) ? ~0ULL : ((1ULL << Bits) - 1);
+    return (V ^ M) - M;
+  }
+
+  // One general purpose register access. Kind: 0 store, 1 load zero-extended, 2 load sign-extended to 64 bits,
+  // 3 load sign-extended to 32 bits.
+  void GPRAccess(const Machine& M, uint32_t Rt, uint64_t Address, unsigned Size, unsigned Kind) {
+    if (Kind == 0) {
+      const uint64_t V = GetX(M, Rt, false);
+      WriteMem(Address, &V, Size);
+      return;
+    }
+    uint64_t V = 0;
+    ReadMem(Address, &V, Size);
+    if (Kind == 2) {
+      V = SignExtend(V, Size * 8);
+    } else if (Kind == 3) {
+      V = SignExtend(V, Size * 8) & 0xFFFF'FFFFULL;
+    }
+    SetX(M, Rt, V, false);
+  }
+
+  void FPRAccess(const Machine& M, uint32_t Rt, uint64_t Address, unsigned Size, bool Load) {
+    if (!Load) {
+      const __uint128_t V = M.V[Rt];
+      WriteMem(Address, &V, Size);
+      return;
+    }
+    __uint128_t V = 0;
+    ReadMem(Address, &V, Size);
+    M.V[Rt] = V; // a scalar load clears the rest of the register
+  }
+
+  // Single structure LD1/ST1 to one lane, and LD1R
+  bool LaneAccess(const Machine& M, uint32_t Insn, uint64_t Address, unsigned* Bytes) {
+    const uint32_t Rt = Insn & 31;
+    const bool Q = (Insn >> 30) & 1;
+    const bool L = (Insn >> 22) & 1;
+    const uint32_t Opcode = (Insn >> 13) & 7;
+    const uint32_t S = (Insn >> 12) & 1;
+    const uint32_t Size = (Insn >> 10) & 3;
+    unsigned ESize;
+    unsigned Index;
+    switch (Opcode) {
+    case 0: ESize = 1; Index = (Q << 3) | (S << 2) | Size; break;
+    case 2:
+      if (Size & 1) {
+        return false;
+      }
+      ESize = 2;
+      Index = (Q << 2) | (S << 1) | (Size >> 1);
+      break;
+    case 4:
+      if (Size == 0) {
+        ESize = 4;
+        Index = (Q << 1) | S;
+      } else if (Size == 1 && S == 0) {
+        ESize = 8;
+        Index = Q;
+      } else {
+        return false;
+      }
+      break;
+    case 6: {
+      // LD1R: one element to every lane
+      if (!L || S) {
+        return false;
+      }
+      ESize = 1U << Size;
+      uint64_t E = 0;
+      ReadMem(Address, &E, ESize);
+      uint8_t Out[16] {};
+      const unsigned Total = Q ? 16 : 8;
+      for (unsigned i = 0; i < Total; i += ESize) {
+        memcpy(Out + i, &E, ESize);
+      }
+      memcpy(&M.V[Rt], Out, 16);
+      *Bytes = ESize;
+      return true;
+    }
+    default: return false;
+    }
+    uint8_t Reg[16];
+    memcpy(Reg, &M.V[Rt], 16);
+    if (L) {
+      ReadMem(Address, Reg + Index * ESize, ESize);
+      memcpy(&M.V[Rt], Reg, 16);
+    } else {
+      WriteMem(Address, Reg + Index * ESize, ESize);
+    }
+    *Bytes = ESize;
+    return true;
+  }
+
+  // Decodes and performs the access. Returns false for instructions this does not know.
+  bool Perform(const Machine& M, uint32_t Insn) {
+    const uint32_t Rt = Insn & 31;
+    const uint32_t Rn = (Insn >> 5) & 31;
+    const uint32_t SizeBits = Insn >> 30;
+    const bool V = (Insn >> 26) & 1;
+
+    // Load/store register, unsigned immediate offset
+    if ((Insn & 0x3B000000) == 0x39000000) {
+      const uint32_t Opc = (Insn >> 22) & 3;
+      const uint64_t Imm12 = (Insn >> 10) & 0xFFF;
+      const uint64_t Base = GetX(M, Rn, true);
+      if (V) {
+        const unsigned Size = (Opc & 2) ? 16 : (1U << SizeBits);
+        if ((Opc & 2) && SizeBits != 0) {
+          return false;
+        }
+        FPRAccess(M, Rt, Base + Imm12 * Size, Size, Opc & 1);
+      } else {
+        if (SizeBits == 3 && Opc == 2) {
+          return true; // PRFM
+        }
+        const unsigned Size = 1U << SizeBits;
+        GPRAccess(M, Rt, Base + Imm12 * Size, Size, Opc);
+      }
+      return true;
+    }
+
+    // Load/store register: unscaled, pre-index, post-index (bit 21 clear) and register offset
+    if ((Insn & 0x3B000000) == 0x38000000) {
+      const uint32_t Opc = (Insn >> 22) & 3;
+      const uint32_t Mode = (Insn >> 10) & 3;
+      const uint64_t Base = GetX(M, Rn, true);
+      uint64_t Address;
+      bool WriteBack = false;
+      uint64_t NewBase = 0;
+      unsigned Size = V ? ((Opc & 2) ? 16 : (1U << SizeBits)) : (1U << SizeBits);
+      if (((Insn >> 21) & 1) == 0) {
+        const int64_t Imm9 = int64_t(SignExtend((Insn >> 12) & 0x1FF, 9));
+        switch (Mode) {
+        case 0: Address = Base + Imm9; break;
+        case 1:
+          Address = Base;
+          WriteBack = true;
+          NewBase = Base + Imm9;
+          break;
+        case 3:
+          Address = Base + Imm9;
+          WriteBack = true;
+          NewBase = Address;
+          break;
+        default: return false; // unprivileged forms
+        }
+      } else if (Mode == 2) {
+        const uint32_t Rm = (Insn >> 16) & 31;
+        const uint32_t Option = (Insn >> 13) & 7;
+        const bool S = (Insn >> 12) & 1;
+        uint64_t Offset = GetX(M, Rm, false);
+        switch (Option) {
+        case 2: Offset &= 0xFFFF'FFFFULL; break;                // UXTW
+        case 3: break;                                          // LSL / UXTX
+        case 6: Offset = SignExtend(Offset, 32); break;         // SXTW
+        case 7: break;                                          // SXTX
+        default: return false;
+        }
+        unsigned Shift = 0;
+        if (S) {
+          Shift = V && (Opc & 2) ? 4 : SizeBits;
+        }
+        Address = Base + (Offset << Shift);
+      } else {
+        return false; // atomic memory operations and the like
+      }
+      if (V) {
+        if ((Opc & 2) && SizeBits != 0) {
+          return false;
+        }
+        FPRAccess(M, Rt, Address, Size, Opc & 1);
+      } else {
+        if (SizeBits == 3 && Opc == 2) {
+          return true; // PRFM
+        }
+        GPRAccess(M, Rt, Address, Size, Opc);
+      }
+      if (WriteBack) {
+        SetX(M, Rn, NewBase, true);
+      }
+      return true;
+    }
+
+    // Load/store pair: no-allocate, post-index, signed offset, pre-index
+    if ((Insn & 0x3A000000) == 0x28000000) {
+      const uint32_t Opc = SizeBits;
+      const uint32_t Index = (Insn >> 23) & 3;
+      const bool Load = (Insn >> 22) & 1;
+      const uint32_t Rt2 = (Insn >> 10) & 31;
+      const int64_t Imm7 = int64_t(SignExtend((Insn >> 15) & 0x7F, 7));
+      unsigned Size;
+      bool SignedWord = false;
+      if (V) {
+        if (Opc == 3) {
+          return false;
+        }
+        Size = 4U << Opc;
+      } else {
+        if (Opc == 1) {
+          if (!Load) {
+            return false; // STGP
+          }
+          SignedWord = true;
+          Size = 4;
+        } else if (Opc == 3) {
+          return false;
+        } else {
+          Size = Opc == 0 ? 4 : 8;
+        }
+      }
+      const uint64_t Base = GetX(M, Rn, true);
+      const int64_t Offset = Imm7 * int64_t(Size);
+      const uint64_t Address = Index == 1 ? Base : Base + Offset;
+      if (V) {
+        FPRAccess(M, Rt, Address, Size, Load);
+        FPRAccess(M, Rt2, Address + Size, Size, Load);
+      } else {
+        const unsigned Kind = Load ? (SignedWord ? 2 : 1) : 0;
+        if (Load) {
+          // Read both before writing either: the base may be one of the targets
+          uint64_t A = 0, B = 0;
+          ReadMem(Address, &A, Size);
+          ReadMem(Address + Size, &B, Size);
+          if (SignedWord) {
+            A = SignExtend(A, 32);
+            B = SignExtend(B, 32);
+          }
+          SetX(M, Rt, A, false);
+          SetX(M, Rt2, B, false);
+        } else {
+          GPRAccess(M, Rt, Address, Size, Kind);
+          GPRAccess(M, Rt2, Address + Size, Size, Kind);
+        }
+      }
+      if (Index == 1 || Index == 3) {
+        SetX(M, Rn, Base + Offset, true);
+      }
+      return true;
+    }
+
+    // LDAR / STLR
+    if ((Insn & 0x3FBFFC00) == 0x089FFC00) {
+      const bool Load = (Insn >> 22) & 1;
+      GPRAccess(M, Rt, GetX(M, Rn, true), 1U << SizeBits, Load ? 1 : 0);
+      return true;
+    }
+    // LDAPR
+    if ((Insn & 0x3FFFFC00) == 0x38BFC000) {
+      GPRAccess(M, Rt, GetX(M, Rn, true), 1U << SizeBits, 1);
+      return true;
+    }
+    // LDAPUR / STLUR (unscaled offset)
+    if ((Insn & 0x3F200C00) == 0x19000000) {
+      const uint32_t Opc = (Insn >> 22) & 3;
+      const int64_t Imm9 = int64_t(SignExtend((Insn >> 12) & 0x1FF, 9));
+      if (SizeBits == 3 && Opc >= 2) {
+        return false;
+      }
+      GPRAccess(M, Rt, GetX(M, Rn, true) + Imm9, 1U << SizeBits, Opc);
+      return true;
+    }
+
+    // SIMD single structure, one register: no offset, or post-index
+    if ((Insn & 0xBFBF0000) == 0x0D000000 || (Insn & 0xBFA00000) == 0x0D800000) {
+      if ((Insn >> 21) & 1) {
+        return false; // two or more registers
+      }
+      const uint64_t Base = GetX(M, Rn, true);
+      unsigned Bytes = 0;
+      if (!LaneAccess(M, Insn, Base, &Bytes)) {
+        return false;
+      }
+      if ((Insn >> 23) & 1) {
+        const uint32_t Rm = (Insn >> 16) & 31;
+        SetX(M, Rn, Base + (Rm == 31 ? Bytes : GetX(M, Rm, false)), true);
+      }
+      return true;
+    }
+    return false;
+  }
+} // namespace
+
+bool TSOViewMemory::EmulateAccess(void* ucontext, uint32_t Insn) {
+  auto* MC = ArchHelpers::Context::GetMContext(ucontext);
+  const uint64_t PC = MC->pc;
+  const Machine M {reinterpret_cast<uint64_t*>(MC->regs), reinterpret_cast<uint64_t*>(&MC->sp), ArchHelpers::Context::GetArmFPRs(ucontext)};
+  static const bool Log = FEXCore::TSOViews::Knob("TSO_VIEWS_LOG");
+  uint64_t Before[32];
+  if (Log) {
+    memcpy(Before, MC->regs, sizeof(uint64_t) * 31);
+    Before[31] = MC->sp;
+  }
+  Fence();
+  const bool Done = Perform(M, Insn);
+  Fence();
+  if (Log) {
+    fprintf(stderr, "tso-arm:   completed %#010x at pc %#lx:", Insn, (unsigned long)PC);
+    for (int i = 0; i < 31; ++i) {
+      if (MC->regs[i] != Before[i]) {
+        fprintf(stderr, " x%d %#lx -> %#lx", i, (unsigned long)Before[i], (unsigned long)MC->regs[i]);
+      }
+    }
+    if (MC->sp != Before[31]) {
+      fprintf(stderr, " sp changed");
+    }
+    fprintf(stderr, "\n");
+  }
+  if (!Done) {
+    fprintf(stderr, "tso-arm: cannot complete the access of %#010x at pc %#lx\n", Insn, (unsigned long)PC);
+    return false;
+  }
+  MC->pc = PC + 4;
+  return true;
+}
+} // namespace FEX::HLE
