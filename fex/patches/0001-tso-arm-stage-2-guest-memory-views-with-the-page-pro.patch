+bool ContextImpl::AddTSOEscalation(uint64_t Start, uint64_t End) {
+  std::unique_lock lk(TSOEscalatedMutex);
+  if (TSOEscalated.Contains({Start, End})) {
+    return false;
+  }
+  TSOEscalated.Insert({Start, End});
+  return true;
+}
+
+bool ContextImpl::GetCurrentBlockGuestRange(FEXCore::Core::InternalThreadState* Thread, uint64_t HostPC, uint64_t* Start, uint64_t* End) {
+  const uint64_t BlockBegin = Thread->CurrentFrame->State.InlineJITBlockHeader;
+  auto [InlineHeader, InlineTail] = GetFrameBlockInfo(Thread->CurrentFrame);
+  if (!InlineHeader || HostPC < BlockBegin || HostPC >= BlockBegin + InlineTail->Size) {
+    return false;
+  }
+  *Start = InlineTail->RIP;
+  *End = InlineTail->RIP + InlineTail->GuestSize;
+  return true;
+}
+
+bool ContextImpl::TSOTrapBlockBoundaries(FEXCore::Core::InternalThreadState* Thread, uint64_t HostPC) {
+  const auto Frame = Thread->CurrentFrame;
+  const uint64_t BlockBegin = Frame->State.InlineJITBlockHeader;
+  auto [InlineHeader, InlineTail] = GetFrameBlockInfo(Frame);
+  if (!InlineHeader || HostPC < BlockBegin || HostPC >= BlockBegin + InlineTail->Size) {
+    return false;
+  }
+  auto RIPEntry = reinterpret_cast<const uint8_t*>(BlockBegin + InlineHeader->OffsetToBlockTail + InlineTail->OffsetToRIPEntries);
+  const uint64_t CodeBegin = BlockBegin + sizeof(CPU::CPUBackend::JITCodeHeader);
+  const uint64_t CodeEnd = BlockBegin + InlineHeader->OffsetToBlockTail;
+  uint64_t EntryPC = BlockBegin;
+  uint64_t EntryRIP = InlineTail->RIP;
+  uint64_t Low = ~0ULL, High = 0;
+  std::lock_guard lk(TSOTrapMutex);
+  for (uint32_t i = 0; i < InlineTail->NumberOfRIPEntries; ++i) {
+    auto Offset = FEXCore::Utils::vl64pair::Decode(RIPEntry);
+    RIPEntry += Offset.Size;
+    EntryPC += Offset.IntegerARMPC;
+    EntryRIP += Offset.IntegerX86RIP;
+    if (EntryPC < CodeBegin || EntryPC + 4 > CodeEnd || (EntryPC & 3)) {
+      continue;
+    }
+    // The entry points at the first host instruction of a guest instruction (or of a block entry, where the
+    // frame's block header is not set yet: hence the RIP is kept here)
+    TSOTrapRIPs[EntryPC] = EntryRIP;
+    __atomic_store_n(reinterpret_cast<uint32_t*>(EntryPC), TSOViews::BoundaryTrap, __ATOMIC_RELAXED);
+    Low = std::min(Low, EntryPC);
+    High = std::max(High, EntryPC + 4);
+  }
+  if (Low < High) {
+    __builtin___clear_cache(reinterpret_cast<char*>(Low), reinterpret_cast<char*>(High));
+  }
+  return true;
+}
+
+uint64_t ContextImpl::TSOTrapRIP(uint64_t HostPC) {
+  std::lock_guard lk(TSOTrapMutex);
+  auto It = TSOTrapRIPs.find(HostPC);
+  return It == TSOTrapRIPs.end() ? 0 : It->second;
+}
