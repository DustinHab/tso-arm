+
+void Arm64JITCore::EmitOrderedViewAddress(ARMEmitter::Register Dst, ARMEmitter::Register Addr) {
+  // The thread's ordered view: its own private pages and the shared ones are accessible there, other threads'
+  // private pages are not (an access shares them first)
+  add(ARMEmitter::Size::i64Bit, Dst, Addr, REG_VIEW.R());
+  orr(ARMEmitter::Size::i64Bit, Dst, Dst, FEXCore::TSOViews::OrderedBit);
+}
+
+// Views on for this (64-bit) guest: stack and string operations address guest memory through them.
+static bool ViewsOn(const FEXCore::Context::ContextImpl* CTX) {
+  return FEXCore::TSOViews::Enabled() && CTX->Config.Is64BitMode() && !FEXCore::TSOViews::Fallback();
+}
