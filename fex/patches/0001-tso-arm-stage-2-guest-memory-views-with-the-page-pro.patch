new file mode 100644
index 0000000..76be33d
--- /dev/null
+++ b/Source/Tools/LinuxEmulation/LinuxSyscalls/TSOViews.cpp
@@ -0,0 +1,1108 @@
+// SPDX-License-Identifier: MIT
+/*
+$info$
+tags: LinuxSyscalls|syscalls-shared
+desc: tso-arm: guest memory views and the page protocol
+$end_info$
+*/
+
+// Every thread has a plain view (plain accesses) and an ordered view (ordered accesses and atomics).
+// Page states (one byte per guest page in the owner table):
+//   0          nobody's yet: inaccessible in every view, the first thread to touch it gets it
+//   1..15      private to the thread in that slot: read/write in that thread's two views only
+//   SharedRO   read-only in the ordered views, and in the plain views of the threads in ROMask
+//   SharedRW   read/write in the ordered views only
+// Transitions happen in HandleFault, under Mutex, with mprotect of the affected views. An mprotect that takes a
+// page away from a thread completes only after its earlier accesses through the old mapping are complete (TLB
+// invalidation), so the plain stores of the previous owner are visible before anyone else reaches the page.
+// Rights are taken away at once in every view; rights a transition gives to threads other than the faulting one
+// are given lazily, by their own fault on first use.
+
+#include "LinuxSyscalls/TSOViews.h"
+
+#include <FEXCore/Config/Config.h>
+#include <FEXCore/Core/Context.h>
+#include <FEXCore/Utils/LogManager.h>
+#include <sys/stat.h>
+
+#include <algorithm>
+#include <cerrno>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <iterator>
+#include <sys/mman.h>
+#include <unistd.h>
+#include <vector>
+
+namespace FEX::HLE {
+using namespace FEXCore::TSOViews;
+
+namespace {
+  constexpr uint64_t PageShift = 12;
+  constexpr uint64_t PageMask = (1ULL << PageShift) - 1;
+  constexpr uint64_t Pages = Window >> PageShift;
+  uint64_t PageUp(uint64_t X) {
+    return (X + PageMask) & ~PageMask;
+  }
+  uint64_t SlotBase(int Slot) {
+    return uint64_t(Slot) * Window;
+  }
+  uint64_t OrderedViewBase(int Slot) {
+    return SlotBase(Slot) | OrderedBit;
+  }
+  void Protect(uint64_t Addr, uint64_t Length, int Prot) {
+    if (::mprotect(reinterpret_cast<void*>(Addr), Length, Prot) != 0) {
+      // A view keeping rights it must lose would break the protocol silently
+      LogMan::Msg::EFmt("tso-arm: mprotect({:#x}, {:#x}, {}) failed: {}", Addr, Length, Prot, strerror(errno));
+      abort();
+    }
+  }
+  bool ReserveAt(uint64_t Base) {
+    auto P = ::mmap(reinterpret_cast<void*>(Base), Window, PROT_NONE, MAP_PRIVATE | MAP_ANONYMOUS | MAP_NORESERVE | MAP_FIXED_NOREPLACE, -1, 0);
+    if (P == reinterpret_cast<void*>(Base)) {
+      return true;
+    }
+    if (P != MAP_FAILED) {
+      ::munmap(P, Window);
+    }
+    return false;
+  }
+  bool IsOwnerSlot(uint8_t S) {
+    return S >= 1 && S < Slots;
+  }
+  constexpr int ReserveFlags = MAP_PRIVATE | MAP_ANONYMOUS | MAP_NORESERVE;
+  // Flags the guest may pass that make no sense for the shared memory behind a private mapping
+  constexpr int DropFlags = MAP_PRIVATE | MAP_SHARED | MAP_SHARED_VALIDATE | MAP_FIXED_NOREPLACE | MAP_GROWSDOWN | MAP_ANONYMOUS;
+
+  thread_local uint64_t LastFault;
+  thread_local int LastFaultCount;
+
+  bool LogOn() {
+    static const bool On = Knob("TSO_VIEWS_LOG");
+    return On;
+  }
+#define VLOG(...)                     \
+  do {                                \
+    if (LogOn()) {                    \
+      fprintf(stderr, __VA_ARGS__);   \
+    }                                 \
+  } while (0)
+
+  struct Counters {
+    uint64_t Claims, Shares, Upgrades, Lazy, Escalations, Stale, Emulated, Repeated, BoundaryExits, Collapsed, Migrations;
+  } Count;
+  bool PrintStats;
+  uint64_t FallbackAt; // nanoseconds from the start to the fallback
+  void DumpStats() {
+    fprintf(stderr,
+            "tso-arm: claims %lu, shares %lu, upgrades %lu, lazy %lu, escalations %lu, stale %lu, completed in the handler %lu, "
+            "repeated %lu, boundary exits %lu, pages moved with their chunk %lu, migrations %lu\n",
+            (unsigned long)Count.Claims, (unsigned long)Count.Shares, (unsigned long)Count.Upgrades, (unsigned long)Count.Lazy,
+            (unsigned long)Count.Escalations, (unsigned long)Count.Stale, (unsigned long)Count.Emulated, (unsigned long)Count.Repeated,
+            (unsigned long)Count.BoundaryExits, (unsigned long)Count.Collapsed, (unsigned long)Count.Migrations);
+    const auto& S = FEXCore::TSOViews::Spent;
+    fprintf(stderr, "tso-arm: handled faults %lu in %.3f s, block compiles %lu in %.3f s (all threads)", (unsigned long)S.Faults,
+            S.FaultNs / 1e9, (unsigned long)S.Compiles, S.CompileNs / 1e9);
+    if (FEXCore::TSOViews::FallbackActive.load()) {
+      fprintf(stderr, ", fell back to full ordering after %.3f s", FallbackAt / 1e9);
+    }
+    fprintf(stderr, "\n");
+  }
+} // namespace
+
+TSOViewMemory* TSOViewMemory::Get() {
+  static TSOViewMemory* Instance = []() -> TSOViewMemory* {
+    if (!Enabled()) {
+      return nullptr;
+    }
+    auto M = new TSOViewMemory;
+    if (!M->Init()) {
+      LogMan::Msg::EFmt("tso-arm: views could not be set up");
+      delete M;
+      return nullptr;
+    }
+    return M;
+  }();
+  return Instance;
+}
+
+bool TSOViewMemory::Init() {
+  auto T = ::mmap(nullptr, Pages, PROT_READ | PROT_WRITE, ReserveFlags, -1, 0);
+  if (T == MAP_FAILED) {
+    return false;
+  }
+  Owner = static_cast<uint8_t*>(T);
+  auto M = ::mmap(nullptr, Pages * sizeof(uint16_t), PROT_READ | PROT_WRITE, ReserveFlags, -1, 0);
+  if (M == MAP_FAILED) {
+    return false;
+  }
+  ROMask = static_cast<uint16_t*>(M);
+  auto L = ::mmap(nullptr, Pages * sizeof(uint32_t), PROT_READ | PROT_WRITE, ReserveFlags, -1, 0);
+  auto Q = ::mmap(nullptr, Pages, PROT_READ | PROT_WRITE, ReserveFlags, -1, 0);
+  if (L == MAP_FAILED || Q == MAP_FAILED) {
+    return false;
+  }
+  LastChange = static_cast<uint32_t*>(L);
+  Quick = static_cast<uint8_t*>(Q);
+  // Off by default: on the A76 a change of hands (fault, mprotect in every view under the address space lock)
+  // costs more than the ordered accesses it saves (notes, section 13)
+  MigrateOn = getenv("TSO_VIEWS_MIGRATE") && getenv("TSO_VIEWS_MIGRATE")[0] == '1';
+  if (const char* E = getenv("TSO_VIEWS_QUICK")) {
+    QuickUs = uint32_t(strtoul(E, nullptr, 10));
+  }
+  if (const char* E = getenv("TSO_VIEWS_STRIKES")) {
+    QuickAllowed = uint8_t(strtoul(E, nullptr, 10));
+  }
+  if (!(getenv("TSO_VIEWS_CHUNK") && getenv("TSO_VIEWS_CHUNK")[0] == '0')) {
+    auto C = ::mmap(nullptr, Window >> ChunkShift, PROT_READ | PROT_WRITE, ReserveFlags, -1, 0);
+    if (C == MAP_FAILED) {
+      return false;
+    }
+    ChunkShares = static_cast<uint8_t*>(C);
+  }
+
+  // A slot needs both its views; the host's own mappings take some of the address space
+  int Usable = 0;
+  for (int S = 1; S < Slots; ++S) {
+    if (!ReserveAt(SlotBase(S))) {
+      continue;
+    }
+    if (!ReserveAt(OrderedViewBase(S))) {
+      ::munmap(reinterpret_cast<void*>(SlotBase(S)), Window);
+      continue;
+    }
+    SlotUsable[S] = true;
+    ++Usable;
+  }
+  if (IdentityBase()) {
+    // Measurement mode: every thread uses slot 0, plain accesses go to guest memory itself
+    if (!ReserveAt(OrderedViewBase(0))) {
+      return false;
+    }
+    SlotUsed[0] = true;
+  }
+  if (Knob("TSO_VIEWS_STATS")) {
+    PrintStats = true;
+    atexit(DumpStats);
+  }
+  StartNs = Nanos();
+  WindowStartNs = StartNs;
+  Budget = 5000;
+  if (const char* B = getenv("TSO_VIEWS_BUDGET")) {
+    Budget = strtoull(B, nullptr, 10);
+  }
+  if (const char* W = getenv("TSO_VIEWS_WARMUP")) {
+    WarmupNs = strtoull(W, nullptr, 10) * 1'000'000ULL; // milliseconds
+  }
+  if (const char* W = getenv("TSO_VIEWS_WINDOW")) {
+    WindowSize = std::max<uint64_t>(strtoull(W, nullptr, 10), 1);
+  }
+
+  LogMan::Msg::IFmt("tso-arm: views on, window {:#x}, ordered views at plain view | {:#x}, {} thread slots{}", Window, OrderedBit,
+                    Usable, Stage1() ? ", stage 1 (no page protocol)" : "");
+  return Usable > 0;
+}
+
+void TSOViewMemory::NoteAccess(bool Emulated) {
+  __atomic_fetch_add(Emulated ? &Count.Emulated : &Count.Repeated, 1, __ATOMIC_RELAXED);
+}
+
+void TSOViewMemory::NoteBoundaryExit() {
+  __atomic_fetch_add(&Count.BoundaryExits, 1, __ATOMIC_RELAXED);
+}
+
+int64_t TSOViewMemory::Result(const char* What, int64_t R) {
+  if (R < 0 && R > -4096) {
+    VLOG("tso-arm: %s failed: %s\n", What, strerror(int(-R)));
+  }
+  return R;
+}
+
+void TSOViewMemory::ExitStats() {
+  if (PrintStats) {
+    PrintStats = false;
+    DumpStats();
+  }
+  if (auto* M = Get()) {
+    M->SaveProfile();
+  }
+}
