+// tso-arm: guest address -> plain view (+ REG_VIEW) or ordered view (+ REG_VIEW, | OrderedBit)
+DEF_OP(ViewPlain) {
+  const auto Op = IROp->C<IR::IROp_ViewPlain>();
+  const auto Dst = GetReg(Node);
+  uint64_t Const;
+  if (IsInlineConstant(Op->Addr, &Const)) {
