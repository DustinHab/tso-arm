diff --git a/FEXCore/include/FEXCore/Core/TSOViews.h b/FEXCore/include/FEXCore/Core/TSOViews.h
new file mode 100644
index 0000000..a7ac53a
--- /dev/null
+++ b/FEXCore/include/FEXCore/Core/TSOViews.h
@@ -0,0 +1,103 @@
+// SPDX-License-Identifier: MIT
+// tso-arm: layout of the guest memory views used to elide TSO ordering for memory that only one thread uses.
+//
+// Guest memory lives in [0, Window). Every guest mapping is shared memory and is mapped again, for each thread,
+// - in its plain view at Slot * Window + guest address (plain accesses),
+// - in its ordered view at (Slot * Window | OrderedBit) + guest address (ordered accesses and atomics).
+// Translated code reaches guest memory only through the views; the identity mapping stays for the kernel and the
+// runtime. Since every view base is a multiple of Window, (view address & (Window - 1)) is the guest address.
+#pragma once
+#include <atomic>
+#include <cstdint>
+#include <cstdlib>
+#include <ctime>
+
+namespace FEXCore::TSOViews {
+constexpr uint64_t WindowBits = 34;
+constexpr uint64_t Window = 1ULL << WindowBits;  // 16 GB
+constexpr uint64_t AllocLow = 1ULL << 32;        // non-fixed guest mappings are placed in [4 GB, Window)
+constexpr int Slots = 16;                         // thread slots 1..15 (slot 0 is guest memory itself)
+// A thread's ordered view lies at its plain view base with this bit set: `add` then `orr` form the address
+constexpr uint64_t OrderedBit = uint64_t(Slots) * Window; // 2^38
+static_assert((OrderedBit & (OrderedBit - 1)) == 0, "single bit");
+// Page states, one byte per guest page: 1..15 private to the thread in that slot; 0 nobody yet; shared
+constexpr uint8_t SharedRO = 0xFE;
+constexpr uint8_t SharedRW = 0xFF;
+// `ldrb wzr, [x24]`: written over the instruction starts of a block that must not run on; it faults at the
+// thread's view base (guest address 0), and the handler sends the thread back to the dispatcher from there.
+constexpr uint32_t BoundaryTrap = 0x3940031F;
+
+inline bool Enabled() {
+  static const bool On = [] {
+    const char* E = getenv("TSO_VIEWS");
+    return E && E[0] == '1';
+  }();
+  return On;
+}
+
+// Measurement knobs. TSO_VIEWS_IDENTITY=1: every thread's plain view base is 0 (the identity mapping), so the
+// address arithmetic runs but no view is used. TSO_VIEWS_NOPASS=1: the address rewriting pass is not run.
+inline bool Knob(const char* Name) {
+  const char* E = getenv(Name);
+  return E && E[0] == '1';
+}
+inline bool IdentityBase() {
+  static const bool On = Knob("TSO_VIEWS_IDENTITY");
+  return On;
+}
+inline bool RewritePass() {
+  static const bool On = !Knob("TSO_VIEWS_NOPASS");
+  return On;
+}
+// TSO_VIEWS_STAGE1=1: no page protocol; every access plain or ordered as the TSO configuration says (stage 1)
+inline bool Stage1() {
+  static const bool On = Knob("TSO_VIEWS_STAGE1");
+  return On;
+}
+
+// Process-wide fallback to full ordering: once the protocol costs more than it saves (a program whose memory keeps
+// moving between threads), every page becomes shared read-write and all code is translated anew, ordered and
+// addressing guest memory directly, as without views. Old translations still running keep working through the
+// views until they are left.
+inline std::atomic<bool> FallbackActive {false};
+// One translation sees one state: the flag is read once when it starts (BeginCompile) and Fallback() answers from
+// that for everything compiled then (frontend, passes, backend run on the compiling thread)
+inline thread_local bool FallbackInCompile = false;
+inline void BeginCompile() {
+  FallbackInCompile = FallbackActive.load(std::memory_order_acquire);
+}
+inline bool Fallback() {
+  return FallbackInCompile;
+}
+// TSO_VIEWS_FALLBACK_STACK=plain: in the fallback, stack accesses through RSP stay unordered as in FEX's own full
+// TSO (it treats the stack as private to its thread). Not sound; for measuring what ordering them costs.
+inline bool PlainStackInFallback() {
+  static const bool On = [] {
+    const char* E = getenv("TSO_VIEWS_FALLBACK_STACK");
+    return E && E[0] == 'p';
+  }();
+  return On && Fallback();
+}
+
+// Exact instruction starts (full register write-back, carry in ABI form, no merges across instructions), needed for
+// leaving stale code at any instruction start. TSO_VIEWS_NOEXACT=1 turns them off, for measuring their cost only.
+inline bool ExactStarts() {
+  static const bool On = Enabled() && !Knob("TSO_VIEWS_NOEXACT");
+  return On && !Fallback();
+}
+
+// Time spent on the protocol, for TSO_VIEWS_STATS (nanoseconds, all threads together)
+struct TimeSpent {
+  uint64_t Compiles, CompileNs, Faults, FaultNs;
+};
+inline TimeSpent Spent;
+inline uint64_t Nanos() {
+  timespec T;
+  clock_gettime(CLOCK_MONOTONIC, &T);
+  return uint64_t(T.tv_sec) * 1'000'000'000ULL + uint64_t(T.tv_nsec);
+}
+inline void Account(uint64_t& Count, uint64_t& Ns, uint64_t Start) {
+  __atomic_fetch_add(&Count, 1, __ATOMIC_RELAXED);
+  __atomic_fetch_add(&Ns, Nanos() - Start, __ATOMIC_RELAXED);
+}
+} // namespace FEXCore::TSOViews
