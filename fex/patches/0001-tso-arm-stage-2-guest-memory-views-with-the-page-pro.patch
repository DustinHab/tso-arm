+// SPDX-License-Identifier: MIT
+/*
+$info$
+tags: ir|opts
+desc: tso-arm: routes guest memory accesses through the plain or ordered view of guest memory
+$end_info$
+*/
+
+// Every IR op that addresses guest memory gets its address replaced by the address in a view:
+// - plain accesses use the thread's plain view, whose page protections only allow the thread's own private pages
+//   and shared read-only pages;
+// - ordered accesses (LoadMemTSO, StoreMemTSO, atomics) and every access of an escalated guest instruction use
+//   ViewOrdered: the thread's plain view for its own private pages, the ordered view otherwise. Ops of an escalated
+//   instruction that have no ordered form get barriers on both sides.
+// Push/Pop and MemCpy/MemSet return updated addresses and are handled in the backend and the dispatcher instead.
+
+#include "Interface/Context/Context.h"
+#include "Interface/IR/IREmitter.h"
+#include "Interface/IR/PassManager.h"
+#include "Interface/IR/Passes.h"
+#include "Interface/IR/RegisterAllocationData.h"
+
+#include <FEXCore/Core/TSOViews.h>
+#include <FEXCore/IR/IR.h>
+#include <FEXCore/Utils/Profiler.h>
+#include <FEXCore/fextl/unordered_map.h>
+
+namespace FEXCore::IR {
+namespace {
+  class GuestViewPass final : public FEXCore::IR::Pass {
+  public:
+    explicit GuestViewPass(const Context::ContextImpl* CTX)
+      : CTX {CTX} {}
+    void Run(IREmitter* IREmit) override;
+
+  private:
+    const Context::ContextImpl* CTX;
+  };
+
+  struct ViewSite {
+    int Index; // SSA argument holding the guest address, -1: not a guest memory access
+    bool Ordered;
+  };
+
+  ViewSite SiteOf(IROps Op) {
+    switch (Op) {
+    // plain
+    case OP_LOADMEM: return {IROp_LoadMem::Addr_Index, false};
+    case OP_STOREMEM: return {IROp_StoreMem::Addr_Index, false};
+    case OP_LOADMEMPAIR: return {IROp_LoadMemPair::Addr_Index, false};
+    case OP_STOREMEMPAIR: return {IROp_StoreMemPair::Addr_Index, false};
+    case OP_LOADMEMX87SVEOPTPREDICATE: return {IROp_LoadMemX87SVEOptPredicate::Addr_Index, false};
+    case OP_STOREMEMX87SVEOPTPREDICATE: return {IROp_StoreMemX87SVEOptPredicate::Addr_Index, false};
+    case OP_VLOADVECTORMASKED: return {IROp_VLoadVectorMasked::Addr_Index, false};
+    case OP_VSTOREVECTORMASKED: return {IROp_VStoreVectorMasked::Addr_Index, false};
+    case OP_VLOADVECTORGATHERMASKED: return {IROp_VLoadVectorGatherMasked::AddrBase_Index, false};
+    case OP_VLOADVECTORGATHERMASKEDQPS: return {IROp_VLoadVectorGatherMaskedQPS::AddrBase_Index, false};
+    case OP_VLOADVECTORELEMENT: return {IROp_VLoadVectorElement::Addr_Index, false};
+    case OP_VSTOREVECTORELEMENT: return {IROp_VStoreVectorElement::Addr_Index, false};
+    case OP_VBROADCASTFROMMEM: return {IROp_VBroadcastFromMem::Address_Index, false};
+    case OP_VSTORENONTEMPORAL: return {IROp_VStoreNonTemporal::Addr_Index, false};
+    case OP_VSTORENONTEMPORALPAIR: return {IROp_VStoreNonTemporalPair::Addr_Index, false};
+    case OP_VLOADNONTEMPORAL: return {IROp_VLoadNonTemporal::Addr_Index, false};
+    case OP_STORESTACKMEM: return {IROp_StoreStackMem::Addr_Index, false};
+    // ordered
+    case OP_LOADMEMTSO: return {IROp_LoadMemTSO::Addr_Index, true};
+    case OP_STOREMEMTSO: return {IROp_StoreMemTSO::Addr_Index, true};
+    case OP_CAS: return {IROp_CAS::Addr_Index, true};
+    case OP_CASPAIR: return {IROp_CASPair::Addr_Index, true};
+    case OP_ATOMICSWAP: return {IROp_AtomicSwap::Addr_Index, true};
+    case OP_ATOMICFETCHADD: return {IROp_AtomicFetchAdd::Addr_Index, true};
+    case OP_ATOMICFETCHSUB: return {IROp_AtomicFetchSub::Addr_Index, true};
+    case OP_ATOMICFETCHAND: return {IROp_AtomicFetchAnd::Addr_Index, true};
+    case OP_ATOMICFETCHCLR: return {IROp_AtomicFetchCLR::Addr_Index, true};
+    case OP_ATOMICFETCHOR: return {IROp_AtomicFetchOr::Addr_Index, true};
+    case OP_ATOMICFETCHXOR: return {IROp_AtomicFetchXor::Addr_Index, true};
+    case OP_ATOMICFETCHNEG: return {IROp_AtomicFetchNeg::Addr_Index, true};
+    default: return {-1, false};
+    }
+  }
+
+  void GuestViewPass::Run(IREmitter* IREmit) {
+    FEXCORE_PROFILE_SCOPED("PassManager::GuestView");
+
+    // After the fallback, translated code addresses guest memory directly
+    if (FEXCore::TSOViews::Fallback()) {
+      return;
+    }
+    auto CurrentIR = IREmit->ViewIR();
+    const uint64_t BlockRIP = CurrentIR.GetHeader()->OriginalRIP;
+    const bool Protocol = !FEXCore::TSOViews::Stage1();
+
+    // Within a block, accesses through the same address share one view address. The dispatcher loads a guest
+    // register afresh for every access (a new LoadRegister node each time), so addresses that are plain guest
+    // registers are keyed by the register. A write of the register as itself plus a constant (pointer increments)
+    // keeps the view address and records the distance in Delta; any other write drops it.
+    struct RegView {
+      Ref View;
+      int64_t Delta;
+    };
+    fextl::unordered_map<Ref, Ref> Plain, Ordered;
+    fextl::unordered_map<uint32_t, RegView> RegPlain, RegOrdered;
+
+    auto ConstantOf = [&](OrderedNodeWrapper W, int64_t* C) {
+      const auto Op = CurrentIR.GetOp<IROp_Header>(W);
+      if (Op->Op == OP_INLINECONSTANT) {
+        *C = Op->C<IROp_InlineConstant>()->Constant;
+        return true;
+      }
+      if (Op->Op == OP_CONSTANT) {
+        *C = Op->C<IROp_Constant>()->Constant;
+        return true;
+      }
+      return false;
+    };
+    // Immediate offsets LoadMem/StoreMem can encode (Addressing.cpp: ldur simm9, or ldr unsigned scaled)
+    auto EncodableOffset = [](int64_t Off, OpSize Size) {
+      const int64_t S = OpSizeToSize(Size);
+      return (Off >= -256 && Off <= 255) || (Off > 0 && (Off % S) == 0 && Off / S <= 4095);
+    };
+
+    for (auto [Block, BlockHeader] : CurrentIR.GetBlocks()) {
+      Plain.clear();
+      Ordered.clear();
+      RegPlain.clear();
+      RegOrdered.clear();
+      bool Escalated = false;
+
+      for (auto [CodeNode, IROp] : CurrentIR.GetCode(Block)) {
+        switch (IROp->Op) {
+        case OP_GUESTOPCODE:
+          // Marks the start of a guest instruction with side effects (every instruction that accesses memory)
+          // The offset is relative to the block entry and negative for instructions before it (a loop head in a
+          // multiblock); it is stored in 32 bits
+          Escalated = Protocol && CTX->IsTSOEscalated(BlockRIP + int64_t(int32_t(IROp->C<IROp_GuestOpcode>()->GuestEntryOffset)));
+          continue;
+        case OP_STOREREGISTER: {
+          const PhysicalRegister R(CodeNode);
+          if (R.AsRegClass() != RegClass::GPRFixed) {
+            continue;
+          }
+          // r = r +/- constant (64-bit): the cached views stay valid at a new distance (both views map every
+          // page of the window, so any distance is fine)
+          bool Kept = false;
+          const auto ValOp = CurrentIR.GetOp<IROp_Header>(IROp->Args[0]);
+          int64_t C {};
+          if ((ValOp->Op == OP_ADD || ValOp->Op == OP_SUB) && ValOp->Size == OpSize::i64Bit && ConstantOf(ValOp->Args[1], &C)) {
+            const auto SrcOp = CurrentIR.GetOp<IROp_Header>(ValOp->Args[0]);
+            if (SrcOp->Op == OP_LOADREGISTER && SrcOp->C<IROp_LoadRegister>()->Class == RegClass::GPR &&
+                SrcOp->C<IROp_LoadRegister>()->Reg == R.Reg) {
+              const int64_t D = ValOp->Op == OP_ADD ? C : -C;
+              for (auto* Cache : {&RegPlain, &RegOrdered}) {
+                if (auto It = Cache->find(R.Reg); It != Cache->end()) {
+                  It->second.Delta += D;
+                }
+              }
+              Kept = true;
+            }
+          }
+          if (!Kept) {
+            RegPlain.erase(R.Reg);
+            RegOrdered.erase(R.Reg);
+          }
+          continue;
+        }
+        case OP_PUSH:
+          // The backend forms the view address itself; an escalated instruction gets the ordered form.
+          // (The dispatcher emits loads instead of Pop for escalated instructions.)
+          if (Escalated) {
+            IROp->CW<IROp_Push>()->Ordered = true;
+          }
+          RegPlain.clear();
+          RegOrdered.clear();
+          continue;
+        case OP_POP:
+          RegPlain.clear();
+          RegOrdered.clear();
+          continue;
+        case OP_RMWHANDLE:
+        case OP_PUSHTWO:
+        case OP_POPTWO:
+        case OP_MEMCPY:
+        case OP_MEMSET:
+          RegPlain.clear();
+          RegOrdered.clear();
+          continue;
+        default: break;
+        }
+
+        const auto Site = SiteOf(IROp->Op);
+        if (Site.Index < 0 || IROp->Args[Site.Index].IsInvalid()) {
+          continue;
+        }
+
+        // An escalated instruction orders all its accesses; plain ops get barriers around them
+        const bool Ordered_ = Site.Ordered || Escalated;
+        const bool Fenced = Escalated && !Site.Ordered;
+
+        // LoadMem/StoreMem without an offset carry the view in a flag: the backend addresses [addr, x24] at no cost.
+        if (!Ordered_ && IROp->Op == OP_LOADMEM && IROp->C<IROp_LoadMem>()->Offset.IsInvalid()) {
+          IROp->CW<IROp_LoadMem>()->Viewed = true;
+          continue;
+        }
+        if (!Ordered_ && IROp->Op == OP_STOREMEM && IROp->C<IROp_StoreMem>()->Offset.IsInvalid()) {
+          IROp->CW<IROp_StoreMem>()->Viewed = true;
+          continue;
+        }
+
+        Ref Addr = CurrentIR.GetNode(IROp->Args[Site.Index]);
+        const auto AddrOp = CurrentIR.GetOp<IROp_Header>(Addr);
+        const bool IsReg = AddrOp->Op == OP_LOADREGISTER && AddrOp->C<IROp_LoadRegister>()->Class == RegClass::GPR;
+        const uint32_t RegIdx = IsReg ? AddrOp->C<IROp_LoadRegister>()->Reg : 0;
+
+        Ref View {};
+        if (IsReg) {
+          auto& Cache = Ordered_ ? RegOrdered : RegPlain;
+          if (auto It = Cache.find(RegIdx); It != Cache.end()) {
+            const auto [V, Delta] = It->second;
+            if (Delta == 0) {
+              View = V;
+            } else if (IROp->Op == OP_LOADMEM || IROp->Op == OP_STOREMEM) {
+              // Fold the distance into the immediate offset: [view, #(offset + delta)]
+              const auto OffIdx = IROp->Op == OP_LOADMEM ? IROp_LoadMem::Offset_Index : IROp_StoreMem::Offset_Index;
+              int64_t Off {};
+              if (ConstantOf(IROp->Args[OffIdx], &Off) && EncodableOffset(Off + Delta, IROp->Size)) {
+                IREmit->SetWriteCursorBefore(CodeNode);
+                IREmit->ReplaceNodeArgument(CodeNode, OffIdx, IREmit->_InlineConstant(Off + Delta));
+                View = V;
+              }
+            }
+          }
+        } else {
+          auto& Cache = Ordered_ ? Ordered : Plain;
+          if (auto It = Cache.find(Addr); It != Cache.end()) {
+            View = It->second;
+          } else if ((AddrOp->Op == OP_ADD || AddrOp->Op == OP_ADDSHIFT) && AddrOp->Size == OpSize::i64Bit) {
+            // base + index (scaled) or base + constant, from an x86 address like 0x2cc(%r15,%r8,4) whose displacement
+            // went into the access: the view goes onto the base register, where it is shared within the block, and
+            // the index is added to it as before. The access then costs what it costs without views (instead of
+            // one more addition each time).
+            const auto BaseOp = CurrentIR.GetOp<IROp_Header>(AddrOp->Args[0]);
+            if (BaseOp->Op == OP_LOADREGISTER && BaseOp->C<IROp_LoadRegister>()->Class == RegClass::GPR) {
+              const uint32_t BaseReg = BaseOp->C<IROp_LoadRegister>()->Reg;
+              auto& RegCache = Ordered_ ? RegOrdered : RegPlain;
+              IREmit->SetWriteCursorBefore(CodeNode);
+              Ref BaseView {};
+              if (auto It = RegCache.find(BaseReg); It != RegCache.end() && It->second.Delta == 0) {
+                BaseView = It->second.View;
+              } else {
+                Ref BaseNode = CurrentIR.GetNode(AddrOp->Args[0]);
+                BaseView = Ordered_ ? IREmit->_ViewOrdered(BaseNode) : IREmit->_ViewPlain(BaseNode);
+                RegCache[BaseReg] = {BaseView, 0};
+              }
+              Ref Second = CurrentIR.GetNode(AddrOp->Args[1]);
+              if (AddrOp->Op == OP_ADD) {
+                View = IREmit->_Add(OpSize::i64Bit, BaseView, Second);
+              } else {
+                const auto Shift = AddrOp->C<IROp_AddShift>();
+                View = IREmit->_AddShift(OpSize::i64Bit, BaseView, Second, Shift->Shift, Shift->ShiftAmount);
+              }
+              Cache[Addr] = View;
+            }
+          }
+        }
+        if (!View) {
+          IREmit->SetWriteCursorBefore(CodeNode);
+          View = Ordered_ ? IREmit->_ViewOrdered(Addr) : IREmit->_ViewPlain(Addr);
+          if (IsReg) {
+            (Ordered_ ? RegOrdered : RegPlain)[RegIdx] = {View, 0};
+          } else {
+            (Ordered_ ? Ordered : Plain)[Addr] = View;
+          }
+        }
+        IREmit->ReplaceNodeArgument(CodeNode, Site.Index, View);
+
+        if (Fenced) {
+          IREmit->SetWriteCursorBefore(CodeNode);
+          IREmit->_Fence(FenceType::LoadStore);
+          IREmit->SetWriteCursor(CodeNode);
+          IREmit->_Fence(FenceType::LoadStore);
+        }
+
+        // A register load (or base + index) that only served as this address is dead now; left in place, register
+        // allocation would turn it into a copy
+        if (Addr->GetUses() == 0) {
+          if (IsReg) {
+            IREmit->Remove(Addr);
+          } else if (AddrOp->Op == OP_ADD || AddrOp->Op == OP_ADDSHIFT) {
+            Ref Base = CurrentIR.GetNode(AddrOp->Args[0]);
+            IREmit->Remove(Addr);
+            if (Base->GetUses() == 0 && CurrentIR.GetOp<IROp_Header>(Base)->Op == OP_LOADREGISTER) {
+              IREmit->Remove(Base);
+            }
+          }
+        }
+      }
+    }
+  }
+} // namespace
+
+fextl::unique_ptr<Pass> CreateGuestViewPass(const Context::ContextImpl* CTX) {
+  return fextl::make_unique<GuestViewPass>(CTX);
+}
+} // namespace FEXCore::IR
diff --git a/FEXCore/Source/Interface/IR/Passes/LocalCSE.cpp b/FEXCore/Source/Interface/IR/Passes/LocalCSE.cpp
new file mode 100644
index 0000000..173afb2
--- /dev/null
+++ b/FEXCore/Source/Interface/IR/Passes/LocalCSE.cpp
@@ -0,0 +1,267 @@
+// SPDX-License-Identifier: MIT
+/*
+$info$
+tags: ir|opts
+desc: tso-arm: narrows zero-extended 64-bit arithmetic to 32 bits and shares equal values within a block
+$end_info$
+*/
+
+// Two cleanups FEX's IR leaves to the register allocator, which cannot do them:
+//
+// 1. x86 computes `lea 1(%rdi), %r9d` with a 64-bit address and keeps the low 32 bits; the IR has a 64-bit Add and a
+//    Bfe that zero-extends its low half, which becomes `add x20, x7, #1; mov w9, w20`. On Arm a 32-bit operation
+//    zero-extends its result anyway, and the low half of add, sub, mul, shift left and the logical operations only
+//    depends on the low halves of the inputs: when the 64-bit result has no other use, the operation is done in 32
+//    bits and the Bfe goes (`add w9, w7, #1`).
+// 2. The dispatcher loads a guest register afresh for each instruction and recomputes addresses and constants every
+//    time (`add x20, x11, x4` before each of four stores to neighbouring fields). Within a block, equal pure
+//    operations on equal arguments are computed once; loads of a guest register are shared until it is written
+//    (and a load after a write takes the written value), or until an operation that may change registers in the
+//    context (a syscall, a call into the runtime).
+//
+// TSO_ARM_NONARROW=1 turns the first off; the second is off unless TSO_ARM_CSE=1 (it costs cycles on the
+// workloads measured, notes section 15).
+
+#include "Interface/IR/IREmitter.h"
+#include "Interface/IR/PassManager.h"
+#include "Interface/IR/Passes.h"
+#include "Interface/IR/RegisterAllocationData.h"
+
+#include <FEXCore/IR/IR.h>
+#include <FEXCore/Utils/Profiler.h>
+#include <FEXCore/fextl/map.h>
+#include <FEXCore/fextl/vector.h>
+
+#include <array>
+#include <cstdlib>
+
+namespace FEXCore::IR {
+namespace {
+  bool Knob(const char* Name) {
+    const char* E = getenv(Name);
+    return E && E[0] == '1';
+  }
+
+  class LocalCSE final : public FEXCore::IR::Pass {
+  public:
+    void Run(IREmitter* IREmit) override;
+  };
+
+  using Key = std::array<uint64_t, 10>;
+
+  // Memory and ordering operations change no guest register
+  bool KeepsRegisters(IROps Op) {
+    switch (Op) {
+    case OP_STOREMEM:
+    case OP_STOREMEMTSO:
+    case OP_STOREMEMPAIR:
+    case OP_VSTOREVECTORELEMENT:
+    case OP_VSTORENONTEMPORAL:
+    case OP_VSTORENONTEMPORALPAIR:
+    case OP_VSTOREVECTORMASKED:
+    case OP_FENCE:
+    case OP_GUESTOPCODE:
+    case OP_STORENZCV:
+    case OP_STOREPF:
+    case OP_STOREAF:
+    case OP_CAS:
+    case OP_CASPAIR:
+    case OP_ATOMICSWAP:
+    case OP_ATOMICFETCHADD:
+    case OP_ATOMICFETCHSUB:
+    case OP_ATOMICFETCHAND:
+    case OP_ATOMICFETCHCLR:
+    case OP_ATOMICFETCHOR:
+    case OP_ATOMICFETCHXOR:
+    case OP_ATOMICFETCHNEG: return true;
+    default: return false;
+    }
+  }
+
+  void LocalCSE::Run(IREmitter* IREmit) {
+    FEXCORE_PROFILE_SCOPED("PassManager::LocalCSE");
+    static const bool Narrow = !Knob("TSO_ARM_NONARROW");
+    // Off by default: on xz, pigz and zstd it costs cycles (longer live values, more register pressure).
+    // TSO_ARM_CSE=1: everything; TSO_ARM_CSE=2: address arithmetic only (Add, AddShift, Sub, view addresses), with
+    // register loads shared but not taken from earlier register writes
+    static const int ShareMode = [] {
+      const char* E = getenv("TSO_ARM_CSE");
+      return E ? atoi(E) : 0;
+    }();
+    const bool Share = ShareMode != 0;
+    const bool AddressOnly = ShareMode == 2;
+
+    auto CurrentIR = IREmit->ViewIR();
+
+    auto InlineValue = [&](OrderedNodeWrapper W, uint64_t* V) {
+      const auto Op = CurrentIR.GetOp<IROp_Header>(W);
+      if (Op->Op == OP_INLINECONSTANT) {
+        *V = Op->C<IROp_InlineConstant>()->Constant;
+        return true;
+      }
+      return false;
+    };
+
+    fextl::vector<Ref> Dead;
+    for (auto [Block, BlockHeader] : CurrentIR.GetBlocks()) {
+      // 1. Narrowing
+      if (Narrow) {
+        for (auto [CodeNode, IROp] : CurrentIR.GetCode(Block)) {
+          if (IROp->Op != OP_BFE) {
+            continue;
+          }
+          const auto Bfe = IROp->C<IROp_Bfe>();
+          if (Bfe->Width != 32 || Bfe->lsb != 0) {
+            continue;
+          }
+          Ref Src = CurrentIR.GetNode(Bfe->Src);
+          auto SrcOp = const_cast<IROp_Header*>(CurrentIR.GetOp<IROp_Header>(Src));
+          if (Src->GetUses() != 1 || SrcOp->Size != OpSize::i64Bit) {
+            continue;
+          }
+          uint64_t V {};
+          const bool Arg1Inline = GetArgs(SrcOp->Op) > 1 && InlineValue(SrcOp->Args[1], &V);
+          bool Ok = false;
+          switch (SrcOp->Op) {
+          case OP_ADD:
+          case OP_SUB: Ok = !Arg1Inline || V < (1ULL << 24); break; // immediates that encode the same in 32 bits
+          case OP_ADDSHIFT: Ok = SrcOp->C<IROp_AddShift>()->Shift == ShiftType::LSL; break;
+          case OP_MUL:
+          case OP_AND:
+          case OP_OR:
+          case OP_XOR: Ok = !Arg1Inline; break; // logical immediates are encoded per width
+          case OP_LSHL: Ok = Arg1Inline && V < 32; break;
+          default: break;
+          }
+          if (!Ok) {
+            continue;
+          }
+          SrcOp->Size = OpSize::i32Bit;
+          IREmit->ReplaceUsesWithAfter(CodeNode, Src, CodeNode);
+          Dead.push_back(CodeNode);
+        }
+      }
+
+      // 2. Sharing
+      if (Share) {
+        fextl::map<Key, Ref> Seen;
+        fextl::map<uint32_t, Ref> RegValue; // guest register -> its current value in this block
+        auto ArgKey = [&](OrderedNodeWrapper W, uint64_t* Tag, uint64_t* Val) {
+          uint64_t V;
+          if (InlineValue(W, &V)) {
+            *Tag = 1;
+            *Val = V;
+          } else {
+            *Tag = 2;
+            *Val = reinterpret_cast<uint64_t>(CurrentIR.GetNode(W));
+          }
+        };
+
+        for (auto [CodeNode, IROp] : CurrentIR.GetCode(Block)) {
+          const auto Op = IROp->Op;
+          if (Op == OP_STOREREGISTER) {
+            const PhysicalRegister R(CodeNode);
+            if (R.AsRegClass() == RegClass::GPRFixed) {
+              if (IROp->Size == OpSize::i64Bit && !AddressOnly) {
+                RegValue[R.Reg] = CurrentIR.GetNode(IROp->Args[0]);
+              } else {
+                RegValue.erase(R.Reg);
+              }
+            }
+            continue;
+          }
+          if (Op == OP_LOADREGISTER) {
+            const auto L = IROp->C<IROp_LoadRegister>();
+            if (L->Class != RegClass::GPR || IROp->Size != OpSize::i64Bit) {
+              continue;
+            }
+            if (auto It = RegValue.find(L->Reg); It != RegValue.end()) {
+              IREmit->ReplaceUsesWithAfter(CodeNode, It->second, CodeNode);
+              Dead.push_back(CodeNode);
+            } else {
+              RegValue[L->Reg] = CodeNode;
+            }
+            continue;
+          }
+          if (HasSideEffects(Op) && !KeepsRegisters(Op)) {
+            RegValue.clear();
+            continue;
+          }
+          if (CodeNode->GetUses() == 0) {
+            continue; // dead already (a Bfe narrowed away above)
+          }
+
+          if (AddressOnly && Op != OP_ADD && Op != OP_ADDSHIFT && Op != OP_SUB && Op != OP_VIEWPLAIN && Op != OP_VIEWORDERED) {
+            continue;
+          }
+          Key K {};
+          K[0] = Op;
+          K[1] = uint64_t(IROp->Size);
+          switch (Op) {
+          case OP_CONSTANT: {
+            const auto C = IROp->C<IROp_Constant>();
+            K[2] = C->Constant;
+            K[3] = uint64_t(C->Pad) | (uint64_t(C->MaxBytes) << 8);
+            break;
+          }
+          case OP_ADDSHIFT: {
+            const auto S = IROp->C<IROp_AddShift>();
+            K[2] = uint64_t(S->Shift);
+            K[3] = S->ShiftAmount;
+            ArgKey(IROp->Args[0], &K[4], &K[5]);
+            ArgKey(IROp->Args[1], &K[6], &K[7]);
+            break;
+          }
+          case OP_BFE: {
+            const auto B = IROp->C<IROp_Bfe>();
+            K[2] = B->Width;
+            K[3] = B->lsb;
+            ArgKey(IROp->Args[0], &K[4], &K[5]);
+            break;
+          }
+          case OP_SBFE: {
+            const auto B = IROp->C<IROp_Sbfe>();
+            K[2] = B->Width;
+            K[3] = B->lsb;
+            ArgKey(IROp->Args[0], &K[4], &K[5]);
+            break;
+          }
+          case OP_ADD:
+          case OP_SUB:
+          case OP_AND:
+          case OP_OR:
+          case OP_XOR:
+          case OP_LSHL:
+          case OP_LSHR:
+          case OP_ASHR:
+          case OP_MUL:
+            ArgKey(IROp->Args[0], &K[4], &K[5]);
+            ArgKey(IROp->Args[1], &K[6], &K[7]);
+            break;
+          case OP_NOT:
+          case OP_VIEWPLAIN:
+          case OP_VIEWORDERED: ArgKey(IROp->Args[0], &K[4], &K[5]); break;
+          default: continue;
+          }
+          if (auto It = Seen.find(K); It != Seen.end()) {
+            IREmit->ReplaceUsesWithAfter(CodeNode, It->second, CodeNode);
+            Dead.push_back(CodeNode);
+          } else {
+            Seen[K] = CodeNode;
+          }
+        }
+      }
+    }
+
+    for (Ref N : Dead) {
+      if (N->GetUses() == 0) {
+        IREmit->Remove(N);
+      }
+    }
+  }
+} // namespace
+
+fextl::unique_ptr<Pass> CreateLocalCSEPass() {
+  return fextl::make_unique<LocalCSE>();
+}
+} // namespace FEXCore::IR
