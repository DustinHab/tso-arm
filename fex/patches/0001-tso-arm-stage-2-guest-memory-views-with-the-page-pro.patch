   ThreadStateObject->Thread = CTX->CreateThread(NewThreadState);
   auto Frame = ThreadStateObject->Thread->CurrentFrame;
 
+  // tso-arm: every thread reaches guest memory through its own plain view
+  if (auto* Views = TSOViewMemory::Get()) {
+    Frame->TSOViewBase = Views->AttachThread(0);
+    if (!Frame->TSOViewBase && !FEXCore::TSOViews::IdentityBase()) {
+      ERROR_AND_DIE_FMT("tso-arm: no free view slot for a new thread");
+    }
+    // Before the first thread runs anything: what earlier runs of this program learned
+    if (FEXCore::TSOViews::Enabled() && !FEXCore::TSOViews::Stage1()) {
+      Views->LoadProfile(CTX);
+    }
+  }
+
   // Allocate the call-ret stack with guard pages on both sides
   auto AllocBase =
