+// ---------------------------------------------------------------------------------------------------------------
+// Profile
+
+void TSOViewMemory::LoadProfile(FEXCore::Context::Context* CTX) {
+  std::lock_guard lk(Mutex);
+  if (ProfileLoaded) {
+    return;
+  }
+  ProfileLoaded = true;
+  const char* Env = getenv("TSO_VIEWS_PROFILE");
+  if (Env && !strcmp(Env, "none")) {
+    return;
+  }
+  if (Env && Env[0]) {
+    ProfilePath = Env;
+  } else {
+    // Bound to the program file: a rebuilt program gets a new profile
+    auto Program = FEXCore::Config::Get(FEXCore::Config::CONFIG_APP_FILENAME);
+    const char* Home = getenv("HOME");
+    struct stat St {};
+    if (!Program || !Home || stat(Program.value()->c_str(), &St) != 0) {
+      return;
+    }
+    const std::string Path = Program.value()->c_str();
+    uint64_t H = 1469598103934665603ULL;
+    auto Mix = [&H](const void* P, size_t N) {
+      for (size_t i = 0; i < N; ++i) {
+        H = (H ^ static_cast<const uint8_t*>(P)[i]) * 1099511628211ULL;
+      }
+    };
+    Mix(Path.data(), Path.size());
+    Mix(&St.st_size, sizeof(St.st_size));
+    Mix(&St.st_mtim, sizeof(St.st_mtim));
+    const std::string Dir = std::string(Home) + "/.cache/tso-arm";
+    mkdir((std::string(Home) + "/.cache").c_str(), 0755);
+    mkdir(Dir.c_str(), 0755);
+    char Name[64];
+    snprintf(Name, sizeof(Name), "-%016lx.prof", (unsigned long)H);
+    ProfilePath = Dir + "/" + Path.substr(Path.find_last_of('/') + 1) + Name;
+  }
+
+  FILE* F = fopen(ProfilePath.c_str(), "r");
+  if (!F) {
+    return;
+  }
+  char Line[128];
+  bool Fall = false;
+  while (fgets(Line, sizeof(Line), F)) {
+    unsigned long S, E;
+    if (sscanf(Line, "esc %lx %lx", &S, &E) == 2 && S < E) {
+      Escalations.emplace_back(S, E);
+      CTX->AddTSOEscalation(S, E);
+    } else if (!strncmp(Line, "fallback", 8)) {
+      Fall = true;
+    }
+  }
+  fclose(F);
+  VLOG("tso-arm: profile %s: %zu escalated ranges%s\n", ProfilePath.c_str(), Escalations.size(), Fall ? ", fallback" : "");
+  if (Fall && Budget) {
+    // Nothing is translated yet: no code to throw away
+    EnterFallback(0, false);
+  }
+}
+
+void TSOViewMemory::NoteEscalation(uint64_t Start, uint64_t End) {
+  std::lock_guard lk(Mutex);
+  Escalations.emplace_back(Start, End);
+  ProfileChanged = true;
+}
+
+void TSOViewMemory::SaveProfile() {
+  std::lock_guard lk(Mutex);
+  if (ProfilePath.empty() || !ProfileChanged) {
+    return;
+  }
+  const std::string Tmp = ProfilePath + ".tmp";
+  FILE* F = fopen(Tmp.c_str(), "w");
+  if (!F) {
+    return;
+  }
+  if (FallbackActive.load()) {
+    fprintf(F, "fallback\n");
+  }
+  for (auto [S, E] : Escalations) {
+    fprintf(F, "esc %lx %lx\n", (unsigned long)S, (unsigned long)E);
+  }
+  fclose(F);
+  rename(Tmp.c_str(), ProfilePath.c_str());
+  ProfileChanged = false;
+}
+
+uint64_t TSOViewMemory::ViewBase(int Slot, bool Ordered) {
+  return Ordered ? OrderedViewBase(Slot) : SlotBase(Slot);
+}
+
+// ---------------------------------------------------------------------------------------------------------------
+// Bookkeeping of guest mappings
+
+bool TSOViewMemory::IsFree(uint64_t Addr, uint64_t Length) const {
+  auto It = Ranges.upper_bound(Addr);
+  if (It != Ranges.begin() && std::prev(It)->second.End > Addr) {
+    return false;
+  }
+  return It == Ranges.end() || It->first >= Addr + Length;
+}
+
+const TSOViewMemory::Range* TSOViewMemory::Find(uint64_t Addr, uint64_t* Start) const {
+  auto It = Ranges.upper_bound(Addr);
+  if (It == Ranges.begin() || std::prev(It)->second.End <= Addr) {
+    return nullptr;
+  }
+  --It;
+  if (Start) {
+    *Start = It->first;
+  }
+  return &It->second;
+}
+
+uint64_t TSOViewMemory::ChooseAddress(uint64_t Hint, uint64_t Length) const {
+  if (Hint >= 0x10000 && Hint + Length <= Window && IsFree(Hint, Length)) {
+    return Hint;
+  }
+  // Highest gap in [AllocLow, Window)
+  uint64_t Top = Window;
+  for (auto It = Ranges.rbegin(); It != Ranges.rend(); ++It) {
+    if (It->first >= Top) {
+      continue;
+    }
+    const uint64_t End = std::min(It->second.End, Top);
+    if (Top - End >= Length && Top - Length >= AllocLow) {
+      return Top - Length;
+    }
+    Top = It->first;
+    if (Top < AllocLow + Length) {
+      return 0;
+    }
+  }
+  return Top >= AllocLow + Length ? Top - Length : 0;
+}
+
+void TSOViewMemory::Erase(uint64_t Addr, uint64_t End) {
+  auto It = Ranges.lower_bound(Addr);
+  if (It != Ranges.begin() && std::prev(It)->second.End > Addr) {
+    --It;
+  }
+  while (It != Ranges.end() && It->first < End) {
+    const uint64_t Start = It->first;
+    const Range R = It->second;
+    It = Ranges.erase(It);
+    if (Start < Addr) {
+      Ranges[Start] = {Addr, R.Prot, R.K};
+    }
+    if (R.End > End) {
+      Ranges[End] = {R.End, R.Prot, R.K};
+    }
+  }
+}
+
+void TSOViewMemory::Insert(uint64_t Addr, uint64_t End, int Prot, Kind K) {
+  Erase(Addr, End);
+  Ranges[Addr] = {End, Prot, K};
+}
+
+// ---------------------------------------------------------------------------------------------------------------
+// Views and protections
+
+void TSOViewMemory::Reserve(uint64_t Base, uint64_t Length) {
+  ::mmap(reinterpret_cast<void*>(Base), Length, PROT_NONE, ReserveFlags | MAP_FIXED, -1, 0);
+}
+
+void TSOViewMemory::AliasNone(uint64_t Addr, uint64_t Length, uint64_t Base) {
+  auto R = ::mremap(reinterpret_cast<void*>(Addr), 0, Length, MREMAP_MAYMOVE | MREMAP_FIXED, reinterpret_cast<void*>(Base + Addr));
+  if (R == MAP_FAILED) {
+    LogMan::Msg::EFmt("tso-arm: alias of {:#x}+{:#x} at view {:#x} failed: {}", Addr, Length, Base, strerror(errno));
+    return;
+  }
+  ::mprotect(R, Length, PROT_NONE);
+}
+
+void TSOViewMemory::AliasAll(uint64_t Addr, uint64_t Length) {
+  for (int S = 0; S < Slots; ++S) {
+    if (SlotUsed[S]) {
+      if (S != 0) {
+        AliasNone(Addr, Length, SlotBase(S));
+      }
+      AliasNone(Addr, Length, OrderedViewBase(S));
+    }
+  }
+}
+
+void TSOViewMemory::ReserveEverywhere(uint64_t Addr, uint64_t Length) {
+  if (Addr >= Window) {
+    return;
+  }
+  Length = std::min(Length, Window - Addr);
+  for (int S = 0; S < Slots; ++S) {
+    if (SlotUsed[S]) {
+      if (S != 0) {
+        Reserve(SlotBase(S) + Addr, Length);
+      }
+      Reserve(OrderedViewBase(S) + Addr, Length);
+    }
+  }
+}
+
+void TSOViewMemory::SetState(uint64_t Addr, uint64_t End, uint8_t State) {
+  if (Addr >= Window) {
+    return;
+  }
+  End = std::min(End, Window);
+  memset(Owner + (Addr >> PageShift), State, (End - Addr) >> PageShift);
+  memset(ROMask + (Addr >> PageShift), 0, ((End - Addr) >> PageShift) * sizeof(uint16_t));
+}
+
+int TSOViewMemory::ViewProt(uint8_t State, uint16_t Mask, int Slot, bool Ordered, int GuestProt) const {
+  const int RW = GuestProt & (PROT_READ | PROT_WRITE); // nothing executes through the views
+  const int RO = RW & PROT_READ;
+  if (Stage1() || Slot == 0) {
+    return RW;
+  }
+  if (State == 0) {
+    return PROT_NONE;
+  }
+  if (State == SharedRW) {
+    return Ordered ? RW : PROT_NONE;
+  }
+  if (State == SharedRO) {
+    return (Ordered || ((Mask >> Slot) & 1)) ? RO : PROT_NONE;
+  }
+  return State == Slot ? RW : PROT_NONE;
+}
+
+void TSOViewMemory::Apply(uint64_t Addr, uint64_t End) {
+  End = std::min(End, Window);
+  if (Addr >= End) {
+    return;
+  }
+  auto It = Ranges.upper_bound(Addr);
+  if (It != Ranges.begin()) {
+    --It;
+  }
+  for (; It != Ranges.end() && It->first < End; ++It) {
+    const uint64_t S = std::max(It->first, Addr);
+    const uint64_t E = std::min(It->second.End, End);
+    if (S >= E) {
+      continue;
+    }
+    const int GP = It->second.Prot;
+    for (int Sl = 0; Sl < Slots; ++Sl) {
+      if (!SlotUsed[Sl]) {
+        continue;
+      }
+      for (int Ord = Sl == 0 ? 1 : 0; Ord < 2; ++Ord) {
+        const uint64_t Base = ViewBase(Sl, Ord);
+        uint64_t RunStart = S;
+        int RunProt = ViewProt(Owner[S >> PageShift], ROMask[S >> PageShift], Sl, Ord, GP);
+        for (uint64_t P = S + (1ULL << PageShift); P < E; P += (1ULL << PageShift)) {
+          const int Prot = ViewProt(Owner[P >> PageShift], ROMask[P >> PageShift], Sl, Ord, GP);
+          if (Prot != RunProt) {
+            Protect(Base + RunStart, P - RunStart, RunProt);
+            RunStart = P;
+            RunProt = Prot;
+          }
+        }
+        Protect(Base + RunStart, E - RunStart, RunProt);
+      }
+    }
+  }
+}
+
+void TSOViewMemory::ApplyPage(uint64_t Page, uint8_t OldState, uint16_t OldMask, int GuestProt, int FaultSlot) {
+  const uint8_t NewState = Owner[Page];
+  const uint16_t NewMask = ROMask[Page];
+  for (int Sl = 1; Sl < Slots; ++Sl) {
+    if (!SlotUsed[Sl]) {
+      continue;
+    }
+    for (int Ord = 0; Ord < 2; ++Ord) {
+      const int O = ViewProt(OldState, OldMask, Sl, Ord, GuestProt);
+      const int N = ViewProt(NewState, NewMask, Sl, Ord, GuestProt);
+      // A view may hold less than O (a right given lazily and not used yet), never more
+      if (O != N && ((O & ~N) != 0 || Sl == FaultSlot)) {
+        Protect(ViewBase(Sl, Ord) + (Page << PageShift), 1ULL << PageShift, N);
+      }
+    }
+  }
+  ++Stats.Transitions;
+}
+
+// ---------------------------------------------------------------------------------------------------------------
+// Guest memory management
+
+int64_t TSOViewMemory::Mmap(uint64_t Addr, uint64_t Length, int Prot, int Flags, int Fd, off_t Offset, int Slot) {
+  std::lock_guard lk(Mutex);
+  VLOG("tso-arm: mmap %#lx+%#lx prot %d flags %#x fd %d slot %d\n", (unsigned long)Addr, (unsigned long)Length, Prot, Flags, Fd, Slot);
+  const uint64_t L = PageUp(Length);
+  if (L == 0) {
+    return -EINVAL;
+  }
+  const bool Fixed = Flags & MAP_FIXED;
+  const bool NoReplace = Flags & MAP_FIXED_NOREPLACE;
+  const bool Anon = Flags & MAP_ANONYMOUS;
+  const bool Shared = (Flags & MAP_SHARED) || (Flags & MAP_SHARED_VALIDATE) == MAP_SHARED_VALIDATE;
+
+  uint64_t A = Addr;
+  if (Fixed || NoReplace) {
+    if (A + L > Window || A + L < A) {
+      return -ENOMEM;
+    }
+    if (NoReplace && !IsFree(A, L)) {
+      return -EEXIST;
+    }
+  }
+
+  const int HostFlags = Flags & ~DropFlags & ~MAP_FIXED;
+  for (int Attempt = 0; Attempt < 64; ++Attempt) {
+    if (!Fixed && !NoReplace) {
+      A = ChooseAddress(Attempt == 0 ? Addr : 0, L);
+      if (!A) {
+        return -ENOMEM;
+      }
+    }
+    // A chosen address may hold something the guest did not map (a host mapping); never replace it.
+    const int F = HostFlags | ((Fixed && !NoReplace) ? MAP_FIXED : MAP_FIXED_NOREPLACE);
+
+    void* R = MAP_FAILED;
+    Kind K = Kind::Private;
+    if (Anon && !Shared) {
+      R = ::mmap(reinterpret_cast<void*>(A), L, Prot, F | MAP_SHARED | MAP_ANONYMOUS, -1, 0);
+    } else if (Anon) {
+      R = ::mmap(reinterpret_cast<void*>(A), L, Prot, F | MAP_SHARED | MAP_ANONYMOUS, -1, 0);
+      K = Kind::SharedAnon;
+    } else if (!Shared) {
+      // Private file mapping: a copy of the file in shared memory
+      R = ::mmap(reinterpret_cast<void*>(A), L, PROT_READ | PROT_WRITE, F | MAP_SHARED | MAP_ANONYMOUS, -1, 0);
+      if (R != MAP_FAILED) {
+        uint64_t Done = 0;
+        while (Done < Length) {
+          const auto N = ::pread(Fd, static_cast<char*>(R) + Done, Length - Done, Offset + Done);
+          if (N <= 0) {
+            break;
+          }
+          Done += N;
+        }
+        ::mprotect(R, L, Prot);
+      }
+    } else {
+      R = ::mmap(reinterpret_cast<void*>(A), L, Prot, F | MAP_SHARED, Fd, Offset);
+      K = Kind::SharedFile;
+    }
+
+    if (R == MAP_FAILED) {
+      if (errno == EEXIST && !Fixed && !NoReplace) {
+        // Something unknown to us lives there: remember it as taken and try the next gap
+        Ranges[A] = {A + L, PROT_NONE, Kind::SharedFile};
+        continue;
+      }
+      return -errno;
+    }
+
+    Insert(A, A + L, Prot, K);
+    AliasAll(A, L);
+    const uint8_t State = (K != Kind::Private || FallbackActive.load()) ? SharedRW : (IsOwnerSlot(Slot) && SlotUsed[Slot]) ? uint8_t(Slot) : uint8_t(0);
+    SetState(A, A + L, State);
+    Apply(A, A + L);
+    return A;
+  }
+  return -ENOMEM;
+}
+
+int64_t TSOViewMemory::Munmap(uint64_t Addr, uint64_t Length) {
+  std::lock_guard lk(Mutex);
+  VLOG("tso-arm: munmap %#lx+%#lx\n", (unsigned long)Addr, (unsigned long)Length);
+  const uint64_t L = PageUp(Length);
+  if (::munmap(reinterpret_cast<void*>(Addr), L) == -1) {
+    return -errno;
+  }
+  ReserveEverywhere(Addr, L);
+  Erase(Addr, Addr + L);
+  SetState(Addr, Addr + L, 0);
+  return 0;
+}
+
+int64_t TSOViewMemory::Mprotect(uint64_t Addr, uint64_t Length, int Prot) {
+  std::lock_guard lk(Mutex);
+  VLOG("tso-arm: mprotect %#lx+%#lx prot %d\n", (unsigned long)Addr, (unsigned long)Length, Prot);
+  const uint64_t L = PageUp(Length);
+  if (::mprotect(reinterpret_cast<void*>(Addr), L, Prot) == -1) {
+    return -errno;
+  }
+
+  // Split the bookkeeping at the borders and record the new protection
+  std::vector<std::pair<uint64_t, Range>> Pieces;
+  auto It = Ranges.lower_bound(Addr);
+  if (It != Ranges.begin() && std::prev(It)->second.End > Addr) {
+    --It;
+  }
+  for (; It != Ranges.end() && It->first < Addr + L; ++It) {
+    const uint64_t S = std::max(It->first, Addr);
+    const uint64_t E = std::min(It->second.End, Addr + L);
+    Pieces.push_back({S, {E, Prot, It->second.K}});
+  }
+  for (auto& [S, R] : Pieces) {
+    Insert(S, R.End, R.Prot, R.K);
+  }
+  Apply(Addr, Addr + L);
+  return 0;
+}
+
+int64_t TSOViewMemory::Mremap(uint64_t Old, uint64_t OldSize, uint64_t NewSize, int Flags, uint64_t New, int Slot) {
+  std::lock_guard lk(Mutex);
+  VLOG("tso-arm: mremap %#lx+%#lx -> %#lx flags %#x\n", (unsigned long)Old, (unsigned long)OldSize, (unsigned long)NewSize, Flags);
+  const uint64_t OldL = PageUp(OldSize);
+  const uint64_t NewL = PageUp(NewSize);
+  const uint8_t Mine = FallbackActive.load() ? SharedRW : (IsOwnerSlot(Slot) && SlotUsed[Slot]) ? uint8_t(Slot) : uint8_t(0);
+
+  const Range* SrcP = Find(Old);
+  if (!SrcP) {
+    return -EFAULT;
+  }
+  const Range Src = *SrcP;
+
+  auto Place = [&](uint64_t T, uint64_t Len, Kind K) {
+    Insert(T, T + Len, Src.Prot, K);
+    AliasAll(T, Len);
+    SetState(T, T + Len, K == Kind::Private ? Mine : SharedRW);
+    Apply(T, T + Len);
+  };
+  auto Drop = [&](uint64_t A, uint64_t Len) {
+    ReserveEverywhere(A, Len);
+    Erase(A, A + Len);
+    SetState(A, A + Len, 0);
+  };
+
+  if (OldL == 0) {
+    // The guest asks for a second mapping of shared memory
+    uint64_t T = (Flags & MREMAP_FIXED) ? New : ChooseAddress(0, NewL);
+    if (!T || T + NewL > Window) {
+      return -ENOMEM;
+    }
+    auto R = ::mremap(reinterpret_cast<void*>(Old), 0, NewL, MREMAP_MAYMOVE | MREMAP_FIXED, reinterpret_cast<void*>(T));
+    if (R == MAP_FAILED) {
+      return -errno;
+    }
+    Place(T, NewL, Kind::SharedAnon);
+    return T;
+  }
+
+  if (NewL <= OldL && !(Flags & MREMAP_FIXED)) {
+    // Shrink in place
+    if (NewL < OldL) {
+      if (::munmap(reinterpret_cast<void*>(Old + NewL), OldL - NewL) == -1) {
+        return -errno;
+      }
+      Drop(Old + NewL, OldL - NewL);
+    }
+    return Old;
+  }
+
+  if (Src.K == Kind::Private) {
+    // Shared memory objects cannot grow under an existing mapping: a tail object in place, or a moved copy
+    if (!(Flags & MREMAP_FIXED) && IsFree(Old + OldL, NewL - OldL)) {
+      auto R = ::mmap(reinterpret_cast<void*>(Old + OldL), NewL - OldL, Src.Prot, MAP_SHARED | MAP_ANONYMOUS | MAP_FIXED_NOREPLACE, -1, 0);
+      if (R != MAP_FAILED) {
+        Insert(Old + OldL, Old + NewL, Src.Prot, Kind::Private);
+        AliasAll(Old + OldL, NewL - OldL);
+        SetState(Old + OldL, Old + NewL, Mine);
+        Apply(Old + OldL, Old + NewL);
+        return Old;
+      }
+    }
+    if (!(Flags & (MREMAP_MAYMOVE | MREMAP_FIXED))) {
+      return -ENOMEM;
+    }
+    const uint64_t T = (Flags & MREMAP_FIXED) ? New : ChooseAddress(0, NewL);
+    if (!T || T + NewL > Window) {
+      return -ENOMEM;
+    }
+    auto R = ::mmap(reinterpret_cast<void*>(T), NewL, PROT_READ | PROT_WRITE, MAP_SHARED | MAP_ANONYMOUS | MAP_FIXED, -1, 0);
+    if (R == MAP_FAILED) {
+      return -errno;
+    }
+    memcpy(R, reinterpret_cast<void*>(Old), std::min(OldL, NewL));
+    ::mprotect(R, NewL, Src.Prot);
+    ::munmap(reinterpret_cast<void*>(Old), OldL);
+    Drop(Old, OldL);
+    Place(T, NewL, Kind::Private);
+    return T;
+  }
+
+  // Shared memory of the guest's own: the kernel moves or grows it
+  uint64_t T = (Flags & MREMAP_FIXED) ? New : Old;
+  if (!(Flags & MREMAP_FIXED) && !IsFree(Old + OldL, NewL - OldL)) {
+    if (!(Flags & MREMAP_MAYMOVE)) {
+      return -ENOMEM;
+    }
+    T = ChooseAddress(0, NewL);
+  }
+  if (!T || T + NewL > Window) {
+    return -ENOMEM;
+  }
+  void* R = (T == Old) ? ::mremap(reinterpret_cast<void*>(Old), OldL, NewL, 0) :
+                         ::mremap(reinterpret_cast<void*>(Old), OldL, NewL, MREMAP_MAYMOVE | MREMAP_FIXED, reinterpret_cast<void*>(T));
+  if (R == MAP_FAILED) {
+    return -errno;
+  }
+  Drop(Old, OldL);
+  Place(T, NewL, Src.K);
+  return T;
+}
+
+int64_t TSOViewMemory::Madvise(uint64_t Addr, uint64_t Length, int Advice) {
+  std::lock_guard lk(Mutex);
+  VLOG("tso-arm: madvise %#lx+%#lx advice %d\n", (unsigned long)Addr, (unsigned long)Length, Advice);
+  if (Advice != MADV_DONTNEED && Advice != MADV_FREE) {
+    return ::madvise(reinterpret_cast<void*>(Addr), Length, Advice) == -1 ? -errno : 0;
+  }
+  const uint64_t End = Addr + PageUp(Length);
+  auto It = Ranges.upper_bound(Addr);
+  if (It != Ranges.begin()) {
+    --It;
+  }
+  for (; It != Ranges.end() && It->first < End; ++It) {
+    const uint64_t S = std::max(It->first, Addr);
+    const uint64_t E = std::min(It->second.End, End);
+    if (S >= E) {
+      continue;
+    }
+    const int A = It->second.K == Kind::Private ? MADV_REMOVE : Advice;
+    if (::madvise(reinterpret_cast<void*>(S), E - S, A) == -1) {
+      return -errno;
+    }
+  }
+  return 0;
+}
+
+// ---------------------------------------------------------------------------------------------------------------
+// Threads
+
+uint64_t TSOViewMemory::AttachThread(uint64_t StackPointer) {
+  if (IdentityBase()) {
+    return 0;
+  }
+  std::lock_guard lk(Mutex);
+  int S = 1;
+  for (; S < Slots; ++S) {
+    if (SlotUsable[S] && !SlotUsed[S]) {
+      break;
+    }
+  }
+  if (S == Slots) {
+    return 0;
+  }
+  SlotUsed[S] = true;
+  for (auto& [Start, R] : Ranges) {
+    if (R.Prot != PROT_NONE || R.K != Kind::SharedFile) {
+      AliasNone(Start, R.End - Start, SlotBase(S));
+      AliasNone(Start, R.End - Start, OrderedViewBase(S));
+    }
+  }
+
+  if (!AnyAttached || Stage1()) {
+    // The first thread owns everything mapped before it existed (the program, its stack, the heap)
+    AnyAttached = true;
+    for (auto& [Start, R] : Ranges) {
+      if (R.K != Kind::Private || Start >= Window) {
+        continue;
+      }
+      const uint64_t E = std::min(R.End, Window);
+      for (uint64_t P = Start >> PageShift; P < (E >> PageShift); ++P) {
+        if (Owner[P] == 0) {
+          Owner[P] = uint8_t(S);
+        }
+      }
+    }
+    for (auto& [Start, R] : Ranges) {
+      Apply(Start, R.End);
+    }
+  } else if (StackPointer) {
+    HandOffStack(SlotBase(S), StackPointer);
+  }
+  return SlotBase(S);
+}
+
+void TSOViewMemory::HandOffStack(uint64_t Base, uint64_t StackPointer) {
+  if (!Base || !StackPointer || Stage1() || FallbackActive.load()) {
+    return;
+  }
+  // The new thread's stack was mapped by its parent; it belongs to the new thread from its first instruction
+  // (the clone call orders the parent's writes before it, e.g. glibc's thread descriptor at the top).
+  std::lock_guard lk(Mutex);
+  const int S = Base / Window;
+  uint64_t Start {};
+  const Range* R = Find(StackPointer - 1, &Start);
+  if (!R || R->K != Kind::Private || Start >= Window) {
+    return;
+  }
+  const uint64_t E = std::min(R->End, Window);
+  for (uint64_t P = Start >> PageShift; P < (E >> PageShift); ++P) {
+    if (Owner[P] == 0 || IsOwnerSlot(Owner[P])) {
+      Owner[P] = uint8_t(S);
+      ROMask[P] = 0;
+    }
+  }
+  Apply(Start, E);
+}
+
+void TSOViewMemory::DetachThread(uint64_t Base) {
+  if (!Base) {
+    return;
+  }
+  std::lock_guard lk(Mutex);
+  const int S = Base / Window;
+  const uint16_t Bit = uint16_t(1U << S);
+  VLOG("tso-arm: detach slot %d\n", S);
+  for (uint64_t P = 0; P < Pages; ++P) {
+    if (Owner[P] == S) {
+      Owner[P] = 0; // the next thread to touch it takes it
+    }
+    ROMask[P] &= ~Bit;
+  }
+  Reserve(SlotBase(S), Window);
+  Reserve(OrderedViewBase(S), Window);
+  SlotUsed[S] = false;
+}
+
+// ---------------------------------------------------------------------------------------------------------------
+// Faults
+
+void TSOViewMemory::EnterFallback(uint64_t Elapsed, bool DropCode) {
+  // Every page shared read-write: plain views lose everything, ordered views get everything. Old translations
+  // keep working (their plain accesses fault and are completed in the handler); new ones address guest memory
+  // directly. The caller's fault handler throws the translated code away (TakeFallbackRequest).
+  LogMan::Msg::IFmt("tso-arm: {} protocol faults in {:.2f} s, falling back to full ordering", FaultsSeen, Elapsed / 1e9);
+  FallbackAt = Elapsed;
+  for (auto& [Start, R] : Ranges) {
+    if (Start >= Window) {
+      continue;
+    }
+    SetState(Start, std::min(R.End, Window), SharedRW);
+  }
+  for (auto& [Start, R] : Ranges) {
+    Apply(Start, R.End);
+  }
+  FallbackActive.store(true, std::memory_order_release);
+  FallbackRequest.store(DropCode, std::memory_order_release);
+  ProfileChanged = true;
+}
+
+bool TSOViewMemory::TakeFallbackRequest() {
+  return FallbackRequest.load(std::memory_order_relaxed) && FallbackRequest.exchange(false);
+}
+
+bool TSOViewMemory::MayMigrate(uint64_t Page) {
+  // Three changes of hands in a row, each within QuickUs of the one before: the page is used by two threads at
+  // once, and moving it back and forth would cost a fault each time
+  const uint32_t Now = uint32_t((Nanos() - StartNs) / 1000);
+  const uint32_t Since = Now - LastChange[Page];
+  LastChange[Page] = Now;
+  if (Since < QuickUs) {
+    if (Quick[Page] >= QuickAllowed) {
+      return false;
+    }
+    ++Quick[Page];
+  } else {
+    Quick[Page] = 0;
+  }
+  return true;
+}
+
+void TSOViewMemory::CollapseChunk(uint64_t Chunk, uint8_t From, uint8_t To, uint16_t ToMask) {
+  const uint64_t First = Chunk << (ChunkShift - PageShift);
+  const uint64_t Last = std::min<uint64_t>(First + (uint64_t(1) << (ChunkShift - PageShift)), Pages);
+  const uint32_t Now = uint32_t((Nanos() - StartNs) / 1000);
+  uint64_t Moved = 0;
+  for (uint64_t P = First; P < Last; ++P) {
+    if (Owner[P] == From) {
+      Owner[P] = To;
+      ROMask[P] = ToMask;
+      LastChange[P] = Now; // a page that is really shared comes back quickly and is caught by MayMigrate
+      ++Moved;
+    }
+  }
+  // Every view at once, the other threads' new rights included: they would fault for each page otherwise
+  Apply(First << PageShift, Last << PageShift);
+  ChunkShares[Chunk] = 0;
+  Count.Collapsed += Moved;
+  ++Stats.Transitions;
+}
+
+TSOViewMemory::Fault TSOViewMemory::HandleFault(uint64_t FaultAddress, bool Write, int Slot) {
+  static const bool Log = Knob("TSO_VIEWS_LOG");
+  auto NotOurs = [&](const char* Why) {
+    if (Log) {
+      fprintf(stderr, "tso-arm: fault %s at %#lx slot %d not ours: %s\n", Write ? "W" : "R", (unsigned long)FaultAddress, Slot, Why);
+    }
+    return Fault::NotOurs;
+  };
+  if (Stage1() || FaultAddress < Window) {
+    return NotOurs("not a view address");
+  }
+  const int View = FaultAddress / Window;
+  const bool Ordered = View >= Slots;
+  if (View >= 2 * Slots || Slot == 0 || (Ordered ? View - Slots : View) != Slot) {
+    return NotOurs("another thread's view");
+  }
+  std::lock_guard lk(Mutex);
+  const uint64_t G = FaultAddress & (Window - 1);
+  const Range* R = Find(G);
+  if (!R) {
+    return NotOurs("not mapped by the guest");
+  }
+  const int GP = R->Prot;
+  if (!(GP & PROT_READ) || (Write && !(GP & PROT_WRITE))) {
+    return NotOurs("guest protection"); // the guest itself may not do this
+  }
+
+  // The same address faulting over and over means the protocol is stuck: hand it to the normal fault path
+  // (an atomic reported as a read first becomes shared read-only, then faults again as a write and is upgraded)
+  if (LastFault == FaultAddress) {
+    if (++LastFaultCount > 64) {
+      LogMan::Msg::EFmt("tso-arm: access at {:#x} keeps faulting (state {:#x})", FaultAddress, Owner[G >> PageShift]);
+      return Fault::NotOurs;
+    }
+  } else {
+    LastFault = FaultAddress;
+    LastFaultCount = 0;
+  }
+
+  const uint64_t Page = G >> PageShift;
+  const uint8_t St = Owner[Page];
+  const uint16_t Mask = ROMask[Page];
+  Fault Result = Fault::Retry;
+
+  // Migratory ownership: a page written by a thread other than its owner (or a shared one) moves to the writer
+  // instead of becoming shared, unless it went back and forth quickly (MayMigrate). The old owner's views lose it
+  // through mprotect, which also completes its earlier plain stores, so both threads keep plain accesses: the case
+  // of buffers handed from one thread to the next. Pages that really are used by two threads at once (locks,
+  // flags, counters) still become shared, and their plain writers are escalated. No migration in the fallback.
+  const bool Migrating = MigrateOn && !FallbackActive.load(std::memory_order_relaxed);
+  auto MoveHere = [&] {
+    Owner[Page] = uint8_t(Slot);
+    ROMask[Page] = 0;
+    ++Count.Migrations;
+  };
+
+  if (Ordered) {
+    // An ordered access (or an atomic) through this thread's ordered view. Its own pages are accessible there,
+    // so this is a page nobody owns, another thread's page, or a shared right not given to this view yet.
+    if (St == 0) {
+      Owner[Page] = uint8_t(Slot);
+      ++Count.Claims;
+    } else if (St == Slot) {
+      // stale protection; re-applied below
+    } else if (IsOwnerSlot(St)) {
+      if (Write && Migrating && MayMigrate(Page)) {
+        MoveHere();
+      } else if (Write) {
+        Owner[Page] = SharedRW;
+        ROMask[Page] = 0;
+        ++Count.Shares;
+      } else {
+        Owner[Page] = SharedRO;
+        ROMask[Page] = uint16_t(1U << St); // the owner keeps reading plainly
+        ++Count.Shares;
+      }
+    } else if (St == SharedRO && Write) {
+      if (Migrating && MayMigrate(Page)) {
+        MoveHere();
+      } else {
+        Owner[Page] = SharedRW;
+        ROMask[Page] = 0;
+        ++Count.Upgrades;
+      }
+    } else {
+      ++Count.Lazy; // the right exists, this view gets it now
+    }
+  } else if (St == 0) {
+    Owner[Page] = uint8_t(Slot);
+    ++Count.Claims;
+  } else if (St == Slot) {
+    // stale protection; re-applied below
+  } else if (IsOwnerSlot(St)) {
+    if (Write && Migrating && MayMigrate(Page)) {
+      MoveHere();
+    } else if (Write) {
+      Owner[Page] = SharedRW;
+      ROMask[Page] = 0;
+      Result = Fault::Escalate;
+      ++Count.Shares;
+    } else {
+      Owner[Page] = SharedRO;
+      ROMask[Page] = uint16_t((1U << St) | (1U << Slot));
+      ++Count.Shares;
+    }
+  } else if (St == SharedRO) {
+    if (Write && Migrating && MayMigrate(Page)) {
+      MoveHere();
+    } else if (Write) {
+      Owner[Page] = SharedRW;
+      ROMask[Page] = 0;
+      Result = Fault::Escalate;
+      ++Count.Upgrades;
+    } else {
+      ROMask[Page] |= uint16_t(1U << Slot);
+      ++Count.Lazy;
+    }
+  } else if (Migrating && MayMigrate(Page)) {
+    // Shared read-write, but quiet for a while: a writer takes it, a reader makes it read-only for everyone
+    if (Write) {
+      MoveHere();
+    } else {
+      Owner[Page] = SharedRO;
+      ROMask[Page] = uint16_t(1U << Slot);
+      ++Count.Migrations;
+    }
+  } else {
+    Result = Fault::Escalate; // shared read-write: plain accesses are not allowed
+  }
+
+  if (Log) {
+    fprintf(stderr, "tso-arm: fault %s view %d slot %d guest %#lx: %#x/%#x -> %#x/%#x %s\n", Write ? "W" : "R", View, Slot,
+            (unsigned long)G, St, Mask, Owner[Page], ROMask[Page],
+            Result == Fault::Escalate ? "escalate" : "retry");
+  }
+
+  // Budget: a program that keeps the protocol busy (more than TSO_VIEWS_BUDGET faults per second over the last
+  // 1000 faults, after the first 300 ms) is better off with plain full ordering. The window ignores the burst of
+  // faults while a program starts up and its threads first touch their data.
+  ++FaultsSeen;
+  if (Budget && !FallbackActive.load(std::memory_order_relaxed) && FaultsSeen - WindowFaults >= WindowSize) {
+    const uint64_t Now = Nanos();
+    const uint64_t Span = Now - WindowStartNs;
+    const bool Over = Now - StartNs > WarmupNs && double(FaultsSeen - WindowFaults) * 1e9 / double(Span) > double(Budget);
+    WindowFaults = FaultsSeen;
+    WindowStartNs = Now;
+    if (Over) {
+      EnterFallback(Now - StartNs);
+      if (Result == Fault::Escalate) {
+        ++Count.Escalations;
+      }
+      return Result;
+    }
+  }
+
+  // Buffers that move between threads move page by page, one fault each. After a few private pages of one chunk
+  // were shared, the owner's remaining pages of the chunk follow at once (taking a page from its owner early is
+  // always allowed; it only costs ordering on that page).
+  // The same holds for shared read-only pages that become read-write, and for pages that move to another thread.
+  // (TSO_VIEWS_CHUNKMIG=0: migrations move single pages only)
+  static const bool ChunkMigrations = !(getenv("TSO_VIEWS_CHUNKMIG") && getenv("TSO_VIEWS_CHUNKMIG")[0] == '0');
+  const bool Moved = Owner[Page] != St && (IsOwnerSlot(St) || St == SharedRO || (St == SharedRW && Result != Fault::Escalate)) &&
+                     (ChunkMigrations || !IsOwnerSlot(Owner[Page]));
+  if (Moved && ChunkShares) {
+    const uint64_t Chunk = G >> ChunkShift;
+    if (++ChunkShares[Chunk] >= CollapseAfter) {
+      CollapseChunk(Chunk, St, Owner[Page], ROMask[Page]);
+      if (Result == Fault::Escalate) {
+        ++Count.Escalations;
+      }
+      return Result;
+    }
+  }
+
+  if (Owner[Page] == St && ROMask[Page] == Mask) {
+    // No state change (stale protection, or a race with another thread's transition): set this view right
+    ++Count.Stale;
+    Protect(FaultAddress & ~PageMask, 1ULL << PageShift, ViewProt(St, Mask, Slot, Ordered, GP));
+  } else {
+    ApplyPage(Page, St, Mask, GP, Slot);
+  }
+  if (Result == Fault::Escalate) {
+    ++Count.Escalations;
+  }
+  return Result;
+}
