-                  Info.dli_sname ? Info.dli_sname : "?", (unsigned long)ArchHelpers::Context::GetArmReg(ucontext, 30),
-                  (unsigned long)Thread->CurrentFrame->State.rip);
+          fprintf(stderr, "tso-arm: not ours outside translated code, pc %#lx (%s+%#lx, %s), instruction %#010x, address %#lx, lr %#lx, rip %#lx\n",
+                  (unsigned long)PC, Info.dli_fname ? Info.dli_fname : "?", (unsigned long)(PC - reinterpret_cast<uint64_t>(Info.dli_fbase)),
+                  Info.dli_sname ? Info.dli_sname : "?", *reinterpret_cast<const uint32_t*>(PC), (unsigned long)FaultAddress,
