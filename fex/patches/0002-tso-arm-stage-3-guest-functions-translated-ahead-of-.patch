 }
 
+// tso-arm: instruction kinds (their table entries) that touched guest memory although IsViewExitPoint saw no access;
+// exit points from then on. Once the list is full, every instruction start is one.
+namespace {
+  constexpr uint32_t MaxViewExitKinds = 32;
+  std::atomic<const void*> ViewExitKinds[MaxViewExitKinds];
+  std::atomic<uint32_t> NumViewExitKinds {0};
+  std::mutex ViewExitKindsMutex;
+
+  bool IsLearnedViewExit(const void* Kind) {
+    const uint32_t N = NumViewExitKinds.load(std::memory_order_acquire);
+    if (N >= MaxViewExitKinds) {
+      return true;
+    }
+    for (uint32_t i = 0; i < N; ++i) {
+      if (ViewExitKinds[i].load(std::memory_order_relaxed) == Kind) {
+        return true;
+      }
+    }
+    return false;
+  }
+
+  void LearnViewExit(const void* Kind) {
+    std::lock_guard lk(ViewExitKindsMutex);
+    if (IsLearnedViewExit(Kind)) {
+      return;
+    }
+    const uint32_t N = NumViewExitKinds.load(std::memory_order_relaxed);
+    ViewExitKinds[N].store(Kind, std::memory_order_relaxed);
+    NumViewExitKinds.store(N + 1, std::memory_order_release);
+  }
+} // namespace
