+namespace {
+  bool ZeroPage(const uint8_t* P) {
+    const auto* Q = reinterpret_cast<const uint64_t*>(P);
+    for (size_t i = 0; i < (size_t(1) << PageShift) / sizeof(uint64_t); ++i) {
+      if (Q[i]) {
+        return false;
+      }
+    }
+    return true;
+  }
+} // namespace
