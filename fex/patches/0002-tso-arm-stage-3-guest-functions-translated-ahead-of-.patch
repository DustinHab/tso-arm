+    }
+  } else {
+    LogMan::Msg::EFmt("tso-arm: fork without a pipe to wait for the child's copy");
+  }
+  CloseForkPipe(0);
+  for (auto& [Start, R] : Ranges) {
+    if (R.K == Kind::Private && Start < Window && !(R.Prot & PROT_WRITE)) {
+      R.ForkShared = true;
+    }
+  }
+}
