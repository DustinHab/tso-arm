+int64_t TSOViewMemory::Unshare(uint64_t Start, Range& R, SwapPages& Swap) {
+  if (Start >= Window || R.K != Kind::Private) {
+    return 0;
+  }
+  const uint64_t End = std::min(R.End, Window);
+  const uint64_t L = End - Start;
+  auto* Copy = static_cast<uint8_t*>(::mmap(nullptr, L, PROT_READ | PROT_WRITE, MAP_SHARED | MAP_ANONYMOUS, -1, 0));
+  if (Copy == MAP_FAILED) {
+    return -1;
+  }
+  auto* Src = reinterpret_cast<uint8_t*>(Start);
+  if (!(R.Prot & PROT_READ)) {
+    ::mprotect(Src, L, PROT_READ); // replaced below anyway
+  }
+  Swap.Load();
+
+  // Only pages that hold something: those in memory (mincore, which for shared memory looks at the pages of the
+  // object, whichever mapping touched them), and nonzero pages among those that may be in swap. The others stay
+  // holes in the copy and read as zero, as they do in the original. A file-backed range is copied whole: its pages
+  // not in memory are the file's, not zero.
+  int64_t Bytes = 0;
+  constexpr uint64_t ChunkPages = 1 << 12;
+  uint8_t In[ChunkPages];
+  if (R.FileBacked) {
+    CopyReadable(Copy, Src, L);
+    Bytes = int64_t(L);
+  }
+  for (uint64_t C = 0; C < L && !R.FileBacked; C += ChunkPages << PageShift) {
+    const uint64_t CL = std::min(L - C, ChunkPages << PageShift);
+    const uint64_t CP = CL >> PageShift;
+    if (::mincore(Src + C, CL, In) != 0) {
+      VLOG("tso-arm: mincore %#lx+%#lx: %s\n", (unsigned long)(Start + C), (unsigned long)CL, strerror(errno));
+      continue; // not mapped in this process (MADV_DONTFORK): nothing to copy
+    }
+    uint64_t Run = 0;
+    for (uint64_t P = 0; P <= CP; ++P) {
+      if (P < CP) {
+        const uint64_t Off = C + (P << PageShift);
+        if ((In[P] & 1) || (Swap.Maybe(Start + Off) && !ZeroPage(Src + Off))) {
+          ++Run;
+          continue;
+        }
+      }
+      if (Run) {
+        const uint64_t Off = C + ((P - Run) << PageShift);
+        memcpy(Copy + Off, Src + Off, Run << PageShift);
+        Bytes += int64_t(Run << PageShift);
+        Run = 0;
+      }
+    }
+  }
+
+  VLOG("tso-arm: copy of %#lx-%#lx prot %d aliased %#x: %ld KB\n", (unsigned long)Start, (unsigned long)End, R.Prot, R.Aliased,
+       (long)(Bytes >> 10));
+
+  // The copy takes the range's place in guest memory and in the views that map it
+  if (::mremap(Copy, L, L, MREMAP_MAYMOVE | MREMAP_FIXED, Src) == MAP_FAILED) {
+    LogMan::Msg::EFmt("tso-arm: the copy of {:#x}-{:#x} could not take its place: {}", Start, End, strerror(errno));
+    ::munmap(Copy, L);
+    ::mprotect(Src, L, R.Prot);
+    return -1;
+  }
+  ::mprotect(Src, L, R.Prot);
+  for (int S = 0; S < Slots; ++S) {
+    if (SlotUsed[S] && ((R.Aliased >> S) & 1)) {
+      if (S != 0) {
+        AliasNone(Start, L, SlotBase(S));
+      }
+      AliasNone(Start, L, OrderedViewBase(S));
+    }
+  }
+  R.ForkShared = false;
+  R.FileBacked = false;
+  R.CopyOnWrite = false;
+  Apply(Start, End);
+  return Bytes;
+}
+
+void TSOViewMemory::UnshareForkShared(uint64_t Addr, uint64_t Length, bool Files) {
+  const uint64_t End = Addr + Length;
+  SwapPages Swap;
+  auto It = Ranges.upper_bound(Addr);
+  if (It != Ranges.begin()) {
+    --It;
+  }
+  for (; It != Ranges.end() && It->first < End; ++It) {
+    if (!It->second.ForkShared || It->second.End <= Addr || (!Files && It->second.FileBacked) || It->second.CopyOnWrite) {
+      continue;
+    }
+    if (Unshare(It->first, It->second, Swap) < 0) {
+      LogMan::Msg::EFmt("tso-arm: {:#x}-{:#x} stays shared with a forked process: its copy failed", It->first, It->second.End);
+    } else {
+      VLOG("tso-arm: %#lx-%#lx no longer shared with a forked process\n", (unsigned long)It->first, (unsigned long)It->second.End);
+    }
+  }
+}
