+// ---------------------------------------------------------------------------------------------------------------
+// fork
+
+// Pages of shared memory that are in swap have no page table entry and are not in the page cache, so mincore does
+// not count them. With swap in use on the system, the guest mappings with pages in swap are looked up in
+// /proc/self/smaps (once per fork), and every page of those is read. No allocations: the child of a fork may find
+// the allocators' locks held by threads it does not have.
+struct TSOViewMemory::SwapPages {
+  bool Loaded {};
+  bool All {};    // the mappings could not be listed: every page may be in swap
+  uint64_t* V {}; // [start, end) pairs, in address order
+  size_t N {};
+  static constexpr size_t Cap = 1 << 16;
+  ~SwapPages() {
+    if (V) {
+      ::munmap(V, Cap * 2 * sizeof(uint64_t));
+    }
+  }
+  void Load();
+  bool Maybe(uint64_t Addr) const {
+    if (All) {
+      return true;
+    }
+    size_t Lo = 0, Hi = N;
+    while (Lo < Hi) {
+      const size_t M = (Lo + Hi) / 2;
+      if (V[2 * M + 1] <= Addr) {
+        Lo = M + 1;
+      } else {
+        Hi = M;
+      }
+    }
+    return Lo < N && V[2 * Lo] <= Addr;
+  }
+};
+
+void TSOViewMemory::SwapPages::Load() {
+  if (Loaded) {
+    return;
+  }
+  Loaded = true;
+  {
+    char Buf[8192];
+    const int Fd = OpenProc("meminfo");
+    const ssize_t Len = Fd >= 0 ? ::read(Fd, Buf, sizeof(Buf) - 1) : -1;
+    if (Fd >= 0) {
+      ::close(Fd);
+    }
+    if (Len > 0) {
+      Buf[Len] = 0;
+      const char* Total = strstr(Buf, "SwapTotal:");
+      const char* Free = strstr(Buf, "SwapFree:");
+      if (Total && Free && strtoull(Total + 10, nullptr, 10) == strtoull(Free + 9, nullptr, 10)) {
+        return; // nothing in swap: mincore sees every page
+      }
+    }
+  }
+  All = true;
+  const int Fd = OpenProc("self/smaps");
+  if (Fd < 0) {
+    return;
+  }
+  constexpr size_t BufSize = 1 << 16;
+  auto* B = static_cast<char*>(::mmap(nullptr, BufSize, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0));
+  auto* P = ::mmap(nullptr, Cap * 2 * sizeof(uint64_t), PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+  if (B == MAP_FAILED || P == MAP_FAILED) {
+    if (B != MAP_FAILED) {
+      ::munmap(B, BufSize);
+    }
+    if (P != MAP_FAILED) {
+      ::munmap(P, Cap * 2 * sizeof(uint64_t));
+    }
+    ::close(Fd);
+    return;
+  }
+  V = static_cast<uint64_t*>(P);
+  size_t Have = 0;
+  uint64_t VStart = 0, VEnd = 0;
+  bool Ok = true;
+  for (;;) {
+    const ssize_t Got = ::read(Fd, B + Have, BufSize - 1 - Have);
+    if (Got < 0 && errno == EINTR) {
+      continue;
+    }
+    if (Got < 0) {
+      Ok = false;
+      break;
+    }
+    Have += size_t(Got);
+    size_t Pos = 0;
+    while (char* NL = static_cast<char*>(memchr(B + Pos, '\n', Have - Pos))) {
+      *NL = 0;
+      const char* Line = B + Pos;
+      Pos = size_t(NL - B) + 1;
+      if ((Line[0] >= '0' && Line[0] <= '9') || (Line[0] >= 'a' && Line[0] <= 'f')) {
+        // a mapping: "start-end perms offset dev inode path"
+        char* E;
+        VStart = strtoull(Line, &E, 16);
+        VEnd = *E == '-' ? strtoull(E + 1, nullptr, 16) : VStart;
+      } else if (!strncmp(Line, "Swap:", 5) && VStart < Window && strtoull(Line + 5, nullptr, 10) > 0) {
+        if (N == Cap) {
+          Ok = false;
+          break;
+        }
+        V[2 * N] = VStart;
+        V[2 * N + 1] = std::min(VEnd, Window);
+        ++N;
+      }
+    }
+    if (!Ok || Got == 0) {
+      break;
+    }
+    if (Pos == 0 && Have == BufSize - 1) {
+      Have = 0; // a line longer than the buffer (a path): none of the lines looked at
+    } else {
+      memmove(B, B + Pos, Have - Pos);
+      Have -= Pos;
+    }
+  }
+  ::close(Fd);
+  ::munmap(B, BufSize);
+  All = !Ok;
+}
