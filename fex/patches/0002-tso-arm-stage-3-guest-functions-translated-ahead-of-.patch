index 9c018bc..8634c53 100644
--- a/Source/Tools/LinuxEmulation/Thunks.cpp
+++ b/Source/Tools/LinuxEmulation/Thunks.cpp
@@ -21,8 +21,19 @@ $end_info$
 #include <FEXCore/fextl/string.h>
