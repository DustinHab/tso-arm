+// tso-arm: FEX's own descriptors that stay open (its server's socket, the root file system's and /proc's directories,
+// the code map, the log) go to a range of their own, just below the limit on open files and far from the small
+// numbers a program uses. They took the lowest free numbers before: a program started with its standard input closed
+// read FEX's server socket as stdin, and a child that checked that a small descriptor it had not inherited was closed
+// found FEX's there and could write into it (CPython's test_cmd_line, test_tempfile, test_posix). The new descriptor
+// is close-on-exec, as all of these are opened, unless one is to live past an execve (KeepOnExec).
+inline int MoveFEXFD(int FD, bool KeepOnExec = false) {
+  if (FD < 0) {
+    return FD;
+  }
+  int Base = 3;
+  struct rlimit Limit {};
+  if (getrlimit(RLIMIT_NOFILE, &Limit) == 0 && Limit.rlim_cur != RLIM_INFINITY && Limit.rlim_cur > 256) {
+    Base = static_cast<int>(std::min<rlim_t>(Limit.rlim_cur, 1 << 20)) - 64;
+  }
+  if (FD >= Base) {
+    return FD;
+  }
+  const int Cmd = KeepOnExec ? F_DUPFD : F_DUPFD_CLOEXEC;
+  int High = fcntl(FD, Cmd, Base);
+  if (High < 0 && FD < 3) {
+    High = fcntl(FD, Cmd, 3);
+  }
+  if (High < 0) {
+    return FD;
+  }
+  close(FD);
+  return High;
