+bool IREmitter::AccessesGuestMemorySince(size_t From) {
+  const uintptr_t ListBegin = DualListData.ListBegin();
+  const uintptr_t DataBegin = DualListData.DataBegin();
+  const auto OpOf = [&](OrderedNodeWrapper W) {
+    return W.GetNode(ListBegin)->Op(DataBegin);
