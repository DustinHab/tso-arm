+    __atomic_store_n(ForkDone, 1, __ATOMIC_RELEASE);
+    ::syscall(SYS_futex, ForkDone, FUTEX_WAKE, INT32_MAX, nullptr, nullptr, 0);
+  }
+  DropForkDone();
+  VLOG("tso-arm: fork: %lu ranges copied (%lu KB) in %.3f ms, %lu read-only ranges shared, swap %s\n", (unsigned long)Copies,
+       (unsigned long)(Bytes >> 10), (Nanos() - T0) / 1e6, (unsigned long)Shared,
+       !Swap.Loaded ? "not looked at" : Swap.All ? "unknown" : Swap.N ? "in use" : "not used");
+}
