+std::string TSOViewMemory::ProfilePathFor(const char* Program) {
+  const char* Env = getenv("TSO_VIEWS_PROFILE");
+  if (Env && !strcmp(Env, "none")) {
+    return {};
+  }
+  if (Env && Env[0]) {
+    return Env;
+  }
+  // Bound to the program file: a rebuilt program gets a new profile. A program of the x86-64 root file system has
+  // its guest path here (/usr/bin/node), which on the host is another program or none: its file is the root file
+  // system's. The name stays the guest path, which does not change when the root file system is mounted elsewhere.
+  // In tso-arm's cache, where `tso-arm status` and `forget` look: $XDG_CACHE_HOME/tso-arm, or ~/.cache/tso-arm
+  const char* Xdg = getenv("XDG_CACHE_HOME");
+  const char* Home = getenv("HOME");
+  const std::string Cache = (Xdg && Xdg[0] == '/') ? std::string(Xdg) : Home ? std::string(Home) + "/.cache" : std::string();
+  if (!Program || Cache.empty()) {
+    return {};
+  }
+  std::string File = Program;
+  if (Program[0] == '/') {
+    auto RootFS = FEXCore::Config::Get(FEXCore::Config::CONFIG_ROOTFS);
+    struct stat R {};
+    if (RootFS && !RootFS.value()->empty() && stat((std::string(RootFS.value()->c_str()) + Program).c_str(), &R) == 0) {
+      File = std::string(RootFS.value()->c_str()) + Program;
+    }
+  }
+  struct stat St {};
+  if (stat(File.c_str(), &St) != 0) {
+    return {};
+  }
+  const std::string Path = Program;
+  uint64_t H = 1469598103934665603ULL;
+  auto Mix = [&H](const void* P, size_t N) {
+    for (size_t i = 0; i < N; ++i) {
+      H = (H ^ static_cast<const uint8_t*>(P)[i]) * 1099511628211ULL;
+    }
+  };
+  Mix(Path.data(), Path.size());
+  Mix(&St.st_size, sizeof(St.st_size));
+  Mix(&St.st_mtim, sizeof(St.st_mtim));
+  char Name[64];
+  snprintf(Name, sizeof(Name), "-%016lx.prof", (unsigned long)H);
+  return Cache + "/tso-arm/" + Path.substr(Path.find_last_of('/') + 1) + Name;
+}
