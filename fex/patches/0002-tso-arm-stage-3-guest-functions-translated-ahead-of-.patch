+    if (R.K != Kind::Private || Start >= Window) {
+      continue;
+    }
+    if (Own) {
+      SetState(Start, R.End, uint8_t(Me));
+    }
+    if (!(R.Prot & PROT_WRITE)) {
+      // Unchanged in both processes until one makes it writable. Without any rights (reservations, guard pages) the
+      // views have none either, whatever the page states say.
+      R.ForkShared = true;
+      ++Shared;
