+    {'t', 's', 'o', '-', 'a', 'r', 'm', ':', 'a', 'o', 't', '-', 'b', 'r', 'i', 'd', 'g', 'e'}};
+
+  // One library of translated functions per guest object: the program (TSO_AOT), and the shared libraries the guest
+  // maps later that have one in TSO_AOT_DIR
+  struct Lib {
+    uint64_t CodeStart, CodeEnd; // its executable range, for the fault handler
+    uint32_t* StubNext;           // room for patch stubs within branch range of its code (ReserveStubs)
+    uint32_t* StubEnd;
+    // Its switches to the ordered variants: of the function a host pc lies in (returns the function's name, or
+    // null), and of all functions
+    const char* (*EscalateFn)(uint64_t PC);
+    void (*OrderAllFn)();
+    std::atomic<bool> OrderedAll;
+    // The guest object's mapping it serves (0, 0 for the program), and its functions, for taking them back when the
+    // guest unmaps it
+    uint64_t GuestStart, GuestEnd, Base;
+    const struct Entry* Table;
+    std::atomic<bool> Gone;
+  };
+  constexpr int MaxLibs = 64;
+  Lib Libs[MaxLibs];
+  std::atomic<int> NumLibs {};
+  std::atomic<bool> OrderAllWanted {}; // set once the process runs fully ordered: libraries loaded later start ordered
+  std::mutex LoadMutex;
+  bool Log {};
+  // A message for the user on the program's standard error, which belongs to the program: only on a terminal, where
+  // a person reads it, or when asked for (TSO_AOT_LOG); a program whose output another reads (a pipe, a test that
+  // wants its standard error empty: CPython's test_threading) never sees one
+  bool Tell() {
+    static const bool Terminal = isatty(2);
+    return Log || Terminal;
+  }
+  std::atomic<int> Logged {};
+
+  Lib* LibOf(uint64_t PC) {
+    const int N = NumLibs.load(std::memory_order_acquire);
+    for (int i = 0; i < N; ++i) {
+      if (PC >= Libs[i].CodeStart && PC < Libs[i].CodeEnd) {
+        return &Libs[i];
+      }
+    }
+    return nullptr;
+  }
+
+  // A call from host code back into guest code that was not translated. RSP is the stack pointer the callee starts
+  // with (pointing at its return address slot); FEX's callback path puts its own return address there.
+  Ret GuestCall(Context* C, uint64_t Target, uint64_t RSP, const uint64_t* Args) {
+    auto* Thread = static_cast<FEXCore::Core::InternalThreadState*>(C->Thread);
+    auto& State = Thread->CurrentFrame->State;
+    if (Log && Logged.fetch_add(1) < 20) {
+      fprintf(stderr, "tso-arm aot: guest call %#lx\n", (unsigned long)Target);
+    }
+    const uint64_t SavedRSP = State.gregs[FEXCore::X86State::REG_RSP];
+    for (int i = 0; i < 6; ++i) {
+      State.gregs[ArgRegs[i]] = Args[i];
+    }
+    State.gregs[FEXCore::X86State::REG_RSP] = RSP + 16;
+    // tso-arm: signals are held back for exact points in the guest code called (SignalInfo::NoHold), and what was
+    // held back meanwhile is released on the way back into code translated ahead of time, which has none
+    const bool OuterNoHold = ThreadObject->SignalInfo.NoHold;
+    ThreadObject->SignalInfo.NoHold = false;
+    Thread->CTX->HandleCallback(Thread, Target);
+    ThreadObject->SignalInfo.NoHold = OuterNoHold;
+    if (OuterNoHold && (ThreadObject->SignalInfo.HeldMask || ThreadObject->SignalInfo.InterruptArmed)) {
+      ThreadObject->SignalInfo.Delegator->ReleaseHeldHere(ThreadObject);
+    }
+    const Ret Result {State.gregs[FEXCore::X86State::REG_RAX], State.gregs[FEXCore::X86State::REG_RDX]};
+    State.gregs[FEXCore::X86State::REG_RSP] = SavedRSP;
+    return Result;
+  }
+
+  // Each thread's own stack for translated code: the stack objects whose addresses the translated code hands out, and
+  // the frames of guest functions it calls. The thread allocates it itself, 2 MiB aligned, alone in its chunk of the
+  // page protocol: it stays private to the thread (the thread stacks themselves often end up shared, next to the
+  // pthread structures other threads touch).
+  constexpr uint64_t StackSize = 2ULL << 20;
+  thread_local uint64_t StackLow {}, StackTop {};
+
+  bool OnOwnStack(uint64_t RSP) {
+    return RSP > StackLow && RSP <= StackTop;
+  }
+
+  void Bridge(void* ArgPtr) {
+    const auto* E = static_cast<const Entry*>(ArgPtr);
+    // tso-arm: into code translated ahead of time, which has no exact points (its guest registers are host
+    // variables): signals that come in while it runs are delivered at once, with the state in memory (NoHold), and
+    // one held back for the next exact point (TSOViews::ExactSignals) is released here, at the call. Waiting for the
+    // function's end, a loop there that waits for the handler's effect never ended (tests/sigspin.c).
+    const bool OuterNoHold = ThreadObject->SignalInfo.NoHold;
+    ThreadObject->SignalInfo.NoHold = true;
+    if (ThreadObject->SignalInfo.HeldMask || ThreadObject->SignalInfo.InterruptArmed) {
+      ThreadObject->SignalInfo.Delegator->ReleaseHeldHere(ThreadObject);
+    }
+    auto* Thread = ThreadObject->Thread;
+    auto* Frame = Thread->CurrentFrame;
+    auto& G = Frame->State.gregs;
+    const uint64_t RSP = G[FEXCore::X86State::REG_RSP];
+    if (!StackTop) {
+      const auto P = reinterpret_cast<uint64_t>(FEX::HLE::_SyscallHandler->GuestMmap(
+        Thread, nullptr, 2 * StackSize, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS | MAP_NORESERVE, -1, 0));
+      if (static_cast<int64_t>(P) < 0 && static_cast<int64_t>(P) > -4096) {
+        ERROR_AND_DIE_FMT("tso-arm aot: no stack for translated code ({})", -static_cast<int64_t>(P));
+      }
+      StackLow = (P + StackSize - 1) & ~(StackSize - 1);
+      StackTop = StackLow + StackSize;
+    }
+    // Nested (translated code called guest code that called translated code again): continue below the caller
+    const uint64_t Stack = OnOwnStack(RSP) ? RSP : StackTop - 64;
+    uint64_t Args[6];
+    for (int i = 0; i < 6; ++i) {
+      Args[i] = G[ArgRegs[i]];
+    }
+    const uint64_t View = Frame->TSOViewBase;
+    Context C {reinterpret_cast<uint8_t*>(View), Frame->State.fs_cached, GuestCall, Thread,
+               reinterpret_cast<uint8_t*>(View ? View | FEXCore::TSOViews::OrderedBit : 0)};
+    // While the host code runs, the guest stack pointer in the context stays below anything in use, so that nothing
+    // put there meanwhile (a guest signal frame) overwrites it
+    G[FEXCore::X86State::REG_RSP] = OnOwnStack(RSP) ? RSP - 65536 : RSP - 4096;
+    const Ret Result = E->Fn(&C, RSP, Stack, Args);
+    G[FEXCore::X86State::REG_RAX] = Result.RAX;
+    G[FEXCore::X86State::REG_RDX] = Result.RDX;
+    Frame->State.rip = *reinterpret_cast<const uint64_t*>(RSP);
+    G[FEXCore::X86State::REG_RSP] = RSP + 8;
+    ThreadObject->SignalInfo.NoHold = OuterNoHold;
+  }
+
+  // Reads guest memory without faulting on an unmapped address
+  bool ReadGuest(uint64_t Address, void* Out, size_t Size) {
+    iovec Local {Out, Size};
+    iovec Remote {reinterpret_cast<void*>(Address), Size};
+    return process_vm_readv(getpid(), &Local, 1, &Remote, 1, 0) == static_cast<ssize_t>(Size);
+  }
+
+  uint64_t Hash(const uint8_t* P, size_t N) {
+    uint64_t H = 0xcbf29ce484222325ULL;
+    for (size_t i = 0; i < N; ++i) {
+      H = (H ^ P[i]) * 0x100000001b3ULL;
+    }
+    return H;
+  }
+
+  // An x86-64 ELF file of the guest: its headers, and the name `tso-arm learn` keeps its library under, the file's
+  // real name and the first 8 bytes of its build ID (empty without a build ID)
+  struct Object {
+    Elf64_Ehdr Eh;
+    Elf64_Phdr Ph[64];
+    char Key[320];
+  };
+
+  bool ReadObject(int Fd, Object& O) {
+    O.Key[0] = 0;
+    auto& Eh = O.Eh;
+    if (pread(Fd, &Eh, sizeof(Eh), 0) != sizeof(Eh) || memcmp(Eh.e_ident, ELFMAG, SELFMAG) || Eh.e_ident[EI_CLASS] != ELFCLASS64 ||
+        Eh.e_machine != EM_X86_64 || Eh.e_phentsize != sizeof(Elf64_Phdr) || Eh.e_phnum == 0 || Eh.e_phnum > 64) {
+      return false;
+    }
+    if (pread(Fd, O.Ph, Eh.e_phnum * sizeof(Elf64_Phdr), Eh.e_phoff) != ssize_t(Eh.e_phnum * sizeof(Elf64_Phdr))) {
+      return false;
+    }
+    char Id[17] {};
+    for (int i = 0; i < Eh.e_phnum && !Id[0]; ++i) {
+      const auto& P = O.Ph[i];
+      uint8_t Notes[4096];
+      if (P.p_type != PT_NOTE || P.p_filesz > sizeof(Notes) || pread(Fd, Notes, P.p_filesz, P.p_offset) != ssize_t(P.p_filesz)) {
+        continue;
+      }
+      for (uint64_t At = 0; At + sizeof(Elf64_Nhdr) <= P.p_filesz;) {
+        const auto* H = reinterpret_cast<const Elf64_Nhdr*>(Notes + At);
+        const uint64_t Name = At + sizeof(Elf64_Nhdr), Desc = Name + ((H->n_namesz + 3) & ~3u);
+        if (Desc + H->n_descsz > P.p_filesz) {
+          break;
+        }
+        if (H->n_type == NT_GNU_BUILD_ID && H->n_namesz == 4 && !memcmp(Notes + Name, "GNU", 4) && H->n_descsz >= 8) {
+          for (int b = 0; b < 8; ++b) {
+            snprintf(Id + 2 * b, 3, "%02x", Notes[Desc + b]);
+          }
+          break;
+        }
+        At = Desc + ((H->n_descsz + 3) & ~3u);
+      }
+    }
+    char Link[64], File[4096];
+    snprintf(Link, sizeof(Link), "/proc/self/fd/%d", Fd);
+    const ssize_t N = readlink(Link, File, sizeof(File) - 1);
+    if (Id[0] && N > 0) {
+      File[N] = 0;
+      const char* Name = strrchr(File, '/');
+      snprintf(O.Key, sizeof(O.Key), "%.280s-%s", Name ? Name + 1 : File, Id);
+    }
+    return true;
+  }
+
+  bool Listed(const char* List, const char* Name) {
+    const size_t N = strlen(Name);
+    for (const char* P = List; *P;) {
+      const char* End = strchr(P, ',');
+      const size_t L = End ? size_t(End - P) : strlen(P);
+      if (L == N && !strncmp(P, Name, N)) {
+        return true;
+      }
+      if (!End) {
+        break;
+      }
+      P = End + 1;
+    }
+    return false;
+  }
+} // namespace AOT
+
+bool IsAOTCode(uint64_t PC) {
+  return AOT::LibOf(PC) != nullptr;
+}
+
+
+// A plain access of translated code met a page another thread writes. Like FEX's escalation of a guest
+// instruction, only this access becomes ordered: the instruction is replaced by a branch to a stub that computes its
+// address, performs it through the ordered view (the address with bit 38 set: plain view | OrderedBit), as ldapr or
+// between barriers, `dmb ishld` after a load and `dmb ish` before a store (x86 order: loads acquire, stores
+// release), and branches back. Host addresses (bit 38 already set: stack objects kept in host memory) take the
+// instruction unchanged.
+// Returns false when the instruction is not one it can patch (the caller switches the whole function instead).
+namespace AOT {
+  constexpr uint32_t DmbIshld = 0xD50339BF, DmbIsh = 0xD5033BBF;
+  std::atomic<bool> PatchLock {};
+  std::atomic<uint64_t> Patched {};
+
+  uint32_t Branch(const void* From, const void* To) {
+    const int64_t Off = reinterpret_cast<const uint8_t*>(To) - reinterpret_cast<const uint8_t*>(From);
+    return 0x14000000 | ((Off >> 2) & 0x3FFFFFF);
+  }
+
+  enum class PatchResult { Done, Busy, Impossible };
+
+  PatchResult Patch(uint64_t PC, uint32_t Insn) {
+    // Loads and stores with a base register: unsigned offset, register offset, unscaled, pre/post index, pairs
+    const bool UImm = (Insn & 0x3b000000) == 0x39000000;
+    const bool RegOffset = (Insn & 0x3b200c00) == 0x38200800;
+    const bool Unscaled = (Insn & 0x3b200c00) == 0x38000000;
+    const bool PrePost = (Insn & 0x3b200400) == 0x38000400;
+    const bool Pair = (Insn & 0x3a000000) == 0x28000000;
+    if (!(UImm || RegOffset || Unscaled || PrePost || Pair)) {
+      return PatchResult::Impossible;
+    }
+    const bool Vec = Insn & (1u << 26);
+    const uint32_t Rn = (Insn >> 5) & 31, Rt = Insn & 31, Rt2 = (Insn >> 10) & 31, Rm = (Insn >> 16) & 31;
+    if (Rn == 31) {
+      return PatchResult::Impossible; // sp: the host stack
+    }
+    const uint32_t PairMode = (Insn >> 23) & 3; // 1 post-index, 3 pre-index, 0 and 2 signed offset
+    const bool Writeback = PrePost || (Pair && (PairMode == 1 || PairMode == 3));
+    const bool Load = (Pair || Vec) ? (Insn & (1u << 22)) != 0 : ((Insn >> 22) & 3) != 0;
+    const bool BaseIsData = !Vec && (Rt == Rn || (Pair && Rt2 == Rn));
+    if (Writeback && BaseIsData) {
+      return PatchResult::Impossible; // unpredictable on Arm
+    }
+    // The access's address relative to its base register: an immediate, or a register (extended, shifted)
+    const uint32_t Size = Insn >> 30, Opc = (Insn >> 22) & 3;
+    int64_t Off = 0, Step = 0; // Step: the base's writeback
+    if (UImm) {
+      const uint32_t Scale = Vec && (Opc & 2) ? 4 : Size;
+      Off = int64_t((Insn >> 10) & 0xFFF) << Scale;
+    } else if (Unscaled || PrePost) {
+      const int64_t Imm9 = int32_t(((Insn >> 12) & 0x1FF) << 23) >> 23;
+      Step = PrePost ? Imm9 : 0;
+      Off = PrePost && !((Insn >> 11) & 1) ? 0 : Imm9; // post-index: the access at the base itself
+    } else if (Pair) {
+      const uint32_t Scale = Vec ? 2 + Size : (Size & 2 ? 3 : 2);
+      const int64_t Imm = int64_t(int32_t(((Insn >> 15) & 0x7F) << 25) >> 25) * (int64_t(1) << Scale);
+      Step = Writeback ? Imm : 0;
+      Off = PairMode == 1 ? 0 : Imm;
+    }
+
+    Lib* L = LibOf(PC);
+    if (!L) {
+      return PatchResult::Impossible;
+    }
+    bool Expected = false;
+    if (!PatchLock.compare_exchange_strong(Expected, true)) {
+      return PatchResult::Busy; // another thread is patching: complete this access only
+    }
+    auto* Site = reinterpret_cast<uint32_t*>(PC);
+    PatchResult Result = PatchResult::Impossible;
+    if (__atomic_load_n(Site, __ATOMIC_RELAXED) == Insn) {
+      constexpr int Words = 20;
+      // TSO_AOT_PATCH_MAX=N: only the first N sites are patched, later ones switch their function (for bisecting)
+      static const long PatchMax = getenv("TSO_AOT_PATCH_MAX") ? strtol(getenv("TSO_AOT_PATCH_MAX"), nullptr, 10) : -1;
+      if (!L->StubNext || L->StubEnd - L->StubNext < Words ||
+          (PatchMax >= 0 && Patched.load(std::memory_order_relaxed) >= uint64_t(PatchMax))) {
+        PatchLock.store(false);
+        return PatchResult::Impossible; // no (more) room for stubs
+      }
+      uint32_t* S = L->StubNext;
+      const void* Back = Site + 1;
+      int K = 0;
+      // Dst = Src +- A (add/sub immediate, A below 2^24)
+      auto AddImm = [&](uint32_t Dst, uint32_t Src, int64_t A) {
+        const uint32_t Op = A >= 0 ? 0x91000000 : 0xD1000000;
+        uint64_t U = A >= 0 ? uint64_t(A) : uint64_t(-A);
+        if (U >= 4096) {
+          S[K++] = Op | 0x400000 | (uint32_t(U >> 12) << 10) | (Src << 5) | Dst;
+          Src = Dst;
+          U &= 0xFFF;
+          if (!U) {
+            return;
+          }
+        }
+        S[K++] = Op | (uint32_t(U) << 10) | (Src << 5) | Dst;
+      };
+      // Dst = the access's address
+      auto Address = [&](uint32_t Dst) {
+        if (RegOffset) {
+          const uint32_t Option = (Insn >> 13) & 7, Shift = ((Insn >> 12) & 1) ? (Vec && (Opc & 2) ? 4 : Size) : 0;
+          S[K++] = 0x8B200000 | (Rm << 16) | (Option << 13) | (Shift << 10) | (Rn << 5) | Dst; // add (extended)
+        } else {
+          AddImm(Dst, Rn, Off);
+        }
+      };
+      // The instruction with Base as its base register and no offset (a pair: signed offset 0)
+      auto AtBase = [&](uint32_t Base) {
+        if (Pair) {
+          return (Insn & ~((3u << 23) | (0x7Fu << 15) | (31u << 5))) | (2u << 23) | (Base << 5);
+        }
+        return (Insn & 0xC4C00000) | 0x39000000 | (Base << 5) | Rt;
+      };
+      auto Tbnz = [&](uint32_t R, uint32_t Bit, int At, int Target) {
+        return (Bit >= 32 ? 0xB7000000 : 0x37000000) | ((Bit & 31) << 19) | (uint32_t((Target - At) & 0x3FFF) << 5) | R;
+      };
+      // Whether the access goes to guest memory is told by its address: the plain views lie below 2^38
+      // (OrderedBit), everything at or above is a host address (a stack object kept in host memory, reached relative
+      // to the plain view, or an ordered view), which takes the instruction unchanged. Not by the base or the offset
+      // register alone: either may hold a negative part of the address. With 39-bit addresses that is bit 38 alone
+      // (one tbnz); with more (48 bits: host stacks at 0xffff8... have bit 38 clear) the address is shifted right by
+      // 38 into the register that held it and tested with cbnz, then computed again. Neither touches the flags.
+      // TSO_AOT_WIDE=1 takes the second form on any host (for testing it on a 39-bit one).
+      static const bool Narrow = [] {
+        if (FEXCore::TSOViews::Knob("TSO_AOT_WIDE")) {
+          return false;
+        }
+        void* P = ::mmap(reinterpret_cast<void*>(1ULL << 40), 4096, PROT_NONE,
+                         MAP_PRIVATE | MAP_ANONYMOUS | MAP_NORESERVE | MAP_FIXED_NOREPLACE, -1, 0);
+        if (P != MAP_FAILED) {
+          ::munmap(P, 4096);
+          return false;
+        }
+        return errno == ENOMEM; // beyond the address space: at most 40 bits (EEXIST: taken, so it exists)
+      }();
+      // Branches to Plain when the address in R is a host address; R may be clobbered on the way and is the address
+      // again where it falls through (Again computes it into R)
+      auto HostTest = [&](uint32_t R, auto Again) {
+        if (Narrow) {
+          return K++; // tbnz R, #38, Plain
+        }
+        S[K++] = 0xD340FC00 | (38u << 16) | (R << 5) | R; // lsr R, R, #38
+        const int At = K++;                                // cbnz R, Plain
+        Again(R);
+        return At;
+      };
+      auto HostBranch = [&](uint32_t R, int At, int Target) {
+        return Narrow ? Tbnz(R, 38, At, Target) : (0xB5000000 | (uint32_t((Target - At) & 0x7FFFF) << 5) | R);
+      };
+
+      // TSO_AOT_NOFAST=1: every load takes the general path (for finding a stub that goes wrong)
+      static const bool NoFast = FEXCore::TSOViews::Knob("TSO_AOT_NOFAST");
+      const bool Fast = !NoFast && Load && !Vec && !Pair && !Writeback && Rt != 31 && Rt != Rn && !(RegOffset && Rt == Rm) &&
+                        Opc != 0 && !(Size == 3 && Opc >= 2) && !(Size == 2 && Opc == 3);
+      if (Fast) {
+        // Integer loads: the address goes into the destination register; aligned, the load is ldapr through the
+        // ordered view (as cheap as a plain load on the A76), unaligned the instruction there followed by dmb ishld.
+        // The alignment tests use tbnz: the translated code may hold a comparison's flags across the load
+        Address(Rt);
+        const int ToPlain = HostTest(Rt, Address);
+        S[K++] = 0xB25A0000 | (Rt << 5) | Rt; // orr xt, xt, #1<<38
+        int AlignAt[3] = {-1, -1, -1};
+        for (uint32_t Bit = 0; Bit < Size; ++Bit) {
+          AlignAt[Bit] = K++;
+        }
+        // ldapr needs FEAT_LRCPC (Cortex-A55, A75, A76 and later); older cores get ldar, which orders at least as
+        // strongly (TSO_AOT_NORCPC=1 forces it, for testing)
+        static const bool RCpc = !FEXCore::TSOViews::Knob("TSO_AOT_NORCPC") && (getauxval(AT_HWCAP) & (1UL << 15)); // HWCAP_LRCPC
+        static constexpr uint32_t Ldapr[4] = {0x38BFC000, 0x78BFC000, 0xB8BFC000, 0xF8BFC000};
+        static constexpr uint32_t Ldar[4] = {0x08DFFC00, 0x48DFFC00, 0x88DFFC00, 0xC8DFFC00};
+        S[K++] = (RCpc ? Ldapr[Size] : Ldar[Size]) | (Rt << 5) | Rt;
+        if (Opc == 2) { // sign-extended to 64 bits
+          static constexpr uint32_t Sx[3] = {0x93401C00, 0x93403C00, 0x93407C00};
+          S[K++] = Sx[Size] | (Rt << 5) | Rt;
+        } else if (Opc == 3) { // sign-extended to 32 bits
+          S[K++] = (Size == 0 ? 0x13001C00 : 0x13003C00) | (Rt << 5) | Rt;
+        }
+        S[K] = Branch(&S[K], Back);
+        ++K;
+        const int Unaligned = K;
+        for (uint32_t Bit = 0; Bit < 3; ++Bit) {
+          if (AlignAt[Bit] >= 0) {
+            S[AlignAt[Bit]] = Tbnz(Rt, Bit, AlignAt[Bit], Unaligned);
+          }
+        }
+        S[K++] = AtBase(Rt);
+        S[K++] = DmbIshld;
+        S[K] = Branch(&S[K], Back);
+        ++K;
+        const int Plain = K;
+        S[ToPlain] = HostBranch(Rt, ToPlain, Plain);
+        S[K++] = Insn;
+        S[K] = Branch(&S[K], Back);
+        ++K;
+      } else {
+        // Everything else: a scratch register, saved on the host stack, takes the address; the instruction runs
+        // with it as its base (dmb ish before a store, dmb ishld after a load), then the base's writeback
+        uint32_t X = 31;
+        for (uint32_t R : {16u, 17u, 9u, 10u, 11u, 12u, 13u, 14u, 15u}) {
+          if (R != Rn && !(RegOffset && R == Rm) && R != Rt && !(Pair && R == Rt2)) {
+            X = R;
+            break;
+          }
+        }
+        S[K++] = 0xF81F0FE0 | X; // str x, [sp, #-16]!
+        Address(X);
+        const int ToPlain = HostTest(X, Address);
+        S[K++] = 0xB25A0000 | (X << 5) | X; // orr x, x, #1<<38
+        if (!Load) {
+          S[K++] = DmbIsh;
+        }
+        S[K++] = AtBase(X);
+        if (Load) {
+          S[K++] = DmbIshld;
+        }
+        S[K++] = 0xF84107E0 | X; // ldr x, [sp], #16
+        if (Step) {
+          AddImm(Rn, Rn, Step);
+        }
+        S[K] = Branch(&S[K], Back);
+        ++K;
+        const int Plain = K;
+        S[ToPlain] = HostBranch(X, ToPlain, Plain);
