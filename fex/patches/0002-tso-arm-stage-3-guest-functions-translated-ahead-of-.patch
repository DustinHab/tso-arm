@@ -510,6 +518,19 @@ void Dispatcher::EmitDispatcher() {
     // First thing we need to move the thread state pointer back in to our register
     mov(STATE, ARMEmitter::XReg::x0);
 
+#ifndef ARCHITECTURE_arm64ec
+    // tso-arm: x25 belongs to the host code that calls back (callee-saved, it may hold anything here); the call-ret
+    // stack pointer comes from the thunk call that left the JIT
+    ldr(REG_CALLRET_SP, STATE_PTR(CpuStateFrame, State.callret_sp));
+
+    // tso-arm: this loop's stack pointer, for re-entries at the loop top from signal handlers; the outer loop's value
+    // is kept on the stack and restored by CallbackReturn
+    ldr(ARMEmitter::XReg::x3, STATE_PTR(CpuStateFrame, DispatchSP));
+    stp<ARMEmitter::IndexType::PRE>(ARMEmitter::XReg::x3, ARMEmitter::XReg::zr, ARMEmitter::XReg::rsp, -0x10);
+    add(ARMEmitter::Size::i64Bit, ARMEmitter::Reg::r3, ARMEmitter::Reg::rsp, 0);
+    str(ARMEmitter::XReg::x3, STATE_PTR(CpuStateFrame, DispatchSP));
+#endif
+
