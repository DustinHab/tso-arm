+  // tso-arm: a guest address in exactly Moves instructions (movz and a movk for each further non-zero 16 bits, nop
+  // after them), so that a relocation can put another address of no more parts there; MoveParts counts them (at least
+  // one). A relocated guest address keeps its number in bits 5 to 7 of its register index (RelocGuestRIP).
+  static int MoveParts(uint64_t Constant) {
+    int Parts = 0;
+    for (int i = 0; i < 4; ++i) {
+      Parts += ((Constant >> (i * 16)) & 0xFFFF) != 0;
+    }
+    return Parts ? Parts : 1;
