@@ -182,6 +182,14 @@ public:
    */
   FEX_DEFAULT_VISIBILITY virtual void AddThunkTrampolineIRHandler(uintptr_t Entrypoint, uintptr_t GuestThunkEntrypoint) = 0;
 
+  /**
+   * @brief tso-arm: routes calls of the guest function at Entrypoint to host code translated ahead of time
+   *
+   * The block for Entrypoint calls the thunk Bridge with Hook as its argument. The bridge runs the function and
+   * performs its return: it sets RAX and RSP and leaves the return address in the context's rip.
+   */
+  FEX_DEFAULT_VISIBILITY virtual void AddAOTEntrypoint(uintptr_t Entrypoint, uintptr_t Hook, const IR::SHA256Sum& Bridge) = 0;
+
   /**
    * @brief Adds additional per-instruction granularity TSO enable/disable information for the given range.
    *
diff --git a/FEXCore/include/FEXCore/Core/CoreState.h b/FEXCore/include/FEXCore/Core/CoreState.h
index 19ae82f..4e6a385 100644
--- a/FEXCore/include/FEXCore/Core/CoreState.h
+++ b/FEXCore/include/FEXCore/Core/CoreState.h
@@ -477,6 +477,11 @@ struct CpuStateFrame {
   // tso-arm: base of this thread's plain view of guest memory (0 when views are off)
   uint64_t TSOViewBase {};
 
+  // tso-arm: host stack pointer of the dispatcher loop that runs now (the outer one, or the one of a callback from
+  // host code into guest code). A signal handler that sends the thread back to the loop top from inside a block
+  // leaves the block's spill area on the stack; the loop top resets the stack pointer to this value.
