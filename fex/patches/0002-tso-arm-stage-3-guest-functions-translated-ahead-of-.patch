+
+// A plain access of translated code met a page another thread writes. Like FEX's escalation of a guest
+// instruction, only this access becomes ordered: the instruction is replaced by a branch to a stub that computes its
+// address, performs it through the ordered view (the address with bit 38 set: plain view | OrderedBit), as ldapr or
+// between barriers, `dmb ishld` after a load and `dmb ish` before a store (x86 order: loads acquire, stores
+// release), and branches back. Host addresses (bit 38 already set: stack objects kept in host memory) take the
+// instruction unchanged.
+// Returns false when the instruction is not one it can patch (the caller switches the whole function instead).
+namespace AOT {
+  constexpr uint32_t DmbIshld = 0xD50339BF, DmbIsh = 0xD5033BBF;
+  std::atomic<bool> PatchLock {};
+  std::atomic<uint64_t> Patched {};
+
+  uint32_t Branch(const void* From, const void* To) {
+    const int64_t Off = reinterpret_cast<const uint8_t*>(To) - reinterpret_cast<const uint8_t*>(From);
+    return 0x14000000 | ((Off >> 2) & 0x3FFFFFF);
+  }
+
+  enum class PatchResult { Done, Busy, Impossible };
+
+  PatchResult Patch(uint64_t PC, uint32_t Insn) {
+    // Loads and stores with a base register: unsigned offset, register offset, unscaled, pre/post index, pairs
+    const bool UImm = (Insn & 0x3b000000) == 0x39000000;
+    const bool RegOffset = (Insn & 0x3b200c00) == 0x38200800;
+    const bool Unscaled = (Insn & 0x3b200c00) == 0x38000000;
+    const bool PrePost = (Insn & 0x3b200400) == 0x38000400;
+    const bool Pair = (Insn & 0x3a000000) == 0x28000000;
+    if (!(UImm || RegOffset || Unscaled || PrePost || Pair)) {
+      return PatchResult::Impossible;
+    }
+    const bool Vec = Insn & (1u << 26);
+    const uint32_t Rn = (Insn >> 5) & 31, Rt = Insn & 31, Rt2 = (Insn >> 10) & 31, Rm = (Insn >> 16) & 31;
+    if (Rn == 31) {
+      return PatchResult::Impossible; // sp: the host stack
+    }
+    const uint32_t PairMode = (Insn >> 23) & 3; // 1 post-index, 3 pre-index, 0 and 2 signed offset
+    const bool Writeback = PrePost || (Pair && (PairMode == 1 || PairMode == 3));
+    const bool Load = (Pair || Vec) ? (Insn & (1u << 22)) != 0 : ((Insn >> 22) & 3) != 0;
+    const bool BaseIsData = !Vec && (Rt == Rn || (Pair && Rt2 == Rn));
+    if (Writeback && BaseIsData) {
+      return PatchResult::Impossible; // unpredictable on Arm
+    }
+    // The access's address relative to its base register: an immediate, or a register (extended, shifted)
+    const uint32_t Size = Insn >> 30, Opc = (Insn >> 22) & 3;
+    int64_t Off = 0, Step = 0; // Step: the base's writeback
+    if (UImm) {
+      const uint32_t Scale = Vec && (Opc & 2) ? 4 : Size;
+      Off = int64_t((Insn >> 10) & 0xFFF) << Scale;
+    } else if (Unscaled || PrePost) {
+      const int64_t Imm9 = int32_t(((Insn >> 12) & 0x1FF) << 23) >> 23;
+      Step = PrePost ? Imm9 : 0;
+      Off = PrePost && !((Insn >> 11) & 1) ? 0 : Imm9; // post-index: the access at the base itself
+    } else if (Pair) {
+      const uint32_t Scale = Vec ? 2 + Size : (Size & 2 ? 3 : 2);
+      const int64_t Imm = int64_t(int32_t(((Insn >> 15) & 0x7F) << 25) >> 25) * (int64_t(1) << Scale);
+      Step = Writeback ? Imm : 0;
+      Off = PairMode == 1 ? 0 : Imm;
+    }
+
+    Lib* L = LibOf(PC);
+    if (!L) {
+      return PatchResult::Impossible;
+    }
+    bool Expected = false;
+    if (!PatchLock.compare_exchange_strong(Expected, true)) {
+      return PatchResult::Busy; // another thread is patching: complete this access only
+    }
+    auto* Site = reinterpret_cast<uint32_t*>(PC);
+    PatchResult Result = PatchResult::Impossible;
+    if (__atomic_load_n(Site, __ATOMIC_RELAXED) == Insn) {
+      constexpr int Words = 20;
+      // TSO_AOT_PATCH_MAX=N: only the first N sites are patched, later ones switch their function (for bisecting)
+      static const long PatchMax = getenv("TSO_AOT_PATCH_MAX") ? strtol(getenv("TSO_AOT_PATCH_MAX"), nullptr, 10) : -1;
+      if (!L->StubNext || L->StubEnd - L->StubNext < Words ||
+          (PatchMax >= 0 && Patched.load(std::memory_order_relaxed) >= uint64_t(PatchMax))) {
+        PatchLock.store(false);
+        return PatchResult::Impossible; // no (more) room for stubs
+      }
+      uint32_t* S = L->StubNext;
+      const void* Back = Site + 1;
+      int K = 0;
+      // Dst = Src +- A (add/sub immediate, A below 2^24)
+      auto AddImm = [&](uint32_t Dst, uint32_t Src, int64_t A) {
+        const uint32_t Op = A >= 0 ? 0x91000000 : 0xD1000000;
+        uint64_t U = A >= 0 ? uint64_t(A) : uint64_t(-A);
+        if (U >= 4096) {
+          S[K++] = Op | 0x400000 | (uint32_t(U >> 12) << 10) | (Src << 5) | Dst;
+          Src = Dst;
+          U &= 0xFFF;
+          if (!U) {
+            return;
+          }
+        }
+        S[K++] = Op | (uint32_t(U) << 10) | (Src << 5) | Dst;
+      };
+      // Dst = the access's address
+      auto Address = [&](uint32_t Dst) {
+        if (RegOffset) {
+          const uint32_t Option = (Insn >> 13) & 7, Shift = ((Insn >> 12) & 1) ? (Vec && (Opc & 2) ? 4 : Size) : 0;
+          S[K++] = 0x8B200000 | (Rm << 16) | (Option << 13) | (Shift << 10) | (Rn << 5) | Dst; // add (extended)
+        } else {
+          AddImm(Dst, Rn, Off);
+        }
+      };
+      // The instruction with Base as its base register and no offset (a pair: signed offset 0)
+      auto AtBase = [&](uint32_t Base) {
+        if (Pair) {
+          return (Insn & ~((3u << 23) | (0x7Fu << 15) | (31u << 5))) | (2u << 23) | (Base << 5);
+        }
+        return (Insn & 0xC4C00000) | 0x39000000 | (Base << 5) | Rt;
+      };
+      auto Tbnz = [&](uint32_t R, uint32_t Bit, int At, int Target) {
+        return (Bit >= 32 ? 0xB7000000 : 0x37000000) | ((Bit & 31) << 19) | (uint32_t((Target - At) & 0x3FFF) << 5) | R;
+      };
+      // Whether the access goes to guest memory is told by its address: the plain views lie below 2^38
+      // (OrderedBit), everything at or above is a host address (a stack object kept in host memory, reached relative
+      // to the plain view, or an ordered view), which takes the instruction unchanged. Not by the base or the offset
+      // register alone: either may hold a negative part of the address. With 39-bit addresses that is bit 38 alone
+      // (one tbnz); with more (48 bits: host stacks at 0xffff8... have bit 38 clear) the address is shifted right by
+      // 38 into the register that held it and tested with cbnz, then computed again. Neither touches the flags.
+      // TSO_AOT_WIDE=1 takes the second form on any host (for testing it on a 39-bit one).
+      static const bool Narrow = [] {
+        if (FEXCore::TSOViews::Knob("TSO_AOT_WIDE")) {
+          return false;
+        }
+        void* P = ::mmap(reinterpret_cast<void*>(1ULL << 40), 4096, PROT_NONE,
+                         MAP_PRIVATE | MAP_ANONYMOUS | MAP_NORESERVE | MAP_FIXED_NOREPLACE, -1, 0);
+        if (P != MAP_FAILED) {
+          ::munmap(P, 4096);
+          return false;
+        }
+        return errno == ENOMEM; // beyond the address space: at most 40 bits (EEXIST: taken, so it exists)
+      }();
+      // Branches to Plain when the address in R is a host address; R may be clobbered on the way and is the address
+      // again where it falls through (Again computes it into R)
+      auto HostTest = [&](uint32_t R, auto Again) {
+        if (Narrow) {
+          return K++; // tbnz R, #38, Plain
+        }
+        S[K++] = 0xD340FC00 | (38u << 16) | (R << 5) | R; // lsr R, R, #38
+        const int At = K++;                                // cbnz R, Plain
+        Again(R);
+        return At;
+      };
+      auto HostBranch = [&](uint32_t R, int At, int Target) {
+        return Narrow ? Tbnz(R, 38, At, Target) : (0xB5000000 | (uint32_t((Target - At) & 0x7FFFF) << 5) | R);
+      };
+
+      // TSO_AOT_NOFAST=1: every load takes the general path (for finding a stub that goes wrong)
+      static const bool NoFast = FEXCore::TSOViews::Knob("TSO_AOT_NOFAST");
+      const bool Fast = !NoFast && Load && !Vec && !Pair && !Writeback && Rt != 31 && Rt != Rn && !(RegOffset && Rt == Rm) &&
+                        Opc != 0 && !(Size == 3 && Opc >= 2) && !(Size == 2 && Opc == 3);
+      if (Fast) {
+        // Integer loads: the address goes into the destination register; aligned, the load is ldapr through the
+        // ordered view (as cheap as a plain load on the A76), unaligned the instruction there followed by dmb ishld.
+        // The alignment tests use tbnz: the translated code may hold a comparison's flags across the load
+        Address(Rt);
+        const int ToPlain = HostTest(Rt, Address);
+        S[K++] = 0xB25A0000 | (Rt << 5) | Rt; // orr xt, xt, #1<<38
+        int AlignAt[3] = {-1, -1, -1};
+        for (uint32_t Bit = 0; Bit < Size; ++Bit) {
+          AlignAt[Bit] = K++;
+        }
+        // ldapr needs FEAT_LRCPC (Cortex-A55, A75, A76 and later); older cores get ldar, which orders at least as
+        // strongly (TSO_AOT_NORCPC=1 forces it, for testing)
+        static const bool RCpc = !FEXCore::TSOViews::Knob("TSO_AOT_NORCPC") && (getauxval(AT_HWCAP) & (1UL << 15)); // HWCAP_LRCPC
+        static constexpr uint32_t Ldapr[4] = {0x38BFC000, 0x78BFC000, 0xB8BFC000, 0xF8BFC000};
+        static constexpr uint32_t Ldar[4] = {0x08DFFC00, 0x48DFFC00, 0x88DFFC00, 0xC8DFFC00};
+        S[K++] = (RCpc ? Ldapr[Size] : Ldar[Size]) | (Rt << 5) | Rt;
+        if (Opc == 2) { // sign-extended to 64 bits
+          static constexpr uint32_t Sx[3] = {0x93401C00, 0x93403C00, 0x93407C00};
+          S[K++] = Sx[Size] | (Rt << 5) | Rt;
+        } else if (Opc == 3) { // sign-extended to 32 bits
+          S[K++] = (Size == 0 ? 0x13001C00 : 0x13003C00) | (Rt << 5) | Rt;
+        }
+        S[K] = Branch(&S[K], Back);
+        ++K;
+        const int Unaligned = K;
+        for (uint32_t Bit = 0; Bit < 3; ++Bit) {
+          if (AlignAt[Bit] >= 0) {
+            S[AlignAt[Bit]] = Tbnz(Rt, Bit, AlignAt[Bit], Unaligned);
+          }
+        }
+        S[K++] = AtBase(Rt);
+        S[K++] = DmbIshld;
+        S[K] = Branch(&S[K], Back);
+        ++K;
+        const int Plain = K;
+        S[ToPlain] = HostBranch(Rt, ToPlain, Plain);
+        S[K++] = Insn;
+        S[K] = Branch(&S[K], Back);
+        ++K;
+      } else {
+        // Everything else: a scratch register, saved on the host stack, takes the address; the instruction runs
+        // with it as its base (dmb ish before a store, dmb ishld after a load), then the base's writeback
+        uint32_t X = 31;
+        for (uint32_t R : {16u, 17u, 9u, 10u, 11u, 12u, 13u, 14u, 15u}) {
+          if (R != Rn && !(RegOffset && R == Rm) && R != Rt && !(Pair && R == Rt2)) {
+            X = R;
+            break;
+          }
+        }
+        S[K++] = 0xF81F0FE0 | X; // str x, [sp, #-16]!
+        Address(X);
+        const int ToPlain = HostTest(X, Address);
+        S[K++] = 0xB25A0000 | (X << 5) | X; // orr x, x, #1<<38
+        if (!Load) {
+          S[K++] = DmbIsh;
+        }
+        S[K++] = AtBase(X);
+        if (Load) {
+          S[K++] = DmbIshld;
+        }
+        S[K++] = 0xF84107E0 | X; // ldr x, [sp], #16
+        if (Step) {
+          AddImm(Rn, Rn, Step);
+        }
+        S[K] = Branch(&S[K], Back);
+        ++K;
+        const int Plain = K;
+        S[ToPlain] = HostBranch(X, ToPlain, Plain);
+        S[K++] = 0xF84107E0 | X;
+        S[K++] = Insn;
+        S[K] = Branch(&S[K], Back);
+        ++K;
+      }
+      __builtin___clear_cache(reinterpret_cast<char*>(S), reinterpret_cast<char*>(S + Words));
+      L->StubNext += Words;
+      // The library's code page writable for the one word (a private mapping: copy on write)
+      const uint64_t Page = PC & ~4095ULL;
+      if (::mprotect(reinterpret_cast<void*>(Page), 4096, PROT_READ | PROT_WRITE | PROT_EXEC) == 0) {
+        __atomic_store_n(Site, Branch(Site, S), __ATOMIC_RELEASE);
+        __builtin___clear_cache(reinterpret_cast<char*>(Site), reinterpret_cast<char*>(Site + 1));
+        ::mprotect(reinterpret_cast<void*>(Page), 4096, PROT_READ | PROT_EXEC);
+        Result = PatchResult::Done;
+        Patched.fetch_add(1, std::memory_order_relaxed);
+        if (Log) {
+          fprintf(stderr, "tso-arm aot: patched %s at library+%#lx (stub %#lx)\n", Load ? "load" : "store",
+                  (unsigned long)(PC - L->CodeStart), (unsigned long)reinterpret_cast<uint64_t>(S));
+        }
+      }
+    } else {
+      Result = PatchResult::Done; // patched meanwhile
+    }
+    PatchLock.store(false);
+    return Result;
+  }
+} // namespace AOT
+
+bool AOTPatch(uint64_t PC, uint32_t Insn) {
+  // Busy: this access is completed in the handler, the next fault patches
+  return AOT::Patch(PC, Insn) != AOT::PatchResult::Impossible;
+}
+
+namespace AOT {
+  // Room for stubs within branch range (+-128 MiB) of a library's code: 1 MiB, 32,768 stubs
+  void ReserveStubs(Lib& L) {
+    constexpr size_t Size = 1 << 20;
+    const uint64_t Start = L.CodeStart, End = L.CodeEnd;
+    for (uint64_t Want : {Start - (2ULL << 20), End + (4ULL << 20), Start - (16ULL << 20), End + (32ULL << 20)}) {
+      void* P = ::mmap(reinterpret_cast<void*>(Want & ~0xFFFFFULL), Size, PROT_READ | PROT_WRITE | PROT_EXEC,
+                       MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+      if (P == MAP_FAILED) {
+        continue;
+      }
+      // library code and stubs together within 120 MiB: every branch between them reaches
+      const uint64_t A = reinterpret_cast<uint64_t>(P);
+      if (std::max(A + Size, End) - std::min(A, Start) < (120ULL << 20)) {
+        L.StubNext = static_cast<uint32_t*>(P);
+        L.StubEnd = L.StubNext + Size / 4;
+        return;
+      }
+      ::munmap(P, Size);
+    }
+    fprintf(stderr, "tso-arm aot: no room for stubs near the library; accesses to shared memory switch whole functions\n");
+  }
+
+  void OrderAll(Lib& L) {
+    if (L.OrderAllFn && !L.OrderedAll.exchange(true)) {
+      L.OrderAllFn();
+    }
+  }
+} // namespace AOT
+
+void AOTEscalate(uint64_t PC) {
+  if (auto* L = AOT::LibOf(PC); L && L->EscalateFn) {
+    const char* Name = L->EscalateFn(PC);
+    if (Name && AOT::Log) {
+      fprintf(stderr, "tso-arm aot: %s runs ordered from its next call on\n", Name);
+    }
+  }
+}
+
+void AOTOrderAll() {
+  AOT::OrderAllWanted = true;
+  const int N = AOT::NumLibs.load(std::memory_order_acquire);
+  for (int i = 0; i < N; ++i) {
+    AOT::OrderAll(AOT::Libs[i]);
+  }
+}
