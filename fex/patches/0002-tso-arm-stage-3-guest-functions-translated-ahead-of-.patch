+  // may write guest memory (the thread that forked waits here with the guest's fork locks held; the views' lock keeps
+  // the other threads' faults waiting). A child that dies on the way closes the pipe as well.
+  CloseForkPipe(1);
+  if (ForkPipe[0] >= 0) {
+    char Byte;
