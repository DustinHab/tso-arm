+    Result = CloneFork(flags, exit_signal, FEX::HLE::TSOViewMemory::Get() != nullptr);
 
     if (Result == 0) {
       // Close the read end of the pipe.
@@ -319,6 +335,11 @@ uint64_t ForkGuest(FEXCore::Core::InternalThreadState* Thread, FEXCore::Core::Cp
     // Unlock the mutexes on both sides of the fork
