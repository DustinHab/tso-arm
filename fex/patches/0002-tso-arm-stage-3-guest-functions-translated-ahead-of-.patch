@@ -122,6 +124,26 @@ bool SyscallHandler::HandleSegfault(FEXCore::Core::InternalThreadState* Thread,
       auto CTX = Thread->CTX;
       const uint64_t HostPC = ArchHelpers::Context::GetPc(ucontext);
       if (!CTX->IsAddressInCodeBuffer(Thread, HostPC)) {
+        // Code translated ahead of time (TSO_AOT) is not translated again: each of its accesses to memory that
+        // another thread writes is completed here, ordered
+        if (FEX::HLE::IsAOTCode(HostPC)) {
+          // ...and this access is ordered from now on (TSO_AOT_SWITCH=1, or an instruction the patcher does not
+          // know: the whole function runs its ordered variant from its next call on)
+          const uint32_t AInsn = __atomic_load_n(reinterpret_cast<const uint32_t*>(HostPC), __ATOMIC_RELAXED);
+          if ((AInsn & 0xFC000000) == 0x14000000) {
+            // Another thread patched the instruction meanwhile; it has not run yet: again, now through the stub
+            return Handled();
+          }
+          static const bool Switch = FEXCore::TSOViews::Knob("TSO_AOT_SWITCH");
+          if (Switch || !FEX::HLE::AOTPatch(HostPC, AInsn)) {
+            FEX::HLE::AOTEscalate(HostPC);
+          }
+          const bool Emulated = TSOViewMemory::EmulateAccess(ucontext, AInsn);
+          TSOViewMemory::NoteAccess(Emulated);
+          if (Emulated) {
+            return Handled();
+          }
+        }
         LogMan::Msg::EFmt("tso-arm: plain access to shared memory outside translated code, pc {:#x}, address {:#x}", HostPC, FaultAddress);
         return false;
       }
@@ -181,7 +203,7 @@ bool SyscallHandler::HandleSegfault(FEXCore::Core::InternalThreadState* Thread,
       return Handled();
     }
     case TSOViewMemory::Fault::NotOurs:
-      if (FEXCore::TSOViews::Knob("TSO_VIEWS_LOG")) {
