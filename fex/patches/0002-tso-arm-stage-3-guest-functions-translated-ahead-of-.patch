+// tso-arm: rpmalloc's own mapping, which a 64-bit guest's FEX keeps (it installs none of the hooks here), maps size
+// plus alignment and keeps all of it: a span of 256 MB aligned to 256 MB held 512 MB of address space, and every
+// thread's heap maps one or two. Under the views, which leave the host less than a third of a 39-bit address space,
+// a program ran out of it after a hundred threads. The same mapping, with what lies before and after the aligned
+// block given back.
+static void* FEX_rp_mmap_trimmed(size_t size, size_t alignment, size_t* offset, size_t* mapped_size) {
+  const size_t map_size = size + alignment;
+  void* ptr = ::mmap(nullptr, map_size, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+  if (ptr == MAP_FAILED) {
+    return nullptr;
+  }
+  const size_t page = static_cast<size_t>(sysconf(_SC_PAGESIZE));
+  if (!alignment || (alignment & (page - 1)) || (size & (page - 1))) {
+    size_t padding = alignment ? ((uintptr_t)ptr & (uintptr_t)(alignment - 1)) : 0;
+    if (padding) {
+      padding = alignment - padding;
+    }
+    *offset = padding;
+    *mapped_size = map_size;
+    return static_cast<char*>(ptr) + padding;
+  }
+  size_t padding = (uintptr_t)ptr & (uintptr_t)(alignment - 1);
+  if (padding) {
+    padding = alignment - padding;
+    ::munmap(ptr, padding);
+  }
+  char* block = static_cast<char*>(ptr) + padding;
+  if (map_size > padding + size) {
+    ::munmap(block + size, map_size - padding - size);
+  }
+  *offset = 0;
+  *mapped_size = size;
+  return block;
+}
+
+void TrimAlignedMappings() {
+  rp_mmap_hook = FEX_rp_mmap_trimmed;
+}
