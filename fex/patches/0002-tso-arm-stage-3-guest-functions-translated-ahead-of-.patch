+  // page protocol: it stays private to the thread (the thread stacks themselves often end up shared, next to the
+  // pthread structures other threads touch).
+  constexpr uint64_t StackSize = 2ULL << 20;
+  thread_local uint64_t StackLow {}, StackTop {};
+
+  bool OnOwnStack(uint64_t RSP) {
+    return RSP > StackLow && RSP <= StackTop;
+  }
+
+  void Bridge(void* ArgPtr) {
+    const auto* E = static_cast<const Entry*>(ArgPtr);
+    auto* Thread = ThreadObject->Thread;
+    auto* Frame = Thread->CurrentFrame;
+    auto& G = Frame->State.gregs;
+    const uint64_t RSP = G[FEXCore::X86State::REG_RSP];
+    if (!StackTop) {
+      const auto P = reinterpret_cast<uint64_t>(FEX::HLE::_SyscallHandler->GuestMmap(
+        Thread, nullptr, 2 * StackSize, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS | MAP_NORESERVE, -1, 0));
+      if (static_cast<int64_t>(P) < 0 && static_cast<int64_t>(P) > -4096) {
+        ERROR_AND_DIE_FMT("tso-arm aot: no stack for translated code ({})", -static_cast<int64_t>(P));
+      }
+      StackLow = (P + StackSize - 1) & ~(StackSize - 1);
+      StackTop = StackLow + StackSize;
+    }
+    // Nested (translated code called guest code that called translated code again): continue below the caller
+    const uint64_t Stack = OnOwnStack(RSP) ? RSP : StackTop - 64;
+    uint64_t Args[6];
+    for (int i = 0; i < 6; ++i) {
+      Args[i] = G[ArgRegs[i]];
+    }
+    const uint64_t View = Frame->TSOViewBase;
+    Context C {reinterpret_cast<uint8_t*>(View), Frame->State.fs_cached, GuestCall, Thread,
+               reinterpret_cast<uint8_t*>(View ? View | FEXCore::TSOViews::OrderedBit : 0)};
+    // While the host code runs, the guest stack pointer in the context stays below anything in use, so that nothing
+    // put there meanwhile (a guest signal frame) overwrites it
+    G[FEXCore::X86State::REG_RSP] = OnOwnStack(RSP) ? RSP - 65536 : RSP - 4096;
+    const Ret Result = E->Fn(&C, RSP, Stack, Args);
+    G[FEXCore::X86State::REG_RAX] = Result.RAX;
+    G[FEXCore::X86State::REG_RDX] = Result.RDX;
+    Frame->State.rip = *reinterpret_cast<const uint64_t*>(RSP);
+    G[FEXCore::X86State::REG_RSP] = RSP + 8;
+  }
