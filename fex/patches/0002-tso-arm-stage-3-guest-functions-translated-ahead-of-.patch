+
+bool IREmitter::AccessesGuestMemorySince(size_t From) {
+  const uintptr_t ListBegin = DualListData.ListBegin();
+  const uintptr_t DataBegin = DualListData.DataBegin();
+  const auto OpOf = [&](OrderedNodeWrapper W) {
+    return W.GetNode(ListBegin)->Op(DataBegin);
+  };
+  for (size_t Offset = From; Offset + sizeof(OrderedNode) <= DualListData.ListSize(); Offset += sizeof(OrderedNode)) {
+    const auto* IROp = reinterpret_cast<Ref>(ListBegin + Offset)->Op(DataBegin);
+    switch (IROp->Op) {
+    case OP_PUSH:
+    case OP_POP:
+    case OP_PUSHTWO:
+    case OP_POPTWO:
+    case OP_MEMCPY:
+    case OP_MEMSET: return true;
+    default: break;
+    }
+    const auto Site = SiteOf(IROp->Op);
