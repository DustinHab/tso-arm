+    const uint64_t Start = L.CodeStart, End = L.CodeEnd;
+    // tso-arm: every 2 MiB out to 96 MiB on both sides of the library's code (four places were often all taken,
+    // next to Python's libraries)
+    for (uint64_t Off = 2ULL << 20; Off <= (96ULL << 20); Off += 2ULL << 20) {
+      for (uint64_t Want : {Start - Off - Size, End + Off}) {
+        void* P = ::mmap(reinterpret_cast<void*>(Want & ~0xFFFFFULL), Size, PROT_READ | PROT_WRITE | PROT_EXEC,
