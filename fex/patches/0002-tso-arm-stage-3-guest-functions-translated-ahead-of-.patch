+void TSOViewMemory::GuestFaultAddress(siginfo_t* Info) const {
+  const uint64_t A = reinterpret_cast<uint64_t>(Info->si_addr);
+  const uint64_t View = A / Window;
+  if (A < Window || View >= 2 * uint64_t(Slots)) {
+    return;
+  }
+  // Only the views' own reservations: on a 39-bit address space a slot that could not be reserved holds host memory
+  const int Sl = int(View >= uint64_t(Slots) ? View - Slots : View);
+  if (Sl == 0 ? !SlotUsed[0] : !SlotUsable[Sl]) {
+    return;
+  }
+  Info->si_addr = reinterpret_cast<void*>(A & (Window - 1));
+}
+
+bool TSOViewMemory::ProfileSaysFallback(const char* Program) {
+  const std::string P = ProfilePathFor(Program);
+  FILE* F = P.empty() ? nullptr : fopen(P.c_str(), "r");
+  if (!F) {
+    return false;
+  }
+  // Not when this run learns migration (TSO_VIEWS_MIGRATE=learn): it runs with views, whatever the profile says
+  const char* M = getenv("TSO_VIEWS_MIGRATE");
+  if (M && !strcmp(M, "learn")) {
+    fclose(F);
+    return false;
+  }
+  char Line[128];
+  bool Fall = false;
+  while (!Fall && fgets(Line, sizeof(Line), F)) {
+    Fall = !strncmp(Line, "fallback", 8);
+  }
+  fclose(F);
+  return Fall;
+}
