+namespace AOT {
+  // Room for stubs within branch range (+-128 MiB) of a library's code: 1 MiB, 32,768 stubs
+  void ReserveStubs(Lib& L) {
+    constexpr size_t Size = 1 << 20;
+    const uint64_t Start = L.CodeStart, End = L.CodeEnd;
+    // tso-arm: every 2 MiB out to 96 MiB on both sides of the library's code (four places were often all taken,
+    // next to Python's libraries)
+    for (uint64_t Off = 2ULL << 20; Off <= (96ULL << 20); Off += 2ULL << 20) {
+      for (uint64_t Want : {Start - Off - Size, End + Off}) {
+        void* P = ::mmap(reinterpret_cast<void*>(Want & ~0xFFFFFULL), Size, PROT_READ | PROT_WRITE | PROT_EXEC,
+                         MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+        if (P == MAP_FAILED) {
+          continue;
+        }
+        // library code and stubs together within 120 MiB: every branch between them reaches
+        const uint64_t A = reinterpret_cast<uint64_t>(P);
+        if (std::max(A + Size, End) - std::min(A, Start) < (120ULL << 20)) {
+          L.StubNext = static_cast<uint32_t*>(P);
+          L.StubEnd = L.StubNext + Size / 4;
+          return;
+        }
+        ::munmap(P, Size);
+      }
+    }
+    if (Log) {
+      fprintf(stderr, "tso-arm aot: no room for stubs near the library; accesses to shared memory switch whole functions\n");
+    }
+  }
+
+  void OrderAll(Lib& L) {
+    if (L.OrderAllFn && !L.OrderedAll.exchange(true)) {
+      L.OrderAllFn();
+    }
+  }
