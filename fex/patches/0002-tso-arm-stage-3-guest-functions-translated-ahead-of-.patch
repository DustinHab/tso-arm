diff --git a/FEXCore/Source/Interface/Core/OpcodeDispatcher.h b/FEXCore/Source/Interface/Core/OpcodeDispatcher.h
index 360d605..c9cc558 100644
--- a/FEXCore/Source/Interface/Core/OpcodeDispatcher.h
+++ b/FEXCore/Source/Interface/Core/OpcodeDispatcher.h
@@ -24,6 +24,7 @@
 #include <cstdint>
 #include <fmt/format.h>
 #include <stddef.h>
+#include <string_view>
 #include <utility>
 #include <xxhash.h>
 
@@ -284,6 +285,35 @@ public:
     return CanHaveSideEffects;
   }
 
+  // tso-arm: with the views, the instruction starts where a thread can leave its block: a boundary trap, or a fault
+  // that repeats the instruction. These are accesses to memory, control flow, block ends and faults with register
+  // operands; only they get the exact state and a RIP entry, the register-only instructions between them need
+  // neither. An instruction kind that touches guest memory anyway is learned during translation (Core.cpp).
+  static bool IsViewExitPoint(const FEXCore::X86Tables::X86InstInfo* TableInfo, FEXCore::X86Tables::DecodedOp Op) {
+    if (!TableInfo || !TableInfo->Name) {
+      return true;
+    }
+    if (TableInfo->Flags &
+        (X86Tables::InstFlags::FLAGS_DEBUG_MEM_ACCESS | X86Tables::InstFlags::FLAGS_SETS_RIP | X86Tables::InstFlags::FLAGS_BLOCK_END)) {
+      return true;
+    }
+    const std::string_view Name {TableInfo->Name};
+    // An address is formed, nothing is accessed
+    if (Name == "LEA" || Name == "NOP") {
+      return false;
+    }
+    // Registers are GPR operands; GPRDirect is memory addressed by a register alone
+    auto IsMemory = [](const X86Tables::DecodedOperand& Operand) {
+      return !Operand.IsNone() && !Operand.IsGPR() && !Operand.IsLiteral() && !Operand.IsLiteralRelocation() &&
+             !Operand.IsLiteralPatchable();
+    };
+    if (IsMemory(Op->Dest) || IsMemory(Op->Src[0]) || IsMemory(Op->Src[1]) || IsMemory(Op->Src[2])) {
+      return true;
+    }
+    // Divide errors, and accesses without a memory operand
+    return Name == "DIV" || Name == "IDIV" || Name == "PUSHF" || Name == "MASKMOVQ" || Name == "MASKMOVDQU" || Name == "VMASKMOVDQU";
+  }
