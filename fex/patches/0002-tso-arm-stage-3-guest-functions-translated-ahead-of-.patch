+      const char* P = Program.value()->c_str();
+      auto RootFS = FEXCore::Config::Get(FEXCore::Config::CONFIG_ROOTFS);
+      std::string InRoot = (P[0] == '/' && RootFS && !RootFS.value()->empty()) ? std::string(RootFS.value()->c_str()) + P : std::string();
+      if (!(InRoot.size() && realpath(InRoot.c_str(), Host)) && !realpath(P, Host)) {
+        Host[0] = 0;
+      }
+    }
+    // TSO_AOT: a library named for the program (by `tso-arm run`, which sets TSO_AOT_FOR to the program's real path,
+    // so that programs it starts with execve, which inherit the variable, do not take it)
+    const char* Path = getenv("TSO_AOT");
+    const char* For = getenv("TSO_AOT_FOR");
+    if (Path && *Path && (!For || !*For || !strcmp(For, Host))) {
+      std::lock_guard lk(AOT::LoadMutex);
+      LoadAOTLibrary(CTX, Path, MainBase, 0, 0);
+      return;
+    }
+    // Otherwise the program's library in TSO_AOT_DIR, by its name and build ID
+    const char* Dir = getenv("TSO_AOT_DIR");
+    if (!Dir || !*Dir || !Host[0]) {
+      return;
+    }
+    const int Fd = open(Host, O_RDONLY | O_CLOEXEC);
+    if (Fd < 0) {
+      return;
+    }
+    AOT::Object O;
+    char Lib[4096];
+    const bool Known = AOT::ReadObject(Fd, O) && O.Key[0];
+    close(Fd);
+    if (Known && snprintf(Lib, sizeof(Lib), "%s/%s.so", Dir, O.Key) < int(sizeof(Lib)) && access(Lib, R_OK) == 0) {
+      std::lock_guard lk(AOT::LoadMutex);
+      LoadAOTLibrary(CTX, Lib, MainBase, 0, 0);
+    }
+  }
+
+  void LoadAOTForMapping(FEXCore::Context::Context* CTX, uint64_t Address, uint64_t Length, int Fd, uint64_t Offset) override {
+    static const char* Dir = getenv("TSO_AOT_DIR");
+    if (!Dir || !*Dir || Fd < 0) {
+      return;
+    }
+    AOT::Object O;
+    if (!AOT::ReadObject(Fd, O) || !O.Key[0] || O.Eh.e_type != ET_DYN) {
+      return; // without a build ID there is no name to look up
+    }
+    uint64_t Base = 0;
+    bool Placed = false;
+    for (int i = 0; i < O.Eh.e_phnum; ++i) {
+      const auto& P = O.Ph[i];
+      if (P.p_type == PT_LOAD && Offset >= (P.p_offset & ~0xFFFULL) && Offset < P.p_offset + P.p_filesz) {
+        // the mapping's guest address is the segment's address in the file's layout plus the load base
+        Base = Address - (P.p_vaddr - (P.p_offset - Offset));
+        Placed = true;
+        break;
+      }
+    }
+    char Path[4096];
+    if (!Placed || snprintf(Path, sizeof(Path), "%s/%s.so", Dir, O.Key) >= int(sizeof(Path)) || access(Path, R_OK) != 0) {
+      return;
+    }
+    std::lock_guard lk(AOT::LoadMutex);
+    LoadAOTLibrary(CTX, Path, Base, Address, Address + Length);
+  }
+
+  void UnmapAOT(FEXCore::Context::Context* CTX, FEXCore::Core::InternalThreadState* Thread, uint64_t Address, uint64_t Length) override {
+    const int Count = AOT::NumLibs.load(std::memory_order_acquire);
+    if (!Count) {
+      return;
+    }
+    std::lock_guard lk(AOT::LoadMutex);
+    for (int i = 0; i < Count; ++i) {
+      auto& L = AOT::Libs[i];
+      if (L.Gone.load() || L.GuestStart == L.GuestEnd || L.GuestEnd <= Address || L.GuestStart >= Address + Length) {
+        continue;
+      }
+      // The guest's code is gone (dlclose, or something mapped over it): its functions go back to the JIT
+      for (const auto* E = L.Table; E->RIP; ++E) {
+        CTX->RemoveAOTEntrypoint(Thread, L.Base + E->RIP);
+      }
+      L.Gone = true;
+      if (AOT::Log) {
+        fprintf(stderr, "tso-arm aot: the guest code at %#lx-%#lx is unmapped, its translations are no longer used\n",
+                (unsigned long)L.GuestStart, (unsigned long)L.GuestEnd);
+      }
+    }
+  }
+
 private:
+  // A library of translated functions for a guest object: the program (GuestStart = GuestEnd = 0; MainBase where the
+  // loader put it, used if the library is position-independent), or a shared library the guest mapped at
+  // [GuestStart, GuestEnd) with load base MainBase. Under AOT::LoadMutex.
+  void LoadAOTLibrary(FEXCore::Context::Context* CTX, const char* Path, uint64_t MainBase, uint64_t GuestStart, uint64_t GuestEnd) {
+    const int Index = AOT::NumLibs.load(std::memory_order_relaxed);
+    if (Index >= AOT::MaxLibs) {
+      fprintf(stderr, "tso-arm aot: more than %d libraries of translated functions, %s not used\n", AOT::MaxLibs, Path);
+      return;
+    }
+    void* Lib = dlopen(Path, RTLD_NOW | RTLD_LOCAL);
+    if (!Lib) {
+      fprintf(stderr, "tso-arm aot: %s\n", dlerror());
+      return;
+    }
+    const auto* Table = static_cast<const AOT::Entry*>(dlsym(Lib, "aot_table"));
+    if (!Table) {
+      fprintf(stderr, "tso-arm aot: %s has no aot_table\n", Path);
+      return;
+    }
+    const auto* Abi = static_cast<const uint32_t*>(dlsym(Lib, "aot_abi"));
+    if (!Abi || *Abi != AOT::ABI) {
+      fprintf(stderr, "tso-arm aot: %s was translated for another FEX (interface %u, this one takes %u): not used, "
+                      "'tso-arm learn' translates it again\n",
+              Path, Abi ? *Abi : 1, AOT::ABI);
+      dlclose(Lib);
+      return;
+    }
+    const auto* Pie = static_cast<const uint8_t*>(dlsym(Lib, "aot_pie"));
+    const bool IsPie = Pie && *Pie;
+    if (GuestStart != GuestEnd && !IsPie) {
+      fprintf(stderr, "tso-arm aot: %s is not position-independent, not used for a shared library\n", Path);
+      dlclose(Lib);
+      return;
+    }
+    // The same library again (the guest mapped the object anew after unmapping it): its slot is taken over
+    for (int i = 0; i < Index; ++i) {
+      if (AOT::Libs[i].Table == Table) {
+        if (!AOT::Libs[i].Gone.load()) {
+          dlclose(Lib);
+          return; // already in use for a mapping of this object
+        }
+        AOT::Libs[i].Gone = false;
+        AddAOTEntries(CTX, AOT::Libs[i], Lib, Path, IsPie ? MainBase : 0, GuestStart, GuestEnd);
+        return;
+      }
+    }
+    // The library's executable range, for the fault handler
+    struct Find {
+      const void* Address;
+      uint64_t Start, End;
+    } F {Table->Fn ? reinterpret_cast<const void*>(Table->Fn) : nullptr, 0, 0};
+    dl_iterate_phdr(
+      [](dl_phdr_info* Info, size_t, void* Data) {
+        auto* F = static_cast<Find*>(Data);
+        for (int i = 0; i < Info->dlpi_phnum; ++i) {
+          const auto& P = Info->dlpi_phdr[i];
+          const uint64_t S = Info->dlpi_addr + P.p_vaddr;
+          if (P.p_type == PT_LOAD && (P.p_flags & PF_X) && reinterpret_cast<uint64_t>(F->Address) >= S &&
+              reinterpret_cast<uint64_t>(F->Address) < S + P.p_memsz) {
+            F->Start = S;
+            F->End = S + P.p_memsz;
+            return 1;
+          }
+        }
+        return 0;
+      },
+      &F);
+    auto& L = AOT::Libs[Index];
+    L.CodeStart = F.Start;
+    L.CodeEnd = F.End;
+    L.Table = Table;
+    AOT::ReserveStubs(L);
+    L.EscalateFn = reinterpret_cast<const char* (*)(uint64_t)>(dlsym(Lib, "aot_escalate"));
+    L.OrderAllFn = reinterpret_cast<void (*)()>(dlsym(Lib, "aot_order_all"));
+    // Every translated function ordered from the start when x86 order is wanted without the page protocol (FEX's TSO
+    // on, no views), with TSO_AOT_ORDERED=1, and once the protocol fell back to full ordering
+    FEX_CONFIG_OPT(TSOEnabled, TSOENABLED);
+    if ((TSOEnabled() && !FEXCore::TSOViews::Enabled()) || FEXCore::TSOViews::Knob("TSO_AOT_ORDERED") ||
+        FEXCore::TSOViews::FallbackActive.load() || AOT::OrderAllWanted.load()) {
+      AOT::OrderAll(L);
+    } else if (!TSOEnabled()) {
+      // No ordering wanted: functions the library starts ordered (they read shared data throughout) run plain
+      if (auto Reset = reinterpret_cast<void (*)()>(dlsym(Lib, "aot_order_reset"))) {
+        Reset();
+      }
+    }
+    // Visible to the fault handler before any of its code can run
+    AOT::NumLibs.store(Index + 1, std::memory_order_release);
+    {
+      std::unique_lock lk(ThunksMutex);
+      Thunks.emplace(AOT::BridgeSum, &AOT::Bridge);
+    }
+    AddAOTEntries(CTX, L, Lib, Path, IsPie ? MainBase : 0, GuestStart, GuestEnd);
+  }
+
+  // The functions of library L for its guest object at Base: each checked against the guest's code
+  void AddAOTEntries(FEXCore::Context::Context* CTX, AOT::Lib& L, void* Lib, const char* Path, uint64_t Base, uint64_t GuestStart,
+                     uint64_t GuestEnd) {
+    // A position-independent object: the library's addresses are offsets, and it forms the object's addresses from
+    // aot_base, set here to where the object was put, before anything runs
+    if (Base) {
+      if (auto SetBase = reinterpret_cast<void (*)(uint64_t)>(dlsym(Lib, "aot_set_base"))) {
+        SetBase(Base);
+      }
+    }
+    L.Base = Base;
+    L.GuestStart = GuestStart;
+    L.GuestEnd = GuestEnd;
+    const char* Only = getenv("TSO_AOT_ONLY");
+    int Count = 0;
+    for (const auto* E = L.Table; E->RIP; ++E) {
+      if (Only && *Only && !AOT::Listed(Only, E->Name)) {
+        continue;
+      }
+      const uint64_t RIP = Base + E->RIP;
+      fextl::vector<uint8_t> Code(E->Size);
+      if (!AOT::ReadGuest(RIP, Code.data(), E->Size) || AOT::Hash(Code.data(), E->Size) != E->Hash) {
+        fprintf(stderr, "tso-arm aot: %s at %#lx does not match the guest code, left to the JIT\n", E->Name, (unsigned long)RIP);
+        continue;
+      }
+      CTX->AddAOTEntrypoint(RIP, reinterpret_cast<uintptr_t>(E), AOT::BridgeSum);
+      ++Count;
+    }
+    if (AOT::Log) {
+      fprintf(stderr, "tso-arm aot: %d functions from %s (code %#lx-%#lx%s)\n", Count, Path, (unsigned long)L.CodeStart,
+              (unsigned long)L.CodeEnd,
+              GuestStart != GuestEnd ? ", shared library" :
+              Base                   ? ", position-independent program" :
+                                       "");
+    }
+  }
+
