+bool TSOViewMemory::OutsideCovers(uint64_t Addr, uint64_t End) const {
+  auto It = Outside.upper_bound(Addr);
+  if (It == Outside.begin()) {
+    return false;
+  }
+  --It;
+  // adjacent ranges are merged (AddOutside): one range holds all of it or none does
+  return It->first <= Addr && It->second >= End;
+}
+
+void TSOViewMemory::AddOutside(uint64_t Addr, uint64_t End) {
+  RemoveOutside(Addr, End);
+  auto Next = Outside.lower_bound(Addr);
+  if (Next != Outside.end() && Next->first == End) {
+    End = Next->second;
+    Outside.erase(Next);
+  }
+  auto Prev = Outside.lower_bound(Addr);
+  if (Prev != Outside.begin() && std::prev(Prev)->second == Addr) {
+    std::prev(Prev)->second = End;
+    return;
+  }
+  Outside[Addr] = End;
+}
+
+void TSOViewMemory::RemoveOutside(uint64_t Addr, uint64_t End) {
+  if (End <= Window || Outside.empty()) {
+    return;
+  }
+  auto It = Outside.upper_bound(Addr);
+  if (It != Outside.begin() && std::prev(It)->second > Addr) {
+    --It;
+  }
+  while (It != Outside.end() && It->first < End) {
+    const uint64_t S = It->first, E = It->second;
+    It = Outside.erase(It);
+    if (S < Addr) {
+      Outside[S] = Addr;
+    }
+    if (E > End) {
+      Outside[End] = E;
+    }
+  }
+}
