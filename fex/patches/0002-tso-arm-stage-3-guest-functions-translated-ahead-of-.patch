+void Arm64Emitter::LoadConstantParts(ARMEmitter::Register Reg, uint64_t Constant, int Moves) {
+  LOGMAN_THROW_A_FMT(MoveParts(Constant) <= Moves && Moves <= 4, "{:#x} does not fit in {} moves", Constant, Moves);
+  int Emitted = 0;
+  for (int i = 0; i < 4; ++i) {
+    const uint16_t Part = (Constant >> (i * 16)) & 0xFFFF;
+    if (Part == 0) {
+      continue;
+    }
+    if (Emitted == 0) {
+      movz(ARMEmitter::Size::i64Bit, Reg, Part, i * 16);
+    } else {
+      movk(ARMEmitter::Size::i64Bit, Reg, Part, i * 16);
+    }
+    ++Emitted;
+  }
+  if (Emitted == 0) {
+    movz(ARMEmitter::Size::i64Bit, Reg, 0, 0);
+    ++Emitted;
+  }
+  for (; Emitted < Moves; ++Emitted) {
+    nop();
+  }
+}
