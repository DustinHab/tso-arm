+  // tso-arm: a fork while the writer thread held the index's locks left them held in the child for good, and the
+  // child has no writer thread. The locks are taken around the fork (after the invalidation lock, as a translation
+  // takes them), and the child reads the cache but no longer writes it: its descriptors are the parent's, whose file
+  // locks it shares, so both would append at once. With the cache in memory as well (DiskCacheMemorySize), whose
+  // pruning goes through the writer, the child does not read it either. A program it starts with execve has its own.
+  void DiskCache::LockBeforeFork() {
+    if (!ReadingDiskCache && !WritingDiskCache) {
+      return;
+    }
+    IndexLock.lock();
+    MemoryLRULock.lock();
+  }
+
+  void DiskCache::UnlockAfterFork(bool Child) {
+    if (!ReadingDiskCache && !WritingDiskCache) {
+      return;
+    }
+    if (Child) {
+      WritingDiskCache = false;
+      if (MemoryLRUMaxSize) {
+        ReadingDiskCache = false;
+      }
+      // its thread is the parent's: never joined here
+      (void)Writer.release();
+    }
+    MemoryLRULock.unlock();
+    IndexLock.unlock();
+  }
