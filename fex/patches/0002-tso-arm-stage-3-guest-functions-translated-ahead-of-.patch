+    AOT::EscalateFn = reinterpret_cast<const char* (*)(uint64_t)>(dlsym(Lib, "aot_escalate"));
+    AOT::OrderAllFn = reinterpret_cast<void (*)()>(dlsym(Lib, "aot_order_all"));
+    // Every translated function ordered from the start when x86 order is wanted without the page protocol (FEX's TSO
+    // on, no views), with TSO_AOT_ORDERED=1, and in the protocol's fallback to full ordering
+    FEX_CONFIG_OPT(TSOEnabled, TSOENABLED);
+    if ((TSOEnabled() && !FEXCore::TSOViews::Enabled()) || FEXCore::TSOViews::Knob("TSO_AOT_ORDERED") ||
+        FEXCore::TSOViews::FallbackActive.load()) {
+      AOTOrderAll();
+    }
+
+    {
+      std::unique_lock lk(ThunksMutex);
+      Thunks.emplace(AOT::BridgeSum, &AOT::Bridge);
+    }
+    const char* Only = getenv("TSO_AOT_ONLY");
+    int Count = 0;
+    for (const auto* E = Table; E->RIP; ++E) {
+      if (Only && *Only && !AOT::Listed(Only, E->Name)) {
+        continue;
+      }
+      fextl::vector<uint8_t> Code(E->Size);
+      if (!AOT::ReadGuest(E->RIP, Code.data(), E->Size) || AOT::Hash(Code.data(), E->Size) != E->Hash) {
+        fprintf(stderr, "tso-arm aot: %s at %#lx does not match the guest code, left to the JIT\n", E->Name, (unsigned long)E->RIP);
+        continue;
+      }
+      CTX->AddAOTEntrypoint(E->RIP, reinterpret_cast<uintptr_t>(E), AOT::BridgeSum);
+      ++Count;
+    }
+    if (AOT::Log) {
+      fprintf(stderr, "tso-arm aot: %d functions from %s (code %#lx-%#lx)\n", Count, Path, (unsigned long)F.Start, (unsigned long)F.End);
+    }
+  }
+
