@@ -122,6 +124,17 @@ bool SyscallHandler::HandleSegfault(FEXCore::Core::InternalThreadState* Thread,
       auto CTX = Thread->CTX;
       const uint64_t HostPC = ArchHelpers::Context::GetPc(ucontext);
       if (!CTX->IsAddressInCodeBuffer(Thread, HostPC)) {
+        // Code translated ahead of time (TSO_AOT) is not translated again: each of its accesses to memory that
