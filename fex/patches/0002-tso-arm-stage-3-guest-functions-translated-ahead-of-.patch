@@ -1143,6 +1146,22 @@ ContextImpl::AddCustomIREntrypoint(uintptr_t Entrypoint, CustomIREntrypointHandl
   return std::nullopt;
 }
 
+void ContextImpl::AddAOTEntrypoint(uintptr_t Entrypoint, uintptr_t Hook, const IR::SHA256Sum& Bridge) {
+  AddCustomIREntrypoint(
+    Entrypoint,
+    [Hook, Bridge](uintptr_t Entrypoint, FEXCore::IR::IREmitter* emit) {
+      auto IRHeader = emit->_IRHeader(emit->Invalid(), Entrypoint, 0, 0, 0, 0);
+      auto Block = emit->CreateCodeNode(true, 0);
+      IRHeader.first->Blocks = emit->WrapNode(Block);
+      emit->SetCurrentCodeBlock(Block);
+      // The bridge runs the whole function and its return; registers come back from the context after the call
+      emit->_Thunk(emit->Constant(Hook), Bridge);
+      auto NewRIP = emit->_LoadContext(IR::OpSize::i64Bit, IR::RegClass::GPR, offsetof(Core::CPUState, rip));
+      emit->_ExitFunction(IR::OpSize::i64Bit, NewRIP, IR::BranchHint::Return, emit->Invalid(), emit->Invalid());
+    },
+    nullptr, (void*)Hook);
+}
+
 void ContextImpl::AddThunkTrampolineIRHandler(uintptr_t Entrypoint, uintptr_t GuestThunkEntrypoint) {
   LOGMAN_THROW_A_FMT(Entrypoint, "Tried to link null pointer address to guest function");
   LOGMAN_THROW_A_FMT(GuestThunkEntrypoint, "Tried to link address to null pointer guest function");
diff --git a/FEXCore/Source/Interface/Core/Dispatcher/Dispatcher.cpp b/FEXCore/Source/Interface/Core/Dispatcher/Dispatcher.cpp
index c903d3b..6fd5a81 100644
--- a/FEXCore/Source/Interface/Core/Dispatcher/Dispatcher.cpp
+++ b/FEXCore/Source/Interface/Core/Dispatcher/Dispatcher.cpp
@@ -86,9 +86,17 @@ void Dispatcher::EmitDispatcher() {
   // regardless of where we were in the stack
   add(ARMEmitter::Size::i64Bit, ARMEmitter::Reg::r0, ARMEmitter::Reg::rsp, 0);
   str(ARMEmitter::XReg::x0, STATE_PTR(CpuStateFrame, ReturningStackLocation));
+#ifndef ARCHITECTURE_arm64ec
+  str(ARMEmitter::XReg::x0, STATE_PTR(CpuStateFrame, DispatchSP));
+#endif
 
   ARMEmitter::ForwardLabel CompileSingleStep;
   AbsoluteLoopTopAddressFillSRA = GetCursorAddress<uint64_t>();
+#ifndef ARCHITECTURE_arm64ec
+  // tso-arm: entered from a signal handler in the middle of a block, the block's spill area is still on the stack
+  ldr(ARMEmitter::XReg::x0, STATE_PTR(CpuStateFrame, DispatchSP));
+  add(ARMEmitter::Size::i64Bit, ARMEmitter::Reg::rsp, ARMEmitter::Reg::r0, 0);
+#endif
 
   FillStaticRegs();
   ldr(RipReg, STATE_PTR(CpuStateFrame, State.rip));
@@ -510,6 +518,19 @@ void Dispatcher::EmitDispatcher() {
     // First thing we need to move the thread state pointer back in to our register
     mov(STATE, ARMEmitter::XReg::x0);
 
+#ifndef ARCHITECTURE_arm64ec
+    // tso-arm: x25 belongs to the host code that calls back (callee-saved, it may hold anything here); the call-ret
+    // stack pointer comes from the thunk call that left the JIT
+    ldr(REG_CALLRET_SP, STATE_PTR(CpuStateFrame, State.callret_sp));
+
+    // tso-arm: this loop's stack pointer, for re-entries at the loop top from signal handlers; the outer loop's value
+    // is kept on the stack and restored by CallbackReturn
+    ldr(ARMEmitter::XReg::x3, STATE_PTR(CpuStateFrame, DispatchSP));
+    stp<ARMEmitter::IndexType::PRE>(ARMEmitter::XReg::x3, ARMEmitter::XReg::zr, ARMEmitter::XReg::rsp, -0x10);
+    add(ARMEmitter::Size::i64Bit, ARMEmitter::Reg::r3, ARMEmitter::Reg::rsp, 0);
+    str(ARMEmitter::XReg::x3, STATE_PTR(CpuStateFrame, DispatchSP));
+#endif
+
     // Make sure to adjust the refcounter so we don't clear the cache now
     ldr(ARMEmitter::WReg::w2, STATE_PTR(CpuStateFrame, SignalHandlerRefCounter));
     add(ARMEmitter::Size::i32Bit, ARMEmitter::Reg::r2, ARMEmitter::Reg::r2, 1);
diff --git a/FEXCore/Source/Interface/Core/JIT/BranchOps.cpp b/FEXCore/Source/Interface/Core/JIT/BranchOps.cpp
index ae3ed51..238f494 100644
--- a/FEXCore/Source/Interface/Core/JIT/BranchOps.cpp
+++ b/FEXCore/Source/Interface/Core/JIT/BranchOps.cpp
@@ -24,7 +24,16 @@ DEF_OP(CallbackReturn) {
   SpillStaticRegs(TMP1);
 
   // First we must reset the stack
+#ifndef ARCHITECTURE_arm64ec
+  // tso-arm: to the callback loop's stack pointer (a signal handler may have sent the thread to the loop top from
+  // inside a block, leaving that block's spill area behind), then the outer loop's value back into the state
+  ldr(TMP1, STATE, offsetof(FEXCore::Core::CpuStateFrame, DispatchSP));
+  add(ARMEmitter::Size::i64Bit, ARMEmitter::Reg::rsp, TMP1.R(), 0);
+  ldp<ARMEmitter::IndexType::POST>(TMP1, TMP2, ARMEmitter::XReg::rsp, 0x10);
+  str(TMP1, STATE, offsetof(FEXCore::Core::CpuStateFrame, DispatchSP));
+#else
   ResetStack();
+#endif
 
   // We can now lower the ref counter again
 
@@ -306,6 +315,12 @@ DEF_OP(Thunk) {
 
   PushDynamicRegs(TMP1);
 
+#ifndef ARCHITECTURE_arm64ec
+  // tso-arm: the host code may use x25 (callee-saved) before it calls back into guest code; the callback entry takes
+  // the call-ret stack pointer from here instead of from the register
+  str(REG_CALLRET_SP, STATE, offsetof(FEXCore::Core::CpuStateFrame, State.callret_sp));
+#endif
+
   mov(ARMEmitter::Size::i64Bit, ARMEmitter::Reg::r0, GetReg(Op->ArgPtr));
 
   InsertNamedThunkRelocation(ARMEmitter::Reg::r2, Op->ThunkNameHash);
