+// Only counted and timed when the statistics are asked for: two clock reads per translation add up at start-up
+inline bool StatsWanted() {
+  static const bool On = [] {
+    const char* E = getenv("TSO_VIEWS_STATS");
+    return E && E[0] && !(E[0] == '0' && E[1] == 0);
+  }();
+  return On;
+}
 inline uint64_t Nanos() {
   timespec T;
   clock_gettime(CLOCK_MONOTONIC, &T);
