+    switch (IROp->Op) {
+    case OP_PUSH:
+    case OP_POP:
+    case OP_PUSHTWO:
+    case OP_POPTWO:
+    case OP_MEMCPY:
+    case OP_MEMSET: return true;
+    default: break;
+    }
+    const auto Site = SiteOf(IROp->Op);
+    if (Site.Index < 0 || IROp->Args[Site.Index].IsInvalid()) {
+      continue;
+    }
+    // The x87 registers in the thread's context are no guest memory
+    const auto* A = OpOf(IROp->Args[Site.Index]);
+    if (A->Op == OP_FORMCONTEXTADDRESS ||
+        ((A->Op == OP_ADD || A->Op == OP_ADDSHIFT || A->Op == OP_SUB) && OpOf(A->Args[0])->Op == OP_FORMCONTEXTADDRESS)) {
+      continue;
+    }
+    return true;
+  }
