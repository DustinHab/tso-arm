+uint64_t ContextImpl::TSOEscalationFingerprint(uint64_t Begin, uint64_t End) const {
+  std::shared_lock lk(TSOEscalatedMutex);
+  uint64_t Hash = 0;
+  // sorted by their ends, which do not overlap
+  auto It = std::lower_bound(TSOEscalated.begin(), TSOEscalated.end(), Begin, [](const auto& I, uint64_t B) { return I.End <= B; });
+  for (; It != TSOEscalated.end() && It->Offset < End; ++It) {
+    const uint64_t Rel[2] = {std::max<uint64_t>(It->Offset, Begin) - Begin, std::min<uint64_t>(It->End, End) - Begin};
+    Hash = XXH3_64bits_withSeed(Rel, sizeof(Rel), Hash);
+  }
+  return Hash;
+}
