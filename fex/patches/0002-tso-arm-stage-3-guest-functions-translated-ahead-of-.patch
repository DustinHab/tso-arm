+// tso-arm: structures in a pNext chain that hand the host a guest function to call: the host's loader or driver would
+// call it as its own (x86 code run as Arm code, SIGILL). vulkaninfo chains a debug messenger into vkCreateInstance, and
+// the loader called it from vkEnumeratePhysicalDevices on. Such structures are taken out of the chain for the call and
+// put back after it, so that the application's structures are as they were (on 64-bit the chain is its own memory);
+// what the host made of them (a messenger for the instance's lifetime) is not made. The functions that create
+// messengers on their own (vkCreateDebugReportCallbackEXT, vkCreateDebugUtilsMessengerEXT) put a host function in.
+namespace {
+struct UnlinkedNext {
+  VkBaseInStructure* Prev;
+  const VkBaseInStructure* Removed;
+};
+
+std::vector<UnlinkedNext> UnlinkGuestCallbacks(const void* Head, std::initializer_list<VkStructureType> Types) {
+  std::vector<UnlinkedNext> Unlinked;
+  auto Prev = reinterpret_cast<VkBaseInStructure*>(const_cast<void*>(Head));
+  while (Prev->pNext) {
+    const auto Next = Prev->pNext;
+    bool Remove = false;
+    for (auto Type : Types) {
+      Remove |= Next->sType == Type;
     }
+    if (Remove) {
+      Unlinked.push_back({Prev, Next});
+      Prev->pNext = Next->pNext;
+    } else {
+      Prev = const_cast<VkBaseInStructure*>(Next);
+    }
+  }
+  return Unlinked;
+}
+
+void RelinkGuestCallbacks(const std::vector<UnlinkedNext>& Unlinked) {
+  for (auto It = Unlinked.rbegin(); It != Unlinked.rend(); ++It) {
+    It->Prev->pNext = It->Removed;
   }
+}
