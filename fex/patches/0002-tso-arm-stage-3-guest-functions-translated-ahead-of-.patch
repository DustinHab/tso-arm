+  if (FallbackActive.load(std::memory_order_relaxed)) {
+    return false;
+  }
+  LogMan::Msg::IFmt("tso-arm: an access to {:#x}, outside the guest's memory (the host's, from a thunk), falling back to full ordering",
+                    Address);
+  EnterFallback(Nanos() - StartNs, true);
+  return true;
+}
+
+uint64_t TSOViewMemory::ShareSlot() {
+  std::lock_guard lk(Mutex);
+  int Best = 0;
+  for (int S = 1; S < Slots; ++S) {
+    if (SlotUsed[S] && (!Best || SlotUsers[S] < SlotUsers[Best])) {
+      Best = S;
+    }
+  }
+  if (!Best || !FallbackActive.load(std::memory_order_relaxed)) {
+    return 0;
+  }
+  ++SlotUsers[Best];
+  VLOG("tso-arm: a thread without a slot shares slot %d (%u users)\n", Best, SlotUsers[Best]);
+  return SlotBase(Best);
+}
