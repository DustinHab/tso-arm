+// tso-arm: the guest's limits on its data and its address space (RLIMIT_DATA, RLIMIT_AS) for its own process are its
+// own: kept here and given back by getrlimit and prlimit64, not set on the host, where they would count FEX's memory
+// as well. A thread's lookup cache and heap are some 400 MB of private writable mappings, a process starts with some
+// 3.6 GB of them. Chromium limits its renderers' and GPU process's data to 8 GB: Slack's renderer reached that after a
+// few threads, the mapping of the next thread's lookup cache failed (unchecked in a release build), and that thread
+// ran with its L1 cache at -1 plus 256 MB: jumps to 0x10003f07 and the like, faults inside FEX, every thread then
+// waiting for a lock. Other resources, and other processes' limits, go to the host as they are. A fork's child keeps
+// the guest's values (they live in its memory); the program an execve starts begins with the host's.
+namespace {
+  struct GuestLimit {
+    std::atomic<bool> Set {};
+    std::atomic<uint64_t> Cur {}, Max {};
+  };
+  GuestLimit GuestLimits[2];
+
+  GuestLimit* GuestLimitFor(pid_t Pid, int Resource) {
+    if (Pid != 0 && Pid != ::getpid()) {
+      return nullptr;
+    }
+    return Resource == RLIMIT_DATA ? &GuestLimits[0] : Resource == RLIMIT_AS ? &GuestLimits[1] : nullptr;
