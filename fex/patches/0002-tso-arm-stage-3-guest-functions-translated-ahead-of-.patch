+// tso-arm: FEX's own descriptors that live as long as FEX does (the disk cache's files, the root file system's and
+// /proc's directories, the server's socket): the guest does not see them in /proc/self/fd and cannot close them
+// (close gives EBADF, close_range leaves them out). A program that cleans up what it inherited with close_range from
+// 3 on closed them all: FEX then wrote its cache into the program's files and lost its root file system. Stored as
+// descriptor + 1 (0: free).
+inline std::atomic<int> ProtectedFDs[16] {};
+
+inline int ProtectFD(int FD) {
+  if (FD < 0) {
+    return FD;
+  }
+  for (auto& Slot : ProtectedFDs) {
+    int Free = 0;
+    if (Slot.compare_exchange_strong(Free, FD + 1)) {
+      break;
+    }
+  }
+  return FD;
+}
+
+inline bool IsProtectedFD(int FD) {
+  for (auto& Slot : ProtectedFDs) {
+    if (Slot.load(std::memory_order_relaxed) == FD + 1) {
+      return true;
+    }
+  }
+  return false;
+}
+
