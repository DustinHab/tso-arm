+// ---------------------------------------------------------------------------------------------------------------
+// fork
+
+// Pages of shared memory that are in swap have no page table entry and are not in the page cache, so mincore does
+// not count them. With swap in use on the system, the guest mappings with pages in swap are looked up in
+// /proc/self/smaps (once per fork), and every page of those is read. No allocations: the child of a fork may find
+// the allocators' locks held by threads it does not have.
+struct TSOViewMemory::SwapPages {
+  bool Loaded {};
+  bool All {};    // the mappings could not be listed: every page may be in swap
+  uint64_t* V {}; // [start, end) pairs, in address order
+  size_t N {};
+  static constexpr size_t Cap = 1 << 16;
+  ~SwapPages() {
+    if (V) {
+      ::munmap(V, Cap * 2 * sizeof(uint64_t));
+    }
+  }
+  void Load();
+  bool Maybe(uint64_t Addr) const {
+    if (All) {
+      return true;
+    }
+    size_t Lo = 0, Hi = N;
+    while (Lo < Hi) {
+      const size_t M = (Lo + Hi) / 2;
+      if (V[2 * M + 1] <= Addr) {
+        Lo = M + 1;
+      } else {
+        Hi = M;
+      }
+    }
+    return Lo < N && V[2 * Lo] <= Addr;
+  }
+};
+
+void TSOViewMemory::SwapPages::Load() {
+  if (Loaded) {
+    return;
+  }
+  Loaded = true;
+  {
+    char Buf[8192];
+    const int Fd = ::open("/proc/meminfo", O_RDONLY | O_CLOEXEC);
+    const ssize_t Len = Fd >= 0 ? ::read(Fd, Buf, sizeof(Buf) - 1) : -1;
+    if (Fd >= 0) {
+      ::close(Fd);
+    }
+    if (Len > 0) {
+      Buf[Len] = 0;
+      const char* Total = strstr(Buf, "SwapTotal:");
+      const char* Free = strstr(Buf, "SwapFree:");
+      if (Total && Free && strtoull(Total + 10, nullptr, 10) == strtoull(Free + 9, nullptr, 10)) {
+        return; // nothing in swap: mincore sees every page
+      }
+    }
+  }
+  All = true;
+  const int Fd = ::open("/proc/self/smaps", O_RDONLY | O_CLOEXEC);
+  if (Fd < 0) {
+    return;
+  }
+  constexpr size_t BufSize = 1 << 16;
+  auto* B = static_cast<char*>(::mmap(nullptr, BufSize, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0));
+  auto* P = ::mmap(nullptr, Cap * 2 * sizeof(uint64_t), PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+  if (B == MAP_FAILED || P == MAP_FAILED) {
+    if (B != MAP_FAILED) {
+      ::munmap(B, BufSize);
+    }
+    if (P != MAP_FAILED) {
+      ::munmap(P, Cap * 2 * sizeof(uint64_t));
+    }
+    ::close(Fd);
+    return;
+  }
+  V = static_cast<uint64_t*>(P);
+  size_t Have = 0;
+  uint64_t VStart = 0, VEnd = 0;
+  bool Ok = true;
+  for (;;) {
+    const ssize_t Got = ::read(Fd, B + Have, BufSize - 1 - Have);
+    if (Got < 0 && errno == EINTR) {
+      continue;
+    }
+    if (Got < 0) {
+      Ok = false;
+      break;
+    }
+    Have += size_t(Got);
+    size_t Pos = 0;
+    while (char* NL = static_cast<char*>(memchr(B + Pos, '\n', Have - Pos))) {
+      *NL = 0;
+      const char* Line = B + Pos;
+      Pos = size_t(NL - B) + 1;
+      if ((Line[0] >= '0' && Line[0] <= '9') || (Line[0] >= 'a' && Line[0] <= 'f')) {
+        // a mapping: "start-end perms offset dev inode path"
+        char* E;
+        VStart = strtoull(Line, &E, 16);
+        VEnd = *E == '-' ? strtoull(E + 1, nullptr, 16) : VStart;
+      } else if (!strncmp(Line, "Swap:", 5) && VStart < Window && strtoull(Line + 5, nullptr, 10) > 0) {
+        if (N == Cap) {
+          Ok = false;
+          break;
+        }
+        V[2 * N] = VStart;
+        V[2 * N + 1] = std::min(VEnd, Window);
+        ++N;
+      }
+    }
+    if (!Ok || Got == 0) {
+      break;
+    }
+    if (Pos == 0 && Have == BufSize - 1) {
+      Have = 0; // a line longer than the buffer (a path): none of the lines looked at
+    } else {
+      memmove(B, B + Pos, Have - Pos);
+      Have -= Pos;
+    }
+  }
+  ::close(Fd);
+  ::munmap(B, BufSize);
+  All = !Ok;
+}
+
+namespace {
+  bool ZeroPage(const uint8_t* P) {
+    const auto* Q = reinterpret_cast<const uint64_t*>(P);
+    for (size_t i = 0; i < (size_t(1) << PageShift) / sizeof(uint64_t); ++i) {
+      if (Q[i]) {
+        return false;
+      }
+    }
+    return true;
+  }
+} // namespace
+
+int64_t TSOViewMemory::Unshare(uint64_t Start, Range& R, SwapPages& Swap) {
+  if (Start >= Window || R.K != Kind::Private) {
+    return 0;
+  }
+  const uint64_t End = std::min(R.End, Window);
+  const uint64_t L = End - Start;
+  auto* Copy = static_cast<uint8_t*>(::mmap(nullptr, L, PROT_READ | PROT_WRITE, MAP_SHARED | MAP_ANONYMOUS, -1, 0));
+  if (Copy == MAP_FAILED) {
+    return -1;
+  }
+  auto* Src = reinterpret_cast<uint8_t*>(Start);
+  if (!(R.Prot & PROT_READ)) {
+    ::mprotect(Src, L, PROT_READ); // replaced below anyway
+  }
+  Swap.Load();
+
+  // Only pages that hold something: those in memory (mincore, which for shared memory looks at the pages of the
+  // object, whichever mapping touched them), and nonzero pages among those that may be in swap. The others stay
+  // holes in the copy and read as zero, as they do in the original. A file-backed range is copied whole: its pages
+  // not in memory are the file's, not zero.
+  int64_t Bytes = 0;
+  constexpr uint64_t ChunkPages = 1 << 12;
+  uint8_t In[ChunkPages];
+  if (R.FileBacked) {
+    memcpy(Copy, Src, L);
+    Bytes = int64_t(L);
+  }
+  for (uint64_t C = 0; C < L && !R.FileBacked; C += ChunkPages << PageShift) {
+    const uint64_t CL = std::min(L - C, ChunkPages << PageShift);
+    const uint64_t CP = CL >> PageShift;
+    if (::mincore(Src + C, CL, In) != 0) {
+      VLOG("tso-arm: mincore %#lx+%#lx: %s\n", (unsigned long)(Start + C), (unsigned long)CL, strerror(errno));
+      continue; // not mapped in this process (MADV_DONTFORK): nothing to copy
+    }
+    uint64_t Run = 0;
+    for (uint64_t P = 0; P <= CP; ++P) {
+      if (P < CP) {
+        const uint64_t Off = C + (P << PageShift);
+        if ((In[P] & 1) || (Swap.Maybe(Start + Off) && !ZeroPage(Src + Off))) {
+          ++Run;
+          continue;
+        }
+      }
+      if (Run) {
+        const uint64_t Off = C + ((P - Run) << PageShift);
+        memcpy(Copy + Off, Src + Off, Run << PageShift);
+        Bytes += int64_t(Run << PageShift);
+        Run = 0;
+      }
+    }
+  }
+
+  VLOG("tso-arm: copy of %#lx-%#lx prot %d aliased %#x: %ld KB\n", (unsigned long)Start, (unsigned long)End, R.Prot, R.Aliased,
+       (long)(Bytes >> 10));
+
+  // The copy takes the range's place in guest memory and in the views that map it
+  if (::mremap(Copy, L, L, MREMAP_MAYMOVE | MREMAP_FIXED, Src) == MAP_FAILED) {
+    LogMan::Msg::EFmt("tso-arm: the copy of {:#x}-{:#x} could not take its place: {}", Start, End, strerror(errno));
+    ::munmap(Copy, L);
+    ::mprotect(Src, L, R.Prot);
+    return -1;
+  }
+  ::mprotect(Src, L, R.Prot);
+  for (int S = 0; S < Slots; ++S) {
+    if (SlotUsed[S] && ((R.Aliased >> S) & 1)) {
+      if (S != 0) {
+        AliasNone(Start, L, SlotBase(S));
+      }
+      AliasNone(Start, L, OrderedViewBase(S));
+    }
+  }
+  R.ForkShared = false;
+  R.FileBacked = false;
+  Apply(Start, End);
+  return Bytes;
+}
+
+void TSOViewMemory::UnshareForkShared(uint64_t Addr, uint64_t Length, bool Files) {
+  const uint64_t End = Addr + Length;
+  SwapPages Swap;
+  auto It = Ranges.upper_bound(Addr);
+  if (It != Ranges.begin()) {
+    --It;
+  }
+  for (; It != Ranges.end() && It->first < End; ++It) {
+    if (!It->second.ForkShared || It->second.End <= Addr || (!Files && It->second.FileBacked)) {
+      continue;
+    }
+    if (Unshare(It->first, It->second, Swap) < 0) {
+      LogMan::Msg::EFmt("tso-arm: {:#x}-{:#x} stays shared with a forked process: its copy failed", It->first, It->second.End);
+    } else {
+      VLOG("tso-arm: %#lx-%#lx no longer shared with a forked process\n", (unsigned long)It->first, (unsigned long)It->second.End);
+    }
+  }
+}
+
+void TSOViewMemory::DropForkDone() {
+  if (ForkDone) {
+    ::munmap(ForkDone, 1ULL << PageShift);
+    ForkDone = nullptr;
+  }
+}
+
+void TSOViewMemory::LockForFork() {
+  Mutex.lock();
+  // A pipe did this before, two descriptors at every fork: with the guest's descriptors nearly all in use (CPython's
+  // test_no_leaking) they were the last ones, and FEX's own pipe for vfork found none
+  auto* P = ::mmap(nullptr, 1ULL << PageShift, PROT_READ | PROT_WRITE, MAP_SHARED | MAP_ANONYMOUS, -1, 0);
+  ForkDone = P == MAP_FAILED ? nullptr : static_cast<uint32_t*>(P);
+}
+
+void TSOViewMemory::UnlockForFork() {
+  DropForkDone();
+  Mutex.unlock();
+}
+
+void TSOViewMemory::AfterForkParent(pid_t Child) {
+  std::lock_guard lk(Mutex);
+  // The child copies after the fork, from memory this process still shares with it: until it is done, nothing here
+  // may write guest memory (the thread that forked waits here with the guest's fork locks held; the views' lock keeps
+  // the other threads' faults waiting). A child that dies on the way is seen by waitid without reaping it (WNOWAIT):
+  // the guest waits for it as it would.
+  if (!ForkDone) {
+    LogMan::Msg::EFmt("tso-arm: fork without a word to wait for the child's copy");
+  }
+  while (ForkDone && !__atomic_load_n(ForkDone, __ATOMIC_ACQUIRE)) {
+    const timespec Wait {0, 20'000'000};
+    ::syscall(SYS_futex, ForkDone, FUTEX_WAIT, 0, &Wait, nullptr, 0);
+    if (__atomic_load_n(ForkDone, __ATOMIC_ACQUIRE)) {
+      break;
+    }
+    siginfo_t Info {};
+    const int R = ::waitid(P_PID, Child, &Info, WEXITED | WNOHANG | WNOWAIT | __WALL);
+    if ((R == -1 && errno == ECHILD) || (R == 0 && Info.si_pid == Child)) {
+      break;
+    }
+  }
+  DropForkDone();
+  for (auto& [Start, R] : Ranges) {
+    if (R.K == Kind::Private && Start < Window && !(R.Prot & PROT_WRITE)) {
+      R.ForkShared = true;
+    }
+  }
+}
+
+void TSOViewMemory::AfterForkChild(uint64_t Base, bool Copy, void (*Copied)(void* Ctx, uint64_t Start, uint64_t Length), void* Ctx) {
+  // The forking thread held the lock across the fork; here it is the only thread, and the lock starts over
+  new (&Mutex) std::recursive_mutex;
+  if (!Copy) {
+    DropForkDone();
+    return;
+  }
+  std::lock_guard lk(Mutex);
+  const uint64_t T0 = Nanos();
+  const int Me = IdentityBase() ? 0 : int(Base / Window);
+
+  // The other threads did not come along: their views go
+  for (int S = 1; S < Slots; ++S) {
+    if (!SlotUsed[S] || S == Me) {
+      continue;
+    }
+    for (auto& [Start, R] : Ranges) {
+      R.Aliased &= ~uint16_t(1U << S);
+    }
+    Reserve(SlotBase(S), Window);
+    Reserve(OrderedViewBase(S), Window);
+    SlotUsed[S] = false;
+    SlotUsers[S] = 0;
+  }
+  if (IsOwnerSlot(Me)) {
+    SlotUsers[Me] = 1;
+  }
+  // The profile so far is the parent's to write; the child writes it only if it learns something itself (a shell's
+  // children would otherwise rewrite it at every exit)
+  ProfileChanged = false;
+
+  // A single thread: every private page is its own (plain accesses), unless the process runs fully ordered
+  const bool Own = IsOwnerSlot(Me) && SlotUsed[Me] && !FallbackActive.load() && !Stage1();
+  SwapPages Swap;
+  uint64_t Copies = 0, Bytes = 0, Shared = 0;
+  for (auto& [Start, R] : Ranges) {
+    if (R.K != Kind::Private || Start >= Window) {
+      continue;
+    }
+    if (Own) {
+      SetState(Start, R.End, uint8_t(Me));
+    }
+    if (!(R.Prot & PROT_WRITE)) {
+      // Unchanged in both processes until one makes it writable. Without any rights (reservations, guard pages) the
+      // views have none either, whatever the page states say.
+      R.ForkShared = true;
+      ++Shared;
+      if (Own && (R.Prot & PROT_READ)) {
+        Apply(Start, R.End);
+      }
+      continue;
+    }
+    const int64_t B = Unshare(Start, R, Swap);
+    if (B < 0) {
+      LogMan::Msg::EFmt("tso-arm: fork: the child's copy of {:#x}-{:#x} failed", Start, R.End);
+      ::_exit(127);
+    }
+    ++Copies;
+    Bytes += uint64_t(B);
+    if (Copied && (R.Prot & PROT_EXEC)) {
+      Copied(Ctx, Start, R.End - Start);
+    }
+  }
+  // The parent may go on
+  if (ForkDone) {
+    __atomic_store_n(ForkDone, 1, __ATOMIC_RELEASE);
+    ::syscall(SYS_futex, ForkDone, FUTEX_WAKE, INT32_MAX, nullptr, nullptr, 0);
+  }
+  DropForkDone();
+  VLOG("tso-arm: fork: %lu ranges copied (%lu KB) in %.3f ms, %lu read-only ranges shared, swap %s\n", (unsigned long)Copies,
+       (unsigned long)(Bytes >> 10), (Nanos() - T0) / 1e6, (unsigned long)Shared,
+       !Swap.Loaded ? "not looked at" : Swap.All ? "unknown" : Swap.N ? "in use" : "not used");
+}
