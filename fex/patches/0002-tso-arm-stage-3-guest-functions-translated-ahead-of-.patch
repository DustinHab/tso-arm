+bool TSOViewMemory::ProfileSaysFallback(const char* Program) {
+  const std::string P = ProfilePathFor(Program);
+  FILE* F = P.empty() ? nullptr : fopen(P.c_str(), "r");
+  if (!F) {
+    return false;
+  }
+  char Line[128];
+  bool Fall = false;
+  while (!Fall && fgets(Line, sizeof(Line), F)) {
+    Fall = !strncmp(Line, "fallback", 8);
+  }
+  fclose(F);
+  return Fall;
+}
