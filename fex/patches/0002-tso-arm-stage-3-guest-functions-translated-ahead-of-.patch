+
+void AOTEscalate(uint64_t PC) {
+  if (auto* L = AOT::LibOf(PC); L && L->EscalateFn) {
+    const char* Name = L->EscalateFn(PC);
+    if (Name && AOT::Log) {
+      fprintf(stderr, "tso-arm aot: %s runs ordered from its next call on\n", Name);
+    }
+  }
+}
+
+void AOTOrderAll() {
+  AOT::OrderAllWanted = true;
+  const int N = AOT::NumLibs.load(std::memory_order_acquire);
+  for (int i = 0; i < N; ++i) {
+    AOT::OrderAll(AOT::Libs[i]);
+  }
