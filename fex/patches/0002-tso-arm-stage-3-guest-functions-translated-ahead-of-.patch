+void TSOViewMemory::LearnHostMappings(uint64_t Below) {
+  const int Fd = OpenProc("self/maps");
+  if (Fd < 0) {
+    return;
+  }
+  // Lines of "start-end perms ...": read in pieces, a line's start kept across them
+  char Buf[4096];
+  size_t Have = 0;
+  for (;;) {
+    const ssize_t N = ::read(Fd, Buf + Have, sizeof(Buf) - Have);
+    if (N <= 0) {
+      break;
+    }
+    Have += N;
+    size_t Pos = 0;
+    for (;;) {
+      char* NL = static_cast<char*>(memchr(Buf + Pos, '\n', Have - Pos));
+      if (!NL) {
+        break;
+      }
+      *NL = 0;
+      char* Dash = nullptr;
+      const uint64_t Start = strtoull(Buf + Pos, &Dash, 16);
+      const uint64_t End = (Dash && *Dash == '-') ? strtoull(Dash + 1, nullptr, 16) : 0;
+      if (End > Start && Start < Below && Start >= 0x10000 && IsFree(Start, End - Start)) {
+        Ranges[Start] = {End, PROT_NONE, Kind::SharedFile, 0};
+      }
+      Pos = NL + 1 - Buf;
+    }
+    memmove(Buf, Buf + Pos, Have - Pos);
+    Have -= Pos;
+    if (Have == sizeof(Buf)) {
+      Have = 0; // a line longer than the buffer: not a mapping's start
+    }
+  }
+  ::close(Fd);
+}
