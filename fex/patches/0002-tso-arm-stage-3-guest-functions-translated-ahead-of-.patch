diff --git a/Source/Tools/LinuxEmulation/Thunks.cpp b/Source/Tools/LinuxEmulation/Thunks.cpp
index 9c018bc..52af55f 100644
--- a/Source/Tools/LinuxEmulation/Thunks.cpp
+++ b/Source/Tools/LinuxEmulation/Thunks.cpp
@@ -21,8 +21,19 @@ $end_info$
 #include <FEXCore/fextl/string.h>
 #include <FEXCore/fextl/unordered_map.h>
 
+#include <FEXCore/Core/Context.h>
+#include <FEXCore/Core/TSOViews.h>
+#include <FEXCore/fextl/vector.h>
+
+#include <atomic>
 #include <cstdint>
+#include <cstdio>
+#include <cstring>
 #include <dlfcn.h>
+#include <link.h>
+#include <sys/mman.h>
+#include <sys/uio.h>
+#include <unistd.h>
 
 #include <malloc.h>
 #include <mutex>
@@ -72,6 +83,299 @@ namespace FEX::HLE {
 
 static thread_local FEX::HLE::ThreadStateObject* ThreadObject {};
 
+// tso-arm: guest functions translated ahead of time (aot/ in the tso-arm repository). TSO_AOT names a library whose
+// table maps guest functions to host code. The block FEX makes for such a function's entry calls AOTBridge, a thunk,
+// which runs the host code and the function's return. The structures match aot/aot.h.
+namespace AOT {
+  struct Context {
+    uint8_t* View; // guest address a is at View + a (the thread's plain view; 0 without views)
+    uint64_t FSBase;
+    uint64_t (*GuestCall)(Context* C, uint64_t Target, uint64_t RSP, const uint64_t* Args);
+    void* Thread;
+    uint8_t* OView; // the thread's ordered view, for atomics (0 without views)
+  };
+
+  struct Entry {
+    uint64_t RIP;
+    uint64_t Size;
+    uint64_t Hash; // FNV-1a 64 of the guest function's bytes
+    // RSP: the guest stack pointer at the call (return address, stack arguments above it); Stack: where the
+    // translated code keeps what it puts on a guest stack
+    uint64_t (*Fn)(Context* C, uint64_t RSP, uint64_t Stack, const uint64_t* Args);
+    const char* Name;
+  };
+
+  constexpr int ArgRegs[6] = {FEXCore::X86State::REG_RDI, FEXCore::X86State::REG_RSI, FEXCore::X86State::REG_RDX,
+                              FEXCore::X86State::REG_RCX, FEXCore::X86State::REG_R8,  FEXCore::X86State::REG_R9};
+
+  // "tso-arm:aot-bridge", zero padded: the name under which the bridge is a thunk
+  constexpr FEXCore::IR::SHA256Sum BridgeSum = {
+    {'t', 's', 'o', '-', 'a', 'r', 'm', ':', 'a', 'o', 't', '-', 'b', 'r', 'i', 'd', 'g', 'e'}};
+
+  std::atomic<uint64_t> CodeStart {}, CodeEnd {};
+  bool Log {};
+  std::atomic<int> Logged {};
+  // The library's switches to the ordered variants: of the function a host pc lies in, and of all functions
+  const char* (*EscalateFn)(uint64_t PC) {}; // the name of the function switched, or null
+  void (*OrderAllFn)() {};
+  std::atomic<bool> OrderedAll {};
+
+  // A call from host code back into guest code that was not translated. RSP is the stack pointer the callee starts
+  // with (pointing at its return address slot); FEX's callback path puts its own return address there.
+  uint64_t GuestCall(Context* C, uint64_t Target, uint64_t RSP, const uint64_t* Args) {
+    auto* Thread = static_cast<FEXCore::Core::InternalThreadState*>(C->Thread);
+    auto& State = Thread->CurrentFrame->State;
+    if (Log && Logged.fetch_add(1) < 20) {
+      fprintf(stderr, "tso-arm aot: guest call %#lx\n", (unsigned long)Target);
+    }
+    const uint64_t SavedRSP = State.gregs[FEXCore::X86State::REG_RSP];
+    for (int i = 0; i < 6; ++i) {
+      State.gregs[ArgRegs[i]] = Args[i];
+    }
+    State.gregs[FEXCore::X86State::REG_RSP] = RSP + 16;
+    Thread->CTX->HandleCallback(Thread, Target);
+    const uint64_t Result = State.gregs[FEXCore::X86State::REG_RAX];
+    State.gregs[FEXCore::X86State::REG_RSP] = SavedRSP;
+    return Result;
+  }
+
+  // Each thread's own stack for translated code: the stack objects whose addresses the translated code hands out, and
+  // the frames of guest functions it calls. The thread allocates it itself, 2 MiB aligned, alone in its chunk of the
+  // page protocol: it stays private to the thread (the thread stacks themselves often end up shared, next to the
+  // pthread structures other threads touch).
+  constexpr uint64_t StackSize = 2ULL << 20;
+  thread_local uint64_t StackLow {}, StackTop {};
+
+  bool OnOwnStack(uint64_t RSP) {
+    return RSP > StackLow && RSP <= StackTop;
+  }
+
+  void Bridge(void* ArgPtr) {
+    const auto* E = static_cast<const Entry*>(ArgPtr);
+    auto* Thread = ThreadObject->Thread;
+    auto* Frame = Thread->CurrentFrame;
+    auto& G = Frame->State.gregs;
+    const uint64_t RSP = G[FEXCore::X86State::REG_RSP];
+    if (!StackTop) {
+      const auto P = reinterpret_cast<uint64_t>(FEX::HLE::_SyscallHandler->GuestMmap(
+        Thread, nullptr, 2 * StackSize, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS | MAP_NORESERVE, -1, 0));
+      if (static_cast<int64_t>(P) < 0 && static_cast<int64_t>(P) > -4096) {
+        ERROR_AND_DIE_FMT("tso-arm aot: no stack for translated code ({})", -static_cast<int64_t>(P));
+      }
+      StackLow = (P + StackSize - 1) & ~(StackSize - 1);
+      StackTop = StackLow + StackSize;
+    }
+    // Nested (translated code called guest code that called translated code again): continue below the caller
+    const uint64_t Stack = OnOwnStack(RSP) ? RSP : StackTop - 64;
+    uint64_t Args[6];
+    for (int i = 0; i < 6; ++i) {
+      Args[i] = G[ArgRegs[i]];
+    }
+    const uint64_t View = Frame->TSOViewBase;
+    Context C {reinterpret_cast<uint8_t*>(View), Frame->State.fs_cached, GuestCall, Thread,
+               reinterpret_cast<uint8_t*>(View ? View | FEXCore::TSOViews::OrderedBit : 0)};
+    // While the host code runs, the guest stack pointer in the context stays below anything in use, so that nothing
+    // put there meanwhile (a guest signal frame) overwrites it
+    G[FEXCore::X86State::REG_RSP] = OnOwnStack(RSP) ? RSP - 65536 : RSP - 4096;
+    const uint64_t Result = E->Fn(&C, RSP, Stack, Args);
+    G[FEXCore::X86State::REG_RAX] = Result;
+    Frame->State.rip = *reinterpret_cast<const uint64_t*>(RSP);
+    G[FEXCore::X86State::REG_RSP] = RSP + 8;
+  }
+
+  // Reads guest memory without faulting on an unmapped address
+  bool ReadGuest(uint64_t Address, void* Out, size_t Size) {
+    iovec Local {Out, Size};
+    iovec Remote {reinterpret_cast<void*>(Address), Size};
+    return process_vm_readv(getpid(), &Local, 1, &Remote, 1, 0) == static_cast<ssize_t>(Size);
+  }
+
+  uint64_t Hash(const uint8_t* P, size_t N) {
+    uint64_t H = 0xcbf29ce484222325ULL;
+    for (size_t i = 0; i < N; ++i) {
+      H = (H ^ P[i]) * 0x100000001b3ULL;
+    }
+    return H;
+  }
+
+  bool Listed(const char* List, const char* Name) {
+    const size_t N = strlen(Name);
+    for (const char* P = List; *P;) {
+      const char* End = strchr(P, ',');
+      const size_t L = End ? size_t(End - P) : strlen(P);
+      if (L == N && !strncmp(P, Name, N)) {
+        return true;
+      }
+      if (!End) {
+        break;
+      }
+      P = End + 1;
+    }
+    return false;
+  }
