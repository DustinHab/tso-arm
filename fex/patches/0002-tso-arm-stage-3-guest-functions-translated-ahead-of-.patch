+      if (S != 0) {
+        AliasNone(Start, L, SlotBase(S));
+      }
+      AliasNone(Start, L, OrderedViewBase(S));
+    }
+  }
+  R.ForkShared = false;
+  R.FileBacked = false;
+  R.CopyOnWrite = false;
+  Apply(Start, End);
+  return Bytes;
+}
+
+void TSOViewMemory::UnshareForkShared(uint64_t Addr, uint64_t Length, bool Files) {
+  const uint64_t End = Addr + Length;
+  SwapPages Swap;
+  auto It = Ranges.upper_bound(Addr);
+  if (It != Ranges.begin()) {
+    --It;
+  }
+  for (; It != Ranges.end() && It->first < End; ++It) {
+    if (!It->second.ForkShared || It->second.End <= Addr || (!Files && It->second.FileBacked) || It->second.CopyOnWrite) {
+      continue;
+    }
+    if (Unshare(It->first, It->second, Swap) < 0) {
+      LogMan::Msg::EFmt("tso-arm: {:#x}-{:#x} stays shared with a forked process: its copy failed", It->first, It->second.End);
+    } else {
+      VLOG("tso-arm: %#lx-%#lx no longer shared with a forked process\n", (unsigned long)It->first, (unsigned long)It->second.End);
+    }
+  }
+}
+
+bool TSOViewMemory::UnshareCopyOnWriteAt(const uint64_t* Addrs, int Count) {
+  std::lock_guard lk(Mutex);
+  bool Any = false;
+  SwapPages Swap;
+  for (int i = 0; i < Count; ++i) {
+    if (Addrs[i] >= Window) {
+      continue;
+    }
+    uint64_t RStart {};
+    Range* RM = FindMutable(Addrs[i], &RStart);
+    if (RM && RM->CopyOnWrite && (RM->Prot & PROT_WRITE) && Unshare(RStart, *RM, Swap) >= 0) {
+      VLOG("tso-arm: copy-on-write %#lx-%#lx copied for a system call\n", (unsigned long)RStart, (unsigned long)RM->End);
+      Any = true;
+    }
+  }
+  return Any;
+}
+
+void TSOViewMemory::DropForkDone() {
+  if (ForkDone) {
+    ::munmap(ForkDone, 1ULL << PageShift);
+    ForkDone = nullptr;
+  }
+}
+
+void TSOViewMemory::LockForFork() {
+  Mutex.lock();
+  // A pipe did this before, two descriptors at every fork: with the guest's descriptors nearly all in use (CPython's
+  // test_no_leaking) they were the last ones, and FEX's own pipe for vfork found none
+  auto* P = ::mmap(nullptr, 1ULL << PageShift, PROT_READ | PROT_WRITE, MAP_SHARED | MAP_ANONYMOUS, -1, 0);
+  ForkDone = P == MAP_FAILED ? nullptr : static_cast<uint32_t*>(P);
+}
+
+void TSOViewMemory::UnlockForFork() {
+  DropForkDone();
+  ThawAfterFork(); // a fork that failed, or a vfork
+  Mutex.unlock();
+}
+
+void TSOViewMemory::FreezeForFork(uint64_t Base) {
+  std::lock_guard lk(Mutex);
+  if (Stage1() || FallbackActive.load() || FEXCore::TSOViews::AsleepActive.load(std::memory_order_relaxed)) {
+    return; // asleep: one thread, and guest memory addressed directly
+  }
+  const int Me = IdentityBase() ? 0 : int(Base / Window);
+  bool Others = false;
+  for (int S = IdentityBase() ? 0 : 1; S < Slots; ++S) {
+    Others |= SlotUsed[S] && S != Me;
+  }
+  if (!Others) {
+    return; // one thread: nobody writes while the child copies
+  }
+  ForkFrozenSlot = Me;
+  Apply(0, Window);
+}
+
+void TSOViewMemory::ThawAfterFork() {
+  if (ForkFrozenSlot < 0) {
+    return;
+  }
+  ForkFrozenSlot = -1;
+  Apply(0, Window);
+  // A thread that writes the same word at every fork faults there once per fork; those faults are not the protocol
+  // being stuck (64 in a row at one address handed the fault to the guest: forksnap crashed after enough forks)
+  ForkEpoch.fetch_add(1, std::memory_order_relaxed);
+}
+
+void TSOViewMemory::AfterForkParent(pid_t Child) {
+  std::lock_guard lk(Mutex);
+  // The child copies after the fork, from memory this process still shares with it: until it is done, nothing here
+  // may write guest memory (the thread that forked waits here with the guest's fork locks held; the views' lock keeps
+  // the other threads' faults waiting). A child that dies on the way is seen by waitid without reaping it (WNOWAIT):
+  // the guest waits for it as it would.
+  if (!ForkDone) {
+    LogMan::Msg::EFmt("tso-arm: fork without a word to wait for the child's copy");
+  }
+  while (ForkDone && !__atomic_load_n(ForkDone, __ATOMIC_ACQUIRE)) {
+    const timespec Wait {0, 20'000'000};
+    ::syscall(SYS_futex, ForkDone, FUTEX_WAIT, 0, &Wait, nullptr, 0);
+    if (__atomic_load_n(ForkDone, __ATOMIC_ACQUIRE)) {
+      break;
+    }
+    siginfo_t Info {};
+    const int R = ::waitid(P_PID, Child, &Info, WEXITED | WNOHANG | WNOWAIT | __WALL);
+    if ((R == -1 && errno == ECHILD) || (R == 0 && Info.si_pid == Child)) {
+      break;
+    }
+  }
+  DropForkDone();
+  ThawAfterFork();
+  for (auto& [Start, R] : Ranges) {
+    if (R.K == Kind::Private && Start < Window && !(R.Prot & PROT_WRITE)) {
+      R.ForkShared = true;
+    }
+  }
+}
+
+void TSOViewMemory::AfterForkChild(uint64_t Base, bool Copy, void (*Copied)(void* Ctx, uint64_t Start, uint64_t Length), void* Ctx) {
+  // The forking thread held the lock across the fork; here it is the only thread, and the lock starts over
+  new (&Mutex) std::recursive_mutex;
+  ForkFrozenSlot = -1;
+  if (!Copy) {
+    DropForkDone();
+    return;
+  }
+  std::lock_guard lk(Mutex);
+  const uint64_t T0 = Nanos();
+  const int Me = IdentityBase() ? 0 : int(Base / Window);
+
+  // The other threads did not come along: their views go
+  for (int S = 1; S < Slots; ++S) {
+    if (!SlotUsed[S] || S == Me) {
+      continue;
+    }
+    for (auto& [Start, R] : Ranges) {
+      R.Aliased &= ~uint16_t(1U << S);
+    }
+    Reserve(SlotBase(S), Window);
+    Reserve(OrderedViewBase(S), Window);
+    SlotUsed[S] = false;
+    SlotUsers[S] = 0;
+  }
+  if (IsOwnerSlot(Me)) {
+    SlotUsers[Me] = 1;
+  }
+  // The profile so far is the parent's to write; the child writes it only if it learns something itself (a shell's
+  // children would otherwise rewrite it at every exit)
+  ProfileChanged = false;
+
+  // A single thread: every private page is its own (plain accesses), unless the process runs fully ordered
+  const bool Own = IsOwnerSlot(Me) && SlotUsed[Me] && !FallbackActive.load() && !Stage1();
