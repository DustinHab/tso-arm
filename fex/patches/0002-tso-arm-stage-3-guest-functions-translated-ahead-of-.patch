+        Result = PatchResult::Done;
+        Patched.fetch_add(1, std::memory_order_relaxed);
+        if (Log) {
+          fprintf(stderr, "tso-arm aot: patched %s at library+%#lx (stub %#lx)\n", Load ? "load" : "store",
+                  (unsigned long)(PC - CodeStart.load()), (unsigned long)reinterpret_cast<uint64_t>(S));
+        }
+      }
+    } else {
+      Result = PatchResult::Done; // patched meanwhile
+    }
+    PatchLock.store(false);
+    return Result;
+  }
+} // namespace AOT
+
+bool AOTPatch(uint64_t PC, uint32_t Insn) {
+  // Busy: this access is completed in the handler, the next fault patches
+  return AOT::Patch(PC, Insn) != AOT::PatchResult::Impossible;
+}
+
+namespace AOT {
+  // Room for stubs within branch range (+-128 MiB) of the library's code: 1 MiB, 32,768 stubs
+  void ReserveStubs() {
+    constexpr size_t Size = 1 << 20;
+    const uint64_t Start = CodeStart.load(), End = CodeEnd.load();
+    for (uint64_t Want : {Start - (2ULL << 20), End + (4ULL << 20), Start - (16ULL << 20), End + (32ULL << 20)}) {
+      void* P = ::mmap(reinterpret_cast<void*>(Want & ~0xFFFFFULL), Size, PROT_READ | PROT_WRITE | PROT_EXEC,
+                       MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+      if (P == MAP_FAILED) {
+        continue;
+      }
+      // library code and stubs together within 120 MiB: every branch between them reaches
+      const uint64_t A = reinterpret_cast<uint64_t>(P);
+      if (std::max(A + Size, End) - std::min(A, Start) < (120ULL << 20)) {
+        StubNext = static_cast<uint32_t*>(P);
+        StubEnd = StubNext + Size / 4;
+        return;
+      }
+      ::munmap(P, Size);
+    }
+    fprintf(stderr, "tso-arm aot: no room for stubs near the library; accesses to shared memory switch whole functions\n");
+  }
+} // namespace AOT
+
+void AOTEscalate(uint64_t PC) {
+  if (AOT::EscalateFn) {
+    const char* Name = AOT::EscalateFn(PC);
+    if (Name && AOT::Log) {
+      fprintf(stderr, "tso-arm aot: %s runs ordered from its next call on\n", Name);
+    }
+  }
+}
+
+void AOTOrderAll() {
+  if (AOT::OrderAllFn && !AOT::OrderedAll.exchange(true)) {
+    AOT::OrderAllFn();
+  }
+}
