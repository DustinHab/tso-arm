+void ContextImpl::AddAOTEntrypoint(uintptr_t Entrypoint, uintptr_t Hook, const IR::SHA256Sum& Bridge) {
+  AddCustomIREntrypoint(
+    Entrypoint,
+    [Hook, Bridge](uintptr_t Entrypoint, FEXCore::IR::IREmitter* emit) {
+      auto IRHeader = emit->_IRHeader(emit->Invalid(), Entrypoint, 0, 0, 0, 0);
+      auto Block = emit->CreateCodeNode(true, 0);
+      IRHeader.first->Blocks = emit->WrapNode(Block);
+      emit->SetCurrentCodeBlock(Block);
+      // The bridge runs the whole function and its return; registers come back from the context after the call
+      emit->_Thunk(emit->Constant(Hook), Bridge);
+      auto NewRIP = emit->_LoadContext(IR::OpSize::i64Bit, IR::RegClass::GPR, offsetof(Core::CPUState, rip));
+      emit->_ExitFunction(IR::OpSize::i64Bit, NewRIP, IR::BranchHint::Return, emit->Invalid(), emit->Invalid());
+    },
+    nullptr, (void*)Hook);
+}
