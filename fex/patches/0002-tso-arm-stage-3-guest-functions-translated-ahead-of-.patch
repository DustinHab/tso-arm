+
+  // tso-arm: routes the guest functions of the library named by TSO_AOT to their host translations (after the guest
+  // binary is mapped)
+  virtual void LoadAOT(FEXCore::Context::Context* CTX) = 0;
 };
 fextl::unique_ptr<ThunkHandler> CreateThunkHandler();
+
+// tso-arm: whether a host PC lies in the code of the TSO_AOT library
+bool IsAOTCode(uint64_t PC);
+// tso-arm: the translated function at host PC met shared memory: it runs its ordered variant from its next call on
+void AOTEscalate(uint64_t PC);
+// tso-arm: all translated functions ordered (the page protocol fell back to full ordering)
+void AOTOrderAll();
 } // namespace FEX::HLE
