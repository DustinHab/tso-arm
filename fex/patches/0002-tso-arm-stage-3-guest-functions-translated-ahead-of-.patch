+// tso-arm: the interface's pages made writable by the guest's own mprotect before the host copies its interface into
+// them. The host's mprotect alone failed under the page protocol (EACCES, "ERROR: Permission denied"): there a
+// read-only private file mapping is the file itself, mapped shared, and only the guest's mprotect, which the protocol
+// handles, makes it a copy of its own.
+static void ExchangeInterface(const wl_interface* Interface, const char* Name) {
+  const auto Addr = reinterpret_cast<uintptr_t>(Interface);
+  const auto Begin = Addr & ~uintptr_t {0xfff};
+  const auto Size = ((Addr & 0xfff) + sizeof(wl_interface) > 0x1000) ? 0x2000 : 0x1000;
+  mprotect(reinterpret_cast<void*>(Begin), Size, PROT_READ | PROT_WRITE);
+  fex_wl_exchange_interface_pointer(const_cast<wl_interface*>(Interface), Name);
+}
