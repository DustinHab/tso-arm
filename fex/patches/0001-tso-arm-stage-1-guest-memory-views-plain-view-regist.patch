+// tso-arm: guest address -> plain view (+ REG_VIEW) or ordered view (| OrderedBase)
+DEF_OP(ViewPlain) {
+  const auto Op = IROp->C<IR::IROp_ViewPlain>();
+  const auto Dst = GetReg(Node);
+  uint64_t Const;
+  if (IsInlineConstant(Op->Addr, &Const)) {
+    LoadConstant(ARMEmitter::Size::i64Bit, Dst, Const);
+    add(ARMEmitter::Size::i64Bit, Dst, Dst, REG_VIEW.R());
+  } else {
+    add(ARMEmitter::Size::i64Bit, Dst, GetReg(Op->Addr), REG_VIEW.R());
+  }
+}
+
+DEF_OP(ViewOrdered) {
+  const auto Op = IROp->C<IR::IROp_ViewOrdered>();
+  const auto Dst = GetReg(Node);
+  uint64_t Const;
+  if (IsInlineConstant(Op->Addr, &Const)) {
+    LoadConstant(ARMEmitter::Size::i64Bit, Dst, Const | FEXCore::TSOViews::OrderedBase);
+  } else {
+    orr(ARMEmitter::Size::i64Bit, Dst, GetReg(Op->Addr), FEXCore::TSOViews::OrderedBase);
+  }
+}
+
+// Views on for this (64-bit) guest: stack and string operations address guest memory through them.
+static bool ViewsOn(const FEXCore::Context::ContextImpl* CTX) {
+  return FEXCore::TSOViews::Enabled() && CTX->Config.Is64BitMode();
+}
