new file mode 100644
index 0000000..222c8a4
--- /dev/null
+++ b/Source/Tools/LinuxEmulation/LinuxSyscalls/TSOViews.h
@@ -0,0 +1,56 @@
+// SPDX-License-Identifier: MIT
+// tso-arm: guest memory as shared memory, mapped again in an ordered view and in one plain view per thread.
+// Layout and switch: FEXCore/include/FEXCore/Core/TSOViews.h
+#pragma once
+#include <FEXCore/Core/TSOViews.h>
+
+#include <cstdint>
+#include <map>
+#include <mutex>
+#include <sys/types.h>
+
+namespace FEX::HLE {
+class TSOViewMemory {
+public:
+  // nullptr if views are off or could not be set up
+  static TSOViewMemory* Get();
+
+  // Guest mmap for a 64-bit guest. Places non-fixed mappings in the window, backs private memory with shared
+  // memory and maps it into every view. Returns the address or -errno.
+  int64_t Mmap(uint64_t Addr, uint64_t Length, int Prot, int Flags, int Fd, off_t Offset);
+  int64_t Munmap(uint64_t Addr, uint64_t Length);
+  int64_t Mprotect(uint64_t Addr, uint64_t Length, int Prot);
+  int64_t Mremap(uint64_t Old, uint64_t OldSize, uint64_t NewSize, int Flags, uint64_t New);
+  // MADV_DONTNEED and MADV_FREE on memory that is private for the guest: shared memory keeps its contents under
+  // MADV_DONTNEED, so the pages are removed instead (they read as zero afterwards, as private memory would)
+  int64_t Madvise(uint64_t Addr, uint64_t Length, int Advice);
+
+  // A new thread's plain view; 0 if no slot is free (the thread then cannot run with views)
+  uint64_t AttachThread();
+  void DetachThread(uint64_t Base);
+
+private:
+  enum class Kind : uint8_t { Private, SharedAnon, SharedFile };
+  struct Range {
+    uint64_t End;
+    int Prot;
+    Kind K;
+  };
+
+  bool Init();
+  uint64_t ChooseAddress(uint64_t Hint, uint64_t Length) const;
+  bool IsFree(uint64_t Addr, uint64_t Length) const;
+  void Insert(uint64_t Addr, uint64_t End, int Prot, Kind K);
+  void Erase(uint64_t Addr, uint64_t End);
+  void AliasEverywhere(uint64_t Addr, uint64_t Length, int Prot);
+  void ReserveEverywhere(uint64_t Addr, uint64_t Length);
+  void ProtectEverywhere(uint64_t Addr, uint64_t Length, int Prot);
+  static bool Alias(uint64_t Addr, uint64_t Length, uint64_t Base, int Prot);
+  static void Reserve(uint64_t Base, uint64_t Length);
+
+  std::recursive_mutex Mutex;
+  std::map<uint64_t, Range> Ranges; // guest mappings by start address, split where the protection differs
+  bool SlotUsed[FEXCore::TSOViews::Slots] {};
+  bool SlotUsable[FEXCore::TSOViews::Slots] {};
+};
+} // namespace FEX::HLE
