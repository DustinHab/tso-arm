   uint32_t SuspendDoorbell {};
diff --git a/FEXCore/include/FEXCore/Core/TSOViews.h b/FEXCore/include/FEXCore/Core/TSOViews.h
new file mode 100644
index 0000000..bff861d
--- /dev/null
+++ b/FEXCore/include/FEXCore/Core/TSOViews.h
@@ -0,0 +1,43 @@
+// SPDX-License-Identifier: MIT
+// tso-arm: layout of the guest memory views used to elide TSO ordering for memory that only one thread uses.
+//
+// Guest memory lives in [0, Window). Every guest mapping is shared memory and is mapped again
+// - in the ordered view at OrderedBase + guest address,
+// - in one plain view per thread at Slot * Window + guest address.
+// Translated code reaches guest memory only through the views; the identity mapping stays for the kernel and the
+// runtime. Since every view base is a multiple of Window, (view address & (Window - 1)) is the guest address.
+#pragma once
+#include <cstdint>
+#include <cstdlib>
+
+namespace FEXCore::TSOViews {
+constexpr uint64_t WindowBits = 34;
+constexpr uint64_t Window = 1ULL << WindowBits;  // 16 GB
+constexpr uint64_t OrderedBase = 1ULL << 37;     // slot 8; a single bit, so `orr` forms ordered addresses
+constexpr uint64_t AllocLow = 1ULL << 32;        // non-fixed guest mappings are placed in [4 GB, Window)
+constexpr int Slots = 16;                         // slots 1..15 except OrderedBase / Window
+constexpr int OrderedSlot = OrderedBase / Window;
+
+inline bool Enabled() {
+  static const bool On = [] {
+    const char* E = getenv("TSO_VIEWS");
+    return E && E[0] == '1';
+  }();
+  return On;
+}
+
+// Measurement knobs. TSO_VIEWS_IDENTITY=1: every thread's plain view base is 0 (the identity mapping), so the
+// address arithmetic runs but no view is used. TSO_VIEWS_NOPASS=1: the address rewriting pass is not run.
+inline bool Knob(const char* Name) {
+  const char* E = getenv(Name);
+  return E && E[0] == '1';
+}
+inline bool IdentityBase() {
+  static const bool On = Knob("TSO_VIEWS_IDENTITY");
+  return On;
+}
+inline bool RewritePass() {
+  static const bool On = !Knob("TSO_VIEWS_NOPASS");
+  return On;
+}
+} // namespace FEXCore::TSOViews
