#!/bin/sh
# tso-arm: x86-64 Linux programs on 64-bit Arm with x86's memory order kept, and fast: FEX with the page protocol
# (only memory that threads really share is ordered) and hot functions translated ahead of time.
# https://github.com/DustinHab/tso-arm
set -e
REPO=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
PREFIX=${TSO_ARM_PREFIX:-$HOME/.local/opt/tso-arm}
CACHE=${XDG_CACHE_HOME:-$HOME/.cache}/tso-arm
# FEX's multiblock compiles up to this many guest instructions from each entry (FEX's own default: 5000). Large
# functions entered at many points (after each call) were compiled again and again: ffmpeg 3.7 instead of 2.2 s,
# Node 9.4 instead of 6.2 s; the hot loops of pigz, xz and others lose nothing that counts (notes section 43)
export FEX_MAXINST=${FEX_MAXINST:-150}

die() {
    echo "tso-arm: $*" >&2
    exit 1
}

usage() {
    cat <<EOF
usage: tso-arm COMMAND [...]

  run [--mode MODE] [--aot LIBRARY | --no-aot] [--stats] PROGRAM [ARGS...]
        run an x86-64 Linux program. MODE: tso (default; x86 memory order kept, with the page protocol and what
        'learn' translated), full (FEX's own full ordering), unordered (fastest, not correct for programs whose
        threads share data without locks). --aot: a library of translated functions other than the learned one;
        --no-aot: without what 'learn' translated.
        --stats: what the page protocol did, at the end (shared pages, ordered instructions, fallback)
  learn PROGRAM [ARGS...]
        profile an x86-64 program, translate its hot functions ahead of time and check them against a run
        without; later runs use them. Static and position-independent programs; of a dynamically linked one its
        own functions (its libraries stay with FEX). A program that falls back to full ordering is timed with
        pages moving between its threads as well, and keeps that where it is faster. Runs the program several
        times with these arguments: give it an input whose processing has no side effects (stdin is empty, the
        output is compared)
  status [PROGRAM]      what tso-arm has learned
  forget PROGRAM        drop what it learned about PROGRAM
  check                 whether this machine can run tso-arm
  install [--source | --generic]
        install FEX with the tso-arm patches into $PREFIX and the command into ~/.local/bin: the prebuilt FEX
        of this release (from its package, or fetched from GitHub), otherwise built from source.
        --source: built from source for this machine's core; --generic: from source for any Armv8.0 core
  uninstall [--all]     remove FEX and the command again (--all: what 'learn' translated as well)
  rootfs [OPTIONS]      fetch an x86-64 root file system for dynamically linked programs with FEX's own tool:
        without options Ubuntu 24.04, unpacked (about 2 GB); with options the tool's own (rootfs --help)
  binfmt [register | unregister]
        whether x86-64 programs started directly (./program) run through tso-arm; register and unregister change
        that for the whole system (binfmt_misc, and /etc/binfmt.d for after a reboot) and need root
  version               this version and the FEX it uses
EOF
}

cmd_version() {
    v=$(cat "$REPO/VERSION" 2>/dev/null || echo unknown)
    if [ -e "$REPO/.git" ]; then
        v="$v$(git -C "$REPO" describe --always --dirty 2>/dev/null | sed 's/^/ (/; s/$/)/')"
    fi
    echo "tso-arm $v"
    F=$(fex 2>/dev/null) || {
        echo "FEX: not installed ('tso-arm install')"
        return
    }
    b="$(dirname "$(dirname "$F")")/BUILD"
    if [ -f "$b" ]; then
        echo "FEX: $(sed -n 's/^fex //p' "$b"), $(sed -n 's/^built //p' "$b"), patches $(sed -n 's/^patches //p' "$b")"
    else
        echo "FEX: $F"
    fi
}

cmd_uninstall() {
    if [ -x "$PREFIX/bin/FEX" ]; then
        rm -rf "$PREFIX"
        echo "tso-arm: removed $PREFIX"
    fi
    l="$HOME/.local/bin/tso-arm"
    if [ -L "$l" ] && [ "$(readlink -f "$l")" = "$REPO/bin/tso-arm" ]; then
        rm -f "$l"
        echo "tso-arm: removed $l"
    fi
    if [ "${1:-}" = --all ]; then
        rm -rf "$CACHE"
        echo "tso-arm: removed $CACHE"
    elif [ -d "$CACHE" ]; then
        echo "tso-arm: kept what it learned in $CACHE ('tso-arm uninstall --all' removes it)"
    fi
    if [ -d "$HOME/.local/src/tso-arm" ]; then
        echo "tso-arm: the FEX source of an earlier build is in ~/.local/src/tso-arm"
    fi
}

# Whether FEX has an x86-64 root file system for dynamically linked programs: FEX_ROOTFS, or "RootFS" in its
# configuration, which it reads where FEX does (Source/Common/Config.cpp): FEX_APP_CONFIG_LOCATION, else ~/.fex-emu
# if that exists, else $XDG_CONFIG_HOME/fex-emu (~/.config/fex-emu); or in the configuration of the FEX installed
has_rootfs() {
    [ -n "$FEX_ROOTFS" ] && return 0
    if [ -n "$FEX_APP_CONFIG_LOCATION" ]; then
        c=$FEX_APP_CONFIG_LOCATION
    elif [ -d "$HOME/.fex-emu" ]; then
        c=$HOME/.fex-emu/
    else
        c=${XDG_CONFIG_HOME:-$HOME/.config}/fex-emu/
    fi
    grep -qs '"RootFS"' "${c%/}/Config.json" "$PREFIX/share/fex-emu/Config.json"
}

# binfmt_misc: x86-64 ELF files, executables and position-independent ones (the magic and mask qemu-user registers)
BINFMT_MAGIC='\x7fELF\x02\x01\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x02\x00\x3e\x00'
BINFMT_MASK='\xff\xff\xff\xff\xff\xfe\xfe\x00\xff\xff\xff\xff\xff\xff\xff\xff\xfe\xff\xff\xff'

cmd_binfmt() {
    d=/proc/sys/fs/binfmt_misc
    conf=/etc/binfmt.d/tso-arm.conf
    [ -f "$d/status" ] || die "binfmt_misc is not mounted here ($d)"
    case ${1:-} in
    "")
        if [ -f "$d/tso-arm" ]; then
            echo "x86-64 programs started directly run through tso-arm ($(head -n 1 "$d/tso-arm"), $(sed -n 's/^interpreter //p' "$d/tso-arm"))"
        else
            echo "x86-64 programs started directly do not run through tso-arm ('sudo $REPO/bin/tso-arm binfmt register')"
        fi
        for f in "$d"/*; do
            case $(basename "$f") in register | status | tso-arm) continue ;; esac
            if grep -q '^magic 7f454c4602010100000000000000000002003e00' "$f" 2>/dev/null; then
                echo "another handler for x86-64 programs: $(basename "$f") ($(sed -n 's/^interpreter //p' "$f")); the one registered last is asked first"
            fi
        done
        ;;
    register)
        [ "$(id -u)" = 0 ] || die "binfmt register changes the system and needs root: sudo $REPO/bin/tso-arm binfmt register"
        # the kernel reads the \x escapes itself; the line goes to it as written
        line=":tso-arm:M::$BINFMT_MAGIC:$BINFMT_MASK:$REPO/bin/tso-arm-binfmt:"
        if [ -f "$d/tso-arm" ]; then
            echo -1 >"$d/tso-arm"
        fi
        printf '%s\n' "$line" >"$d/register"
        mkdir -p "$(dirname "$conf")"
        printf '%s\n' "$line" >"$conf"
        echo "tso-arm: x86-64 programs started directly run through $REPO/bin/tso-arm-binfmt now, and after a reboot ($conf)"
        ;;
    unregister)
        [ "$(id -u)" = 0 ] || die "binfmt unregister changes the system and needs root: sudo $REPO/bin/tso-arm binfmt unregister"
        if [ -f "$d/tso-arm" ]; then
            echo -1 >"$d/tso-arm"
        fi
        rm -f "$conf"
        echo "tso-arm: x86-64 programs started directly no longer run through tso-arm"
        ;;
    *) die "binfmt: register, unregister, or nothing for the state" ;;
    esac
}

fex() {
    for f in "$TSO_ARM_FEX" "$PREFIX/bin/FEX" "$HOME/opt/fex-views/bin/FEX"; do
        if [ -n "$f" ] && [ -x "$f" ]; then
            # an installed FEX says which patches it was built with; translated code and FEX must agree on them
            b="$(dirname "$(dirname "$f")")/BUILD"
            if [ -f "$b" ]; then
                have=$(sed -n 's/^patches //p' "$b")
                want=$(cat "$REPO"/fex/patches/*tso-arm-stage*.patch | sha256sum | cut -c1-16)
                [ "$have" = "$want" ] ||
                    die "the FEX in $(dirname "$(dirname "$f")") was built with other patches ($have) than this tso-arm has ($want): 'tso-arm install' brings it up to date"
            fi
            echo "$f"
            return
        fi
    done
    die "FEX with the tso-arm patches not found: run 'tso-arm install' (or set TSO_ARM_FEX)"
}

# static | pie | dynamic | other: what kind of program the file is
kind() {
    command -v readelf >/dev/null || die "readelf not found (binutils)"
    h=$(LC_ALL=C readelf -h "$1" 2>/dev/null) || {
        echo other
        return
    }
    echo "$h" | grep -q 'Machine:.*X86-64' || {
        echo other
        return
    }
    if LC_ALL=C readelf -lW "$1" 2>/dev/null | grep -q 'INTERP'; then
        echo dynamic
    elif echo "$h" | grep -q 'Type:.*DYN'; then
        echo pie
    else
        echo static
    fi
}

# the name the ahead-of-time library of a program is kept under: its file name and its build ID, or a hash of its
# contents when it has none (the build ID saves reading a large program at every start; FEX checks every translated
# function against the program's code before it uses it either way)
key() {
    p=$(readlink -f "$1")
    id=$(LC_ALL=C readelf -n "$p" 2>/dev/null | sed -n 's/^ *Build ID: *//p' | cut -c1-16)
    if [ -z "$id" ]; then
        id=$(sha256sum "$p" | cut -c1-16)
    fi
    echo "$(basename "$p")-$id"
}

cmd_run() {
    mode=tso
    aot=""
    while [ $# -gt 0 ]; do
        case $1 in
        --mode)
            mode=$2
            shift 2
            ;;
        --aot)
            aot=$(readlink -f "$2")
            [ -f "$aot" ] || die "no library $2"
            shift 2
            ;;
        --stats)
            export TSO_VIEWS_STATS=1
            shift
            ;;
        --no-aot)
            aot=/dev/null/none
            shift
            ;;
        --mode=*)
            mode=${1#*=}
            shift
            ;;
        --)
            shift
            break
            ;;
        -*) die "unknown option $1" ;;
        *) break ;;
        esac
    done
    [ $# -ge 1 ] || die "run: which program?"
    prog=$1
    shift
    [ -f "$prog" ] || prog=$(command -v "$prog" 2>/dev/null) || die "no program $prog"
    k=$(kind "$prog")
    [ "$k" = other ] && die "$prog is not an x86-64 Linux program"
    if [ "$k" = dynamic ] && ! has_rootfs; then
        die "$prog is dynamically linked and needs an x86-64 root file system: 'tso-arm rootfs' fetches one (or set FEX_ROOTFS to a directory with the x86-64 libraries)"
    fi
    F=$(fex)
    # FEX takes the root file system from its server, which lives as long as programs it started run (and a second
    # after): one started with another root file system serves this program too, whatever FEX_ROOTFS says
    if [ -n "$FEX_ROOTFS" ] && [ "$k" = dynamic ] && pgrep -u "$(id -u)" -x FEXServer >/dev/null 2>&1; then
        r=$("$(dirname "$F")/FEXGetConfig" --current-rootfs 2>/dev/null)
        if [ -n "$r" ] && [ "$(readlink -f "$r")" != "$(readlink -f "$FEX_ROOTFS")" ]; then
            echo "tso-arm: FEX's server serves the root file system $r until the FEX programs started with it have ended; FEX_ROOTFS=$FEX_ROOTFS takes effect after that" >&2
        fi
    fi
    lib=${aot:-"$CACHE/aot/$(key "$prog").so"}
    export FEX_DISABLETELEMETRY=${FEX_DISABLETELEMETRY:-1}
    case $mode in
    tso)
        export TSO_VIEWS=1 FEX_VECTORTSOENABLED=1 FEX_MEMCPYSETTSOENABLED=1
        translated
        ;;
    full)
        export FEX_TSOENABLED=1 FEX_VECTORTSOENABLED=1 FEX_MEMCPYSETTSOENABLED=1
        ;;
    unordered)
        export FEX_TSOENABLED=0
        translated
        ;;
    *) die "unknown mode $mode (tso, full, unordered)" ;;
    esac
    # Go's runtime preempts a goroutine with SIGURG and resumes it at the interrupted instruction with the registers
    # its handler saw. The patched FEX delivers such a signal at an instruction start (notes section 54); only with
    # that turned off (TSO_EXACT_SIGNALS=0) is Go's asynchronous preemption turned off too, as before: goroutines stop
    # at Go's own safe points then. Only Go programs read GODEBUG.
    if [ "${TSO_EXACT_SIGNALS:-1}" = 0 ]; then
        case ",${GODEBUG:-}," in
        *,asyncpreemptoff=*) ;;
        *) export GODEBUG="${GODEBUG:+$GODEBUG,}asyncpreemptoff=1" ;;
        esac
    fi
    exec "$F" "$prog" "$@"
}

# what `learn` translated: the program's library (TSO_AOT, for this program only: programs it starts with execve look
# theirs up), and the shared libraries' in the cache, which FEX takes when the program maps them (TSO_AOT_DIR)
translated() {
    [ "$aot" = /dev/null/none ] && return
    export TSO_AOT_DIR="$CACHE/aot"
    if [ -f "$lib" ]; then
        export TSO_AOT="$lib" TSO_AOT_FOR="$(readlink -f "$prog")"
    fi
    if [ -f "$lib" ] || [ -f "$lib.libs" ]; then
        # block by block unless learn found multiblock faster (much of the program untranslated)
        export FEX_MULTIBLOCK=$([ -f "$lib.multiblock" ] && echo 1 || echo 0)
    fi
}

cmd_learn() {
    [ $# -ge 1 ] || die "learn: which program?"
    prog=$1
    shift
    [ -f "$prog" ] || prog=$(command -v "$prog" 2>/dev/null) || die "no program $prog"
    case $(kind "$prog") in
    static | pie) ;;
    dynamic)
        if ! has_rootfs; then
            die "$prog is dynamically linked and needs an x86-64 root file system: 'tso-arm rootfs' fetches one (or set FEX_ROOTFS)"
        fi
        echo "tso-arm: $(basename "$prog") is dynamically linked: its own functions are translated, and those of its shared libraries (for every program that uses them)"
        ;;
    *) die "$prog is not an x86-64 Linux program" ;;
    esac
    for t in python3 clang perf; do
        command -v $t >/dev/null || die "learn needs $t"
    done
    python3 -c 'import capstone' 2>/dev/null || die "learn needs the Python module capstone (pip install capstone)"
    mkdir -p "$CACHE/aot"
    out="$CACHE/aot/$(key "$prog").so"
    TSO_ARM_FEX=$(fex) python3 "$REPO/aot/auto.py" "$prog" "$out" --libdir "$CACHE/aot" --timed -- "$@"
    n=0
    [ -f "$out" ] && n=$(wc -l <"$out.list")
    libs=""
    [ -f "$out.libs" ] && libs=" and of $(wc -l <"$out.libs") of its shared libraries"
    if [ -f "$out" ] || [ -f "$out.libs" ]; then
        echo "tso-arm: learned $n functions of $(basename "$prog")$libs; 'tso-arm run' uses them from now on"
    elif [ -f "$out.slower" ]; then
        echo "tso-arm: the $(wc -l <"$out.list") translated functions made $(basename "$prog") slower on this machine; 'tso-arm run' goes on without them"
    else
        echo "tso-arm: nothing of $(basename "$prog") to translate ahead of time; 'tso-arm run' runs it with FEX alone"
    fi
}

cmd_status() {
    if [ $# -ge 1 ]; then
        lib="$CACHE/aot/$(key "$1").so"
        if [ -f "$lib" ]; then
            echo "$(basename "$1"): $(wc -l <"$lib.list") functions translated ahead of time"
        elif [ -f "$lib.slower" ]; then
            echo "$(basename "$1"): $(wc -l <"$lib.list") functions translated ahead of time, not used: slower on this machine"
        elif [ ! -f "$lib.libs" ]; then
            echo "$(basename "$1"): nothing translated ahead of time"
        fi
        if [ -f "$lib.libs" ]; then
            while read -r k; do
                l="$CACHE/aot/$k.so"
                [ -f "$l.list" ] && echo "$(basename "$1"): its shared library ${k%-*}: $(wc -l <"$l.list") functions translated ahead of time"
            done <"$lib.libs"
        fi
        # each profile (one per program file) and what its runs do: the page protocol, full ordering past the fault
        # budget, or pages moving between threads ('learn' found it faster)
        n=0
        for p in "$CACHE"/"$(basename "$1")"-*.prof; do
            [ -f "$p" ] || continue
            n=$((n + 1))
            if grep -q '^fallback' "$p"; then
                s="full ordering (its threads share too much for the page protocol)"
            elif grep -q '^migrate' "$p"; then
                s="pages move between its threads ('learn' found it faster)"
            else
                s="page protocol"
            fi
            echo "$(basename "$1"): $s, $(grep -c '^esc' "$p") code ranges ordered ($(basename "$p"))"
        done
        [ $n -gt 0 ] || echo "$(basename "$1"): no page protocol profile yet"
        return
    fi
    echo "translated ahead of time ($CACHE/aot):"
    for l in "$CACHE"/aot/*.so.list; do
        [ -f "$l" ] || continue
        if [ -f "${l%.list}" ]; then
            echo "  $(basename "$l" .so.list): $(wc -l <"$l") functions"
        else
            echo "  $(basename "$l" .so.list): $(wc -l <"$l") functions, not used (slower on this machine)"
        fi
    done
    echo "page protocol profiles: $(ls "$CACHE"/*.prof 2>/dev/null | wc -l)"
}

cmd_forget() {
    [ $# -ge 1 ] || die "forget: which program?"
    # the program's own; libraries of its shared libraries serve other programs as well and stay
    rm -f "$CACHE/aot/$(key "$1").so" "$CACHE/aot/$(key "$1").so.slower" "$CACHE/aot/$(key "$1").so.list" \
        "$CACHE/aot/$(key "$1").so.multiblock" "$CACHE/aot/$(key "$1").so.libs" "$CACHE/aot/$(key "$1").c"
    rm -f "$CACHE"/"$(basename "$1")"-*.prof
    echo "tso-arm: forgot $(basename "$1")"
}

cmd_rootfs() {
    F=$(fex)
    fetcher="$(dirname "$F")/FEXRootFSFetcher"
    [ -x "$fetcher" ] || die "FEXRootFSFetcher not found next to $F"
    # without options: Ubuntu 24.04, unpacked, without questions (what tso-arm is tested with); with options, the
    # fetcher's own (--help)
    [ $# -gt 0 ] || set -- -y -x --distro-name=ubuntu --distro-version=24.04
    exec "$fetcher" "$@"
}

case ${1:-} in
run) shift && cmd_run "$@" ;;
learn) shift && cmd_learn "$@" ;;
status) shift && cmd_status "$@" ;;
forget) shift && cmd_forget "$@" ;;
check) exec sh "$REPO/tools/board_check.sh" ;;
install) shift && exec sh "$REPO/fex/install.sh" "$@" ;;
uninstall) shift && cmd_uninstall "$@" ;;
rootfs) shift && cmd_rootfs "$@" ;;
binfmt) shift && cmd_binfmt "$@" ;;
version | --version) cmd_version ;;
-h | --help | help | "") usage ;;
*) usage >&2 && exit 1 ;;
esac
