#!/bin/sh
# tso-arm: x86-64 Linux programs on 64-bit Arm with x86's memory order kept, and fast: FEX with the page protocol
# (only memory that threads really share is ordered) and hot functions translated ahead of time.
# https://github.com/DustinHab/tso-arm
set -e
REPO=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
PREFIX=${TSO_ARM_PREFIX:-$HOME/.local/opt/tso-arm}
CACHE=${XDG_CACHE_HOME:-$HOME/.cache}/tso-arm
# FEX's multiblock compiles up to this many guest instructions from each entry (FEX's own default: 5000). Large
# functions entered at many points (after each call) were compiled again and again: ffmpeg 3.7 instead of 2.2 s,
# Node 9.4 instead of 6.2 s; the hot loops of pigz, xz and others lose nothing that counts (notes section 43)
export FEX_MAXINST=${FEX_MAXINST:-150}

die() {
    echo "tso-arm: $*" >&2
    exit 1
}

usage() {
    cat <<EOF
usage: tso-arm COMMAND [...]

  run [--mode MODE] [--aot LIBRARY | --no-aot] [--gpu] [--stats] PROGRAM [ARGS...]
        run an x86-64 or 32-bit x86 Linux program. MODE: tso (default; x86 memory order kept, with the page
        protocol and what 'learn' translated; a 32-bit program as with full), full (FEX's own full ordering),
        unordered (fastest, not correct for programs whose threads share data without locks). --aot: a library of translated functions other than the learned one;
        --no-aot: without what 'learn' translated.
        --stats: what the page protocol did, at the end (shared pages, ordered instructions, fallback)
        --gpu: OpenGL and Vulkan through the host's own libraries and GPU driver (FEX's thunks; TSO_ARM_THUNKS=1
        does the same, for programs started directly as well)
  learn PROGRAM [ARGS...]
        profile an x86-64 program, translate its hot functions ahead of time and check them against a run
        without; later runs use them. Static and position-independent programs; of a dynamically linked one its
        own functions (its libraries stay with FEX). A program that falls back to full ordering is timed with
        pages moving between its threads as well, and keeps that where it is faster. Runs the program several
        times with these arguments: give it an input whose processing has no side effects (stdin is empty, the
        output is compared)
  status [PROGRAM]      what tso-arm has learned
  forget PROGRAM        drop what it learned about PROGRAM
  check                 whether this machine can run tso-arm
  install [--source | --generic]
        install FEX with the tso-arm patches into $PREFIX and the command into ~/.local/bin: the prebuilt FEX
        of this release (from its package, or fetched from GitHub), otherwise built from source.
        --source: built from source for this machine's core; --generic: from source for any Armv8.0 core
  update                the newest release, for an installation made with tools/get.sh (the one-line install)
  uninstall [--all]     remove FEX and the command again (--all: what 'learn' translated as well)
  rootfs [OPTIONS]      fetch an x86-64 root file system for dynamically linked programs with FEX's own tool:
        without options Ubuntu 24.04, unpacked (about 2 GB); with options the tool's own (rootfs --help)
  binfmt [register | unregister]
        whether x86 programs started directly (./program) run through tso-arm; register and unregister change
        that for the whole system (binfmt_misc, and /etc/binfmt.d for after a reboot) and need root
  wine [install [VERSION] | PROGRAM.exe [ARGS...]]
        Windows programs through Wine: WineHQ's build for Ubuntu 24.04 (the root file system's distribution),
        fetched into ~/.local/share/tso-arm/wine on first use; needs the root file system ('tso-arm rootfs')
  version               this version and the FEX it uses
  report [PROGRAM [ARGS...]]
        what a bug report needs, to paste: versions, machine, root file system; with a program, what tso-arm knows
        of it and how it ends in each mode (it runs once per mode, stdin empty, output discarded, at most 60 s)
EOF
}

cmd_version() {
    v=$(cat "$REPO/VERSION" 2>/dev/null || echo unknown)
    if [ -e "$REPO/.git" ]; then
        v="$v$(git -C "$REPO" describe --always --dirty 2>/dev/null | sed 's/^/ (/; s/$/)/')"
    fi
    echo "tso-arm $v"
    F=$(fex 2>/dev/null) || {
        echo "FEX: not installed ('tso-arm install')"
        return
    }
    b="$(dirname "$(dirname "$F")")/BUILD"
    if [ -f "$b" ]; then
        echo "FEX: $(sed -n 's/^fex //p' "$b"), $(sed -n 's/^built //p' "$b"), patches $(sed -n 's/^patches //p' "$b")"
    else
        echo "FEX: $F"
    fi
}

# An installation by tools/get.sh: versions side by side in one directory, "current" the link to the one in use (this
# one). Prints that directory.
installed_dir() {
    d=$(dirname "$REPO")
    [ -L "$d/current" ] && [ "$(readlink -f "$d/current")" = "$REPO" ] && echo "$d"
}

cmd_update() {
    d=$(installed_dir) || {
        if [ -e "$REPO/.git" ]; then
            die "this is a git checkout ($REPO): 'git -C $REPO pull' and then 'tso-arm install' bring it up to date"
        fi
        die "this copy in $REPO was not installed by tools/get.sh; install the newest release that way (README) or unpack it by hand"
    }
    [ -w "$d" ] || die "$d belongs to another user: 'sudo tso-arm update'"
    TSO_ARM_DEST=$d exec sh "$REPO/tools/get.sh"
}

cmd_uninstall() {
    if inst=$(installed_dir) && [ -n "$inst" ]; then
        # installed by tools/get.sh: the whole directory, the command's link, and binfmt_misc where it points here
        [ -w "$inst" ] || die "$inst belongs to another user: 'sudo tso-arm uninstall'"
        if [ "$(id -u)" = 0 ] && grep -qs "$inst/" /proc/sys/fs/binfmt_misc/tso-arm /proc/sys/fs/binfmt_misc/tso-arm-i386; then
            (cmd_binfmt unregister)
        fi
        for l in /usr/local/bin/tso-arm "$HOME/.local/bin/tso-arm"; do
            if [ -L "$l" ] && [ "$(readlink "$l")" = "$inst/current/bin/tso-arm" ]; then
                rm -f "$l"
                echo "tso-arm: removed $l"
            fi
        done
        case $inst in
        / | /opt | /usr | /usr/local | "$HOME" | "$HOME/.local" | "$HOME/.local/share") die "will not remove $inst" ;;
        esac
        rm -rf "$inst"
        echo "tso-arm: removed $inst"
    fi
    if [ -x "$PREFIX/bin/FEX" ]; then
        rm -rf "$PREFIX"
        echo "tso-arm: removed $PREFIX"
    fi
    l="$HOME/.local/bin/tso-arm"
    if [ -L "$l" ] && [ "$(readlink -f "$l")" = "$REPO/bin/tso-arm" ]; then
        rm -f "$l"
        echo "tso-arm: removed $l"
    fi
    if [ "${1:-}" = --all ]; then
        rm -rf "$CACHE"
        echo "tso-arm: removed $CACHE"
    elif [ -d "$CACHE" ]; then
        echo "tso-arm: kept what it learned in $CACHE ('tso-arm uninstall --all' removes it)"
    fi
    if [ -d "$HOME/.local/src/tso-arm" ]; then
        echo "tso-arm: the FEX source of an earlier build is in ~/.local/src/tso-arm"
    fi
}

# Whether FEX has an x86-64 root file system for dynamically linked programs: FEX_ROOTFS, or "RootFS" in its
# configuration, which it reads where FEX does (Source/Common/Config.cpp): FEX_APP_CONFIG_LOCATION, else ~/.fex-emu
# if that exists, else $XDG_CONFIG_HOME/fex-emu (~/.config/fex-emu); or in the configuration of the FEX installed
has_rootfs() {
    [ -n "$FEX_ROOTFS" ] && return 0
    if [ -n "$FEX_APP_CONFIG_LOCATION" ]; then
        c=$FEX_APP_CONFIG_LOCATION
    elif [ -d "$HOME/.fex-emu" ]; then
        c=$HOME/.fex-emu/
    else
        c=${XDG_CONFIG_HOME:-$HOME/.config}/fex-emu/
    fi
    grep -qs '"RootFS"' "${c%/}/Config.json" "$PREFIX/share/fex-emu/Config.json"
}

# The root file system 'tso-arm rootfs' fetched for every user of an installation for all (as root), if there is one
shared_rootfs() {
    d=$(installed_dir) || return 1
    for r in "$d"/rootfs/RootFS/*/; do
        [ -d "$r/usr" ] && echo "${r%/}" && return 0
    done
    return 1
}

# binfmt_misc: x86-64 and 32-bit x86 ELF files, executables and position-independent ones (the magics and the mask
# qemu-user registers). Entry name, magic, the machine's name.
BINFMT_MASK='\xff\xff\xff\xff\xff\xfe\xfe\x00\xff\xff\xff\xff\xff\xff\xff\xff\xfe\xff\xff\xff'
BINFMT_ENTRIES='tso-arm \x7fELF\x02\x01\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x02\x00\x3e\x00 x86-64
tso-arm-i386 \x7fELF\x01\x01\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x02\x00\x03\x00 32-bit-x86'

cmd_binfmt() {
    d=/proc/sys/fs/binfmt_misc
    conf=/etc/binfmt.d/tso-arm.conf
    [ -f "$d/status" ] || die "binfmt_misc is not mounted here ($d)"
    case ${1:-} in
    "")
        printf '%s\n' "$BINFMT_ENTRIES" | while read -r name magic what; do
            what=$(echo "$what" | tr - ' ')
            if [ -f "$d/$name" ]; then
                echo "$what programs started directly run through tso-arm ($(head -n 1 "$d/$name"), $(sed -n 's/^interpreter //p' "$d/$name"))"
            else
                echo "$what programs started directly do not run through tso-arm ('sudo $REPO/bin/tso-arm binfmt register')"
            fi
            m=$(printf '%s' "$magic" | sed 's/\\x//g; s/^7fELF/7f454c46/')
            for f in "$d"/*; do
                case $(basename "$f") in register | status | tso-arm | tso-arm-i386) continue ;; esac
                if grep -q "^magic $m" "$f" 2>/dev/null; then
                    echo "another handler for $what programs: $(basename "$f") ($(sed -n 's/^interpreter //p' "$f")); the one registered last is asked first"
                fi
            done
        done
        ;;
    register)
        [ "$(id -u)" = 0 ] || die "binfmt register changes the system and needs root: sudo $REPO/bin/tso-arm binfmt register"
        # an installation by tools/get.sh is registered by its link to the version in use, which updates change
        interp=$REPO/bin/tso-arm-binfmt
        inst=$(installed_dir) && interp=$inst/current/bin/tso-arm-binfmt
        mkdir -p "$(dirname "$conf")"
        : >"$conf"
        printf '%s\n' "$BINFMT_ENTRIES" | while read -r name magic what; do
            # the kernel reads the \x escapes itself; the line goes to it as written
            line=":$name:M::$magic:$BINFMT_MASK:$interp:"
            if [ -f "$d/$name" ]; then
                echo -1 >"$d/$name"
            fi
            printf '%s\n' "$line" >"$d/register"
            printf '%s\n' "$line" >>"$conf"
        done
        echo "tso-arm: x86-64 and 32-bit x86 programs started directly run through $interp now, and after a reboot ($conf)"
        ;;
    unregister)
        [ "$(id -u)" = 0 ] || die "binfmt unregister changes the system and needs root: sudo $REPO/bin/tso-arm binfmt unregister"
        for name in tso-arm tso-arm-i386; do
            if [ -f "$d/$name" ]; then
                echo -1 >"$d/$name"
            fi
        done
        rm -f "$conf"
        echo "tso-arm: x86 programs started directly no longer run through tso-arm"
        ;;
    *) die "binfmt: register, unregister, or nothing for the state" ;;
    esac
}

# The FEX to run: TSO_ARM_FEX, the one 'tso-arm install' put into PREFIX, the prebuilt one a release package brings
# along, a development build. An installed FEX says which patches it was built with; translated code and FEX must
# agree on them, so one built with others is passed over.
fex() {
    want=""
    stale=""
    for f in "$TSO_ARM_FEX" "$PREFIX/bin/FEX" "$REPO/fex/prebuilt/bin/FEX" "$HOME/opt/fex-views/bin/FEX"; do
        [ -n "$f" ] && [ -x "$f" ] || continue
        b="$(dirname "$(dirname "$f")")/BUILD"
        if [ -f "$b" ]; then
            have=$(sed -n 's/^patches //p' "$b")
            [ -n "$want" ] || want=$(cat "$REPO"/fex/patches/*tso-arm-stage*.patch | sha256sum | cut -c1-16)
            if [ "$have" != "$want" ]; then
                [ "$f" = "$TSO_ARM_FEX" ] &&
                    die "TSO_ARM_FEX: $f was built with other patches ($have) than this tso-arm has ($want)"
                stale=${stale:-"$(dirname "$(dirname "$f")") ($have)"}
                continue
            fi
        fi
        echo "$f"
        return
    done
    [ -z "$stale" ] ||
        die "the FEX in $stale was built with other patches than this tso-arm has ($want): 'tso-arm install' brings it up to date"
    die "FEX with the tso-arm patches not found: run 'tso-arm install' (or set TSO_ARM_FEX)"
}

# What an ELF file is, read with od and awk (no binutils needed): its machine (x86-64, i386 or other), its kind
# (static, pie, dynamic, or other), the first 8 bytes of its GNU build ID in hex (- without one), and whether it is an
# AppImage (appimage or -: "AI" and its type after the ELF magic). The program headers and the build ID note sit at
# the start of a file: its first KB is read (od is slow: 0.8 ms for it on a Pi 5), the first 64 KB if they lie
# further.
elfinfo() {
    for lim in 1024 65536; do
        r=$(od -An -v -tu1 -N $lim "$1" 2>/dev/null | LC_ALL=C awk -v last=$([ $lim = 1024 ] && echo 0 || echo 1) '
        { for (i = 1; i <= NF; i++) b[n++] = $i + 0 }
        function u(o, len,   v, k) { v = 0; for (k = len - 1; k >= 0; k--) v = v * 256 + b[o + k]; return v }
        function out(m, k, id) { print m, k, id, (n > 10 && b[8] == 65 && b[9] == 73 && (b[10] == 1 || b[10] == 2)) ? "appimage" : "-" }
        END {
            if (n < 52 || b[0] != 127 || b[1] != 69 || b[2] != 76 || b[3] != 70 || b[5] != 1) { out("other", "other", "-"); exit }
            c = b[4]; mach = u(18, 2); t = u(16, 2)
            m = mach == 62 ? "x86-64" : mach == 3 ? "i386" : "other"
            if (c == 2) { ph = u(32, 8); es = u(54, 2); pn = u(56, 2) }
            else if (c == 1) { ph = u(28, 4); es = u(42, 2); pn = u(44, 2) }
            else { out("other", "other", "-"); exit }
            if (ph + es * pn > n) { if (last) out("other", "other", "-"); else print "more"; exit }
            interp = 0; id = "-"
            for (i = 0; i < pn; i++) {
                o = ph + i * es; pt = u(o, 4)
                if (pt == 3) interp = 1
                if (pt != 4 || id != "-") continue
                if (c == 2) { q = u(o + 8, 8); end = q + u(o + 32, 8) } else { q = u(o + 4, 4); end = q + u(o + 16, 4) }
                if (end > n) { if (last) continue; print "more"; exit }
                while (q + 12 <= end) {
                    ns = u(q, 4); ds = u(q + 4, 4); nt = u(q + 8, 4)
                    d = q + 12 + int((ns + 3) / 4) * 4
                    if (nt == 3 && ns == 4 && b[q + 12] == 71 && b[q + 13] == 78 && b[q + 14] == 85 && ds > 0) {
                        id = ""
                        for (k = 0; k < ds && k < 8; k++) id = id sprintf("%02x", b[d + k])
                        break
                    }
                    q = d + int((ds + 3) / 4) * 4
                }
            }
            out(m, interp ? "dynamic" : t == 3 ? "pie" : t == 2 ? "static" : "other", id)
        }')
        [ "$r" = more ] || break
    done
    echo "${r:-other other - -}"
}

# x86-64 | i386 | other: the program's machine
machine() {
    set -- $(elfinfo "$1")
    echo "$1"
}

# static | pie | dynamic | other: what kind of program the file is
kind() {
    set -- $(elfinfo "$1")
    [ "$1" = other ] && echo other || echo "$2"
}

# the name the ahead-of-time library of a program is kept under: its file name and its build ID, or a hash of its
# contents when it has none (the build ID saves reading a large program at every start; FEX checks every translated
# function against the program's code before it uses it either way). key FILE [ELFINFO]: what elfinfo said of the
# file, when it was read already.
key() {
    p=$(readlink -f "$1")
    i=${2:-$(elfinfo "$p")}
    set -- $i
    id=$3
    if [ "$id" = - ] || [ -z "$id" ]; then
        id=$(sha256sum "$p" | cut -c1-16)
    fi
    echo "$(basename "$p")-$id"
}

cmd_run() {
    # TSO_ARM_MODE: the mode for programs started without --mode (started directly through binfmt_misc, by tso-arm wine)
    mode=${TSO_ARM_MODE:-tso}
    aot=""
    while [ $# -gt 0 ]; do
        case $1 in
        --mode)
            mode=$2
            shift 2
            ;;
        --aot)
            aot=$(readlink -f "$2")
            [ -f "$aot" ] || die "no library $2"
            shift 2
            ;;
        --stats)
            export TSO_VIEWS_STATS=1
            shift
            ;;
        --gpu)
            export TSO_ARM_THUNKS=1
            shift
            ;;
        --no-aot)
            aot=/dev/null/none
            shift
            ;;
        --mode=*)
            mode=${1#*=}
            shift
            ;;
        --)
            shift
            break
            ;;
        -*) die "unknown option $1" ;;
        *) break ;;
        esac
    done
    [ $# -ge 1 ] || die "run: which program?"
    prog=$1
    shift
    [ -f "$prog" ] || prog=$(command -v "$prog" 2>/dev/null) || die "no program $prog"
    info=$(elfinfo "$prog")
    m=${info%% *}
    k=${info#* }
    k=${k%% *}
    [ "$m" = other ] || [ "$k" = other ] && die "$prog is not an x86 Linux program (x86-64 or 32-bit x86)"
    # 32-bit programs: the page protocol works on x86-64 programs; FEX orders every access of a 32-bit one itself
    # (correct, as fast as --mode full), and 'learn' translates x86-64 code only
    if [ "$m" = i386 ] && [ "$mode" = tso ]; then
        mode=full
        [ -n "$TSO_VIEWS_STATS" ] && echo "tso-arm: $(basename "$prog") is a 32-bit program: FEX orders all of its accesses (the page protocol is for x86-64 programs)" >&2
        aot=/dev/null/none
    fi
    # an AppImage mounts its contents with FUSE, through a fusermount it looks for in the root file system, which has
    # none: it unpacks them into a temporary directory instead and runs from there (a 15 MB one starts in 0.36 s on
    # the Pi 5, 0.33 s from a copy unpacked beforehand)
    case $info in
    *" appimage") export APPIMAGE_EXTRACT_AND_RUN=${APPIMAGE_EXTRACT_AND_RUN:-1} ;;
    esac
    if [ "$k" = dynamic ] && ! has_rootfs; then
        r=$(shared_rootfs) ||
            die "$prog is dynamically linked and needs an x86-64 root file system: 'tso-arm rootfs' fetches one (or set FEX_ROOTFS to a directory with the x86-64 libraries)"
        export FEX_ROOTFS="$r"
    fi
    F=$(fex)
    # FEX takes the root file system from its server, which lives as long as programs it started run (and a second
    # after): one started with another root file system serves this program too, whatever FEX_ROOTFS says
    if [ -n "$FEX_ROOTFS" ] && [ "$k" = dynamic ] && pgrep -u "$(id -u)" -x FEXServer >/dev/null 2>&1; then
        r=$("$(dirname "$F")/FEXGetConfig" --current-rootfs 2>/dev/null)
        if [ "$(readlink -f "${r:-/nonexistent}")" != "$(readlink -f "$FEX_ROOTFS")" ]; then
            echo "tso-arm: FEX's server serves ${r:-no root file system} until the FEX programs started with it have ended; FEX_ROOTFS=$FEX_ROOTFS takes effect after that" >&2
        fi
    fi
    lib=${aot:-"$CACHE/aot/$(key "$prog" "$info").so"}
    export FEX_DISABLETELEMETRY=${FEX_DISABLETELEMETRY:-1}
    case $mode in
    tso)
        export TSO_VIEWS=1 FEX_VECTORTSOENABLED=1 FEX_MEMCPYSETTSOENABLED=1
        translated
        ;;
    full)
        export FEX_TSOENABLED=1 FEX_VECTORTSOENABLED=1 FEX_MEMCPYSETTSOENABLED=1
        ;;
    unordered)
        export FEX_TSOENABLED=0
        translated
        ;;
    *) die "unknown mode $mode (tso, full, unordered)" ;;
    esac
    # Go's runtime preempts a goroutine with SIGURG and resumes it at the interrupted instruction with the registers
    # its handler saw. The patched FEX delivers such a signal at an instruction start (notes section 54); only with
    # that turned off (TSO_EXACT_SIGNALS=0) is Go's asynchronous preemption turned off too, as before: goroutines stop
    # at Go's own safe points then. Only Go programs read GODEBUG.
    if [ "${TSO_EXACT_SIGNALS:-1}" = 0 ]; then
        case ",${GODEBUG:-}," in
        *,asyncpreemptoff=*) ;;
        *) export GODEBUG="${GODEBUG:+$GODEBUG,}asyncpreemptoff=1" ;;
        esac
    fi
    thunks "$F"
    # an empty XDG_* variable counts as unset (XDG base directory specification); FEX took it as set and looked for
    # its configuration in /fex-emu/, and its server did not start
    for x in XDG_CONFIG_HOME XDG_DATA_HOME XDG_CACHE_HOME XDG_RUNTIME_DIR; do
        eval "[ -n \"\${$x-unset}\" ] || unset $x"
    done
    exec "$F" "$prog" "$@"
}

# The GPU (--gpu, TSO_ARM_THUNKS=1), where FEX was built with its thunks: an x86 program's Vulkan calls go to the
# host's own Vulkan library and with it to the GPU's driver (the x86 Mesa of a root file system has no driver for the
# GPUs of many Arm boards and draws with the CPU), and its OpenGL goes through the x86 Mesa's Zink (OpenGL on Vulkan)
# onto that. FEX's own OpenGL thunk stopped with an X error and a core dump on an X server in CI (glxinfo, glxgears),
# so it is not selected. Off unless asked for, as in FEX: x86-64 Vulkan reaches the Pi 5's V3D and vkcube runs, but
# vulkaninfo stops with SIGILL in every ordering mode, and 32-bit programs have no Vulkan thunk. The directories are
# given here because a prebuilt FEX was built for another prefix; FEX_THUNKCONFIG names another selection
# (fex/thunks.json: Vulkan), MESA_LOADER_DRIVER_OVERRIDE another OpenGL driver.
thunks() {
    p=$(dirname "$(dirname "$1")")
    [ "${TSO_ARM_THUNKS:-0}" = 1 ] || return 0
    [ -d "$p/lib/fex-emu/HostThunks" ] || {
        echo "tso-arm: the FEX in $p was built without thunks (the prebuilt one of a release has them); --gpu has no effect" >&2
        return 0
    }
    export FEX_THUNKHOSTLIBS="$p/lib/fex-emu/HostThunks" FEX_THUNKGUESTLIBS="$p/share/fex-emu/GuestThunks"
    export FEX_THUNKCONFIG="${FEX_THUNKCONFIG:-$REPO/fex/thunks.json}"
    # Zink over the Vulkan thunk for x86-64 programs (32-bit ones have no Vulkan thunk to put it on): on the Pi 5
    # OpenGL then reports "zink Vulkan 1.3(V3D 7.1.10.2 (MESA_V3DV))". Its window path needs DRI3 of the X server
    # (desktops have it, Xwayland as well; Xvfb has not: "DRI3 not available"); Mesa's software window path instead
    # (LIBGL_ALWAYS_SOFTWARE) makes Zink take a CPU device, llvmpipe again
    [ "$m" = x86-64 ] && export MESA_LOADER_DRIVER_OVERRIDE="${MESA_LOADER_DRIVER_OVERRIDE-zink}"
    return 0
}

# what `learn` translated: the program's library (TSO_AOT, for this program only: programs it starts with execve look
# theirs up), and the shared libraries' in the cache, which FEX takes when the program maps them (TSO_AOT_DIR)
translated() {
    [ "$aot" = /dev/null/none ] && return
    export TSO_AOT_DIR="$CACHE/aot"
    if [ -f "$lib" ]; then
        export TSO_AOT="$lib" TSO_AOT_FOR="$(readlink -f "$prog")"
    fi
    if [ -f "$lib" ] || [ -f "$lib.libs" ]; then
        # block by block unless learn found multiblock faster (much of the program untranslated)
        export FEX_MULTIBLOCK=$([ -f "$lib.multiblock" ] && echo 1 || echo 0)
    fi
}

cmd_learn() {
    [ $# -ge 1 ] || die "learn: which program?"
    prog=$1
    shift
    [ -f "$prog" ] || prog=$(command -v "$prog" 2>/dev/null) || die "no program $prog"
    [ "$(machine "$prog")" = i386 ] &&
        die "$(basename "$prog") is a 32-bit program: 'learn' translates x86-64 code; 'tso-arm run' runs it with FEX ordering all of its accesses"
    case $(kind "$prog") in
    static | pie) ;;
    dynamic)
        if ! has_rootfs; then
            r=$(shared_rootfs) ||
                die "$prog is dynamically linked and needs an x86-64 root file system: 'tso-arm rootfs' fetches one (or set FEX_ROOTFS)"
            export FEX_ROOTFS="$r"
        fi
        echo "tso-arm: $(basename "$prog") is dynamically linked: its own functions are translated, and those of its shared libraries (for every program that uses them)"
        ;;
    *) die "$prog is not an x86 Linux program" ;;
    esac
    for t in python3 clang perf readelf; do
        command -v $t >/dev/null || die "learn needs $t"
    done
    python3 -c 'import capstone' 2>/dev/null || die "learn needs the Python module capstone (pip install capstone)"
    mkdir -p "$CACHE/aot"
    out="$CACHE/aot/$(key "$prog").so"
    TSO_ARM_FEX=$(fex) python3 "$REPO/aot/auto.py" "$prog" "$out" --libdir "$CACHE/aot" --timed -- "$@"
    n=0
    [ -f "$out" ] && n=$(wc -l <"$out.list")
    libs=""
    [ -f "$out.libs" ] && libs=" and of $(wc -l <"$out.libs") of its shared libraries"
    if [ -f "$out" ] || [ -f "$out.libs" ]; then
        echo "tso-arm: learned $n functions of $(basename "$prog")$libs; 'tso-arm run' uses them from now on"
    elif [ -f "$out.slower" ]; then
        echo "tso-arm: the $(wc -l <"$out.list") translated functions made $(basename "$prog") slower on this machine; 'tso-arm run' goes on without them"
    else
        echo "tso-arm: nothing of $(basename "$prog") to translate ahead of time; 'tso-arm run' runs it with FEX alone"
    fi
}

cmd_status() {
    if [ $# -ge 1 ]; then
        lib="$CACHE/aot/$(key "$1").so"
        if [ -f "$lib" ]; then
            echo "$(basename "$1"): $(wc -l <"$lib.list") functions translated ahead of time"
        elif [ -f "$lib.slower" ]; then
            echo "$(basename "$1"): $(wc -l <"$lib.list") functions translated ahead of time, not used: slower on this machine"
        elif [ ! -f "$lib.libs" ]; then
            echo "$(basename "$1"): nothing translated ahead of time"
        fi
        if [ -f "$lib.libs" ]; then
            while read -r k; do
                l="$CACHE/aot/$k.so"
                [ -f "$l.list" ] && echo "$(basename "$1"): its shared library ${k%-*}: $(wc -l <"$l.list") functions translated ahead of time"
            done <"$lib.libs"
        fi
        # each profile (one per program file) and what its runs do: the page protocol, full ordering past the fault
        # budget, or pages moving between threads ('learn' found it faster)
        n=0
        for p in "$CACHE"/"$(basename "$1")"-*.prof; do
            [ -f "$p" ] || continue
            n=$((n + 1))
            if grep -q '^fallback' "$p"; then
                s="full ordering (its threads share too much for the page protocol)"
            elif grep -q '^migrate' "$p"; then
                s="pages move between its threads ('learn' found it faster)"
            else
                s="page protocol"
            fi
            echo "$(basename "$1"): $s, $(grep -c '^esc' "$p") code ranges ordered ($(basename "$p"))"
        done
        [ $n -gt 0 ] || echo "$(basename "$1"): no page protocol profile yet"
        return
    fi
    echo "translated ahead of time ($CACHE/aot):"
    for l in "$CACHE"/aot/*.so.list; do
        [ -f "$l" ] || continue
        if [ -f "${l%.list}" ]; then
            echo "  $(basename "$l" .so.list): $(wc -l <"$l") functions"
        else
            echo "  $(basename "$l" .so.list): $(wc -l <"$l") functions, not used (slower on this machine)"
        fi
    done
    echo "page protocol profiles: $(ls "$CACHE"/*.prof 2>/dev/null | wc -l)"
}

cmd_forget() {
    [ $# -ge 1 ] || die "forget: which program?"
    # the program's own; libraries of its shared libraries serve other programs as well and stay
    rm -f "$CACHE/aot/$(key "$1").so" "$CACHE/aot/$(key "$1").so.slower" "$CACHE/aot/$(key "$1").so.list" \
        "$CACHE/aot/$(key "$1").so.multiblock" "$CACHE/aot/$(key "$1").so.libs" "$CACHE/aot/$(key "$1").c"
    rm -f "$CACHE"/"$(basename "$1")"-*.prof
    echo "tso-arm: forgot $(basename "$1")"
}

# What a bug report needs, in one block to paste: versions, machine, kernel, distribution, the root file system, and
# for a program what tso-arm knows of it and how it ends in each mode
cmd_report() {
    echo '```'
    cmd_version
    echo "system: $(. /etc/os-release 2>/dev/null && echo "$PRETTY_NAME"), kernel $(uname -r), glibc $(ldd --version 2>/dev/null | sed -n '1s/.* //p')"
    sh "$REPO/tools/board_check.sh" 2>&1 | grep -v '^for \|^to build' | sed 's/  */ /g'
    if has_rootfs; then
        echo "root file system: ${FEX_ROOTFS:-from FEX's configuration}"
    elif r=$(shared_rootfs); then
        echo "root file system: $r (for every user)"
    else
        echo "root file system: none ('tso-arm rootfs')"
    fi
    F=$(fex 2>/dev/null) && [ -d "$(dirname "$(dirname "$F")")/lib/fex-emu/HostThunks" ] &&
        echo "thunks: built in, $([ "${TSO_ARM_THUNKS:-0}" = 1 ] && echo on || echo "off (--gpu, TSO_ARM_THUNKS=1)")"
    for v in $(env | sed -n 's/^\(FEX_[A-Z_]*\|TSO_[A-Z_]*\)=.*/\1/p'); do
        [ "$v=$(printenv "$v")" = FEX_MAXINST=150 ] && continue # tso-arm's own setting
        echo "set: $v=$(printenv "$v")"
    done
    if [ $# -ge 1 ]; then
        p=$1
        [ -f "$p" ] || p=$(command -v "$p" 2>/dev/null) || p=$1
        echo "program: $p: $(elfinfo "$p" 2>/dev/null)"
        [ -f "$p" ] && cmd_status "$p" | sed 's/^/  /'
        for m in tso full unordered; do
            s=0
            o=$(timeout 60 "$REPO/bin/tso-arm" run --mode $m "$@" </dev/null 2>&1 >/dev/null | tail -n 3) || s=$?
            echo "  --mode $m: exit status $s${o:+, last messages:}"
            [ -n "$o" ] && printf '%s\n' "$o" | sed 's/^/    /'
        done
    fi
    echo '```'
}

cmd_rootfs() {
    F=$(fex)
    fetcher="$(dirname "$F")/FEXRootFSFetcher"
    [ -x "$fetcher" ] || die "FEXRootFSFetcher not found next to $F"
    # without options: Ubuntu 24.04, unpacked, without questions (what tso-arm is tested with); with options, the
    # fetcher's own (--help)
    [ $# -gt 0 ] || set -- -y -x --distro-name=ubuntu --distro-version=24.04
    # as root in an installation for every user: one root file system for all of them, beside the versions
    # (FEX_APP_DATA_LOCATION: where the fetcher puts it; the configuration it writes goes nowhere, tso-arm run finds it)
    if [ "$(id -u)" = 0 ] && d=$(installed_dir) && [ -z "$FEX_APP_DATA_LOCATION" ]; then
        mkdir -p "$d/rootfs"
        c=$(mktemp -d)
        s=0
        FEX_APP_DATA_LOCATION="$d/rootfs/" FEX_APP_CONFIG_LOCATION="$c/" "$fetcher" "$@" || s=$?
        rm -rf "$c"
        [ $s = 0 ] && r=$(shared_rootfs) && echo "tso-arm: the root file system for every user of $d: $r"
        return $s
    fi
    exec "$fetcher" "$@"
}

case ${1:-} in
run) shift && cmd_run "$@" ;;
learn) shift && cmd_learn "$@" ;;
status) shift && cmd_status "$@" ;;
forget) shift && cmd_forget "$@" ;;
check) exec sh "$REPO/tools/board_check.sh" ;;
install) shift && exec sh "$REPO/fex/install.sh" "$@" ;;
uninstall) shift && cmd_uninstall "$@" ;;
update) shift && cmd_update "$@" ;;
report) shift && cmd_report "$@" ;;
wine) shift && exec sh "$REPO/tools/wine.sh" "$@" ;;
rootfs) shift && cmd_rootfs "$@" ;;
binfmt) shift && cmd_binfmt "$@" ;;
version | --version) cmd_version ;;
-h | --help | help | "") usage ;;
*) usage >&2 && exit 1 ;;
esac
